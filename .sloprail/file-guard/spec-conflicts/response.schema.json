{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["summary", "members"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "object",
      "description": "One line per invariant shown (judged and neighbours), keyed by its path: what it requires of the fields it shares with the others.",
      "additionalProperties": {"type": "string"}
    },
    "members": {
      "type": "object",
      "description": "One entry per invariant under \"The invariants to judge\", keyed by its path, and for no other.",
      "additionalProperties": {
        "type": "object",
        "required": ["findings"],
        "additionalProperties": false,
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["with", "kind", "input", "explanation", "fix"],
              "additionalProperties": false,
              "properties": {
                "with": {"type": "string", "description": "The path of the other invariant of the pair."},
                "kind": {"type": "string", "enum": ["conflict", "duplicate"]},
                "input": {"type": "string", "description": "The concrete input where they clash, or the shared effect for a duplicate."},
                "explanation": {"type": "string"},
                "fix": {"type": "string", "description": "One line."}
              }
            }
          }
        }
      }
    }
  }
}
