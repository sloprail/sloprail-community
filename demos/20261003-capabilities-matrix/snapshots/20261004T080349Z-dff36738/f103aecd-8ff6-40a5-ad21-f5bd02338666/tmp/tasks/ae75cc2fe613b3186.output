/runs/additional-context\n    deviations:\n      - adr: modeled-surface\n        statement: >-\n          The mock models a tool failing by an error or by a refusal, not by\n          a timeout, so the postToolUseFailure hook's failure_type \"timeout\"\n          and the context its hook adds after a timed-out tool are not modeled.","is_error":false}]},"uuid":"e94b5945-b4d9-47bf-810b-c2447ab04da0","timestamp":"2026-10-03T14:47:28.613Z","sourceToolAssistantUUID":"15556f48-548b-418d-b432-8fdf021a6316","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ae75cc2fe613b3186","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"claude/capabilities-matrix-impl-2a0cfd"}
