the mock and\n\t\t\t// its tests to the deviation, not to the doc, for exactly that point)\n\t\t\tdocs: [#DocRef, ...#DocRef]\n\t\t\truns: [string & =~\"^\\(H)-mock/snapshots/runs/[a-z][a-z0-9]*(-[a-z0-9]+)*$\", ...string & =~\"^\\(H)-mock/snapshots/runs/[a-z][a-z0-9]*(-[a-z0-9]+)*$\"]\n\t\t}\n\t}\n}\n\n#DocRef: string & =~\"^https://[^\\\\s#]+#[a-z0-9-]+$\"\nspec/capabilities/empty-tool-result-placeholder.yaml\nspec/capabilities/compaction-transcript-continuity.yaml\nspec/capabilities/hook-output-transcript-records.yaml\nspec/capabilities/session-resume.yaml\nspec/capabilities/subagent-transcripts.yaml\nspec/capabilities/hook-common-payload.yaml\nspec/capabilities/session-end-hook.yaml\nspec/capabilities/nested-subagents.yaml\nspec/capabilities/session-fork.yaml\nspec/capabilities/session-transcript-file.yaml\ncat: cursor-mock/module.yaml: No such file or directory","is_error":false}]},"uuid":"23705c15-0e01-422d-99b8-1aea3326e72a","timestamp":"2026-10-03T14:47:29.186Z","sourceToolAssistantUUID":"1814602a-e63d-43d5-9e7a-3e7df023d26a","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ae75cc2fe613b3186","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"claude/capabilities-matrix-impl-2a0cfd"}
