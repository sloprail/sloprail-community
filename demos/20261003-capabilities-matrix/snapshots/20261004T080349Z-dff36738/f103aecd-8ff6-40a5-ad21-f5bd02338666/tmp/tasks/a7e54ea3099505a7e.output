{"parentUuid":"579f27d4-92e9-4ec1-a129-e7cbd41251ab","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a7e54ea3099505a7e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AAUojhsewLUxKycXcJG4kt","type":"tool_result","content":"claude-mock/internal/runner/agent.go:24:// envSubagentScript names the fallback subagent scenario script used when an\nclaude-mock/internal/runner/agent.go:25:// Agent tool_use does not carry an explicit `script` field.\nclaude-mock/internal/runner/agent.go:59:// understands. The real claude binary emits {description, prompt, subagent_type,\nclaude-mock/internal/runner/agent.go:60:// isolation}; the mock additionally accepts a `script` field naming the subagent's\nclaude-mock/internal/runner/agent.go:61:// scenario script (real claude lets the LLM decide subagent behaviour — the mock\nclaude-mock/internal/runner/agent.go:62:// cannot, so the test supplies a script, mirroring the top-level --script).\nclaude-mock/internal/runner/agent.go:65:\tDescription  string `json:\"description,omitempty\"`\nclaude-mock/internal/runner/agent.go:70:\t// seeded transcript — matching real claude, where the subagent's os.Getwd() differs\nclaude-mock/internal/runner/agent.go:78:\t// Script is the absolute path to the subagent's scenario script (mock-only).\nclaude-mock/internal/runner/agent.go:79:\tScript string `json:\"script,omitempty\"`\nclaude-mock/internal/runner/agent.go:84://  1. Validate the input: description and prompt are required strings (the\nclaude-mock/internal/runner/agent.go:87://  2. Mint the agent id and seed the sub-agent's own transcript\nclaude-mock/internal/runner/agent.go:90://     sub-agent's own transcript as a non-blocking error and the sub-agent\nclaude-mock/internal/runner/agent.go:105:func runAgentTool(ctx context.Context, cfg Config, inv *hooks.Invoker, toolUseID string, rawInput json.RawMessage, tr *transcript) toolexec.Result {\nclaude-mock/internal/runner/agent.go:121:// resolveSubagentScript picks the subagent scenario script: the Agent input's\nclaude-mock/internal/runner/agent.go:122:// `script` field wins, then the A10N_MOCK_SUBAGENT_SCRIPT env var, else \"\".\nclaude-mock/internal/runner/agent.go:123:// sr:invariant subagent-script\nclaude-mock/internal/runner/agent.go:132:// followed by 16 hex digits (every agentId in the real transcripts, e.g.\nclaude-mock/internal/runner/agent_prepare.go:22:// its isolated worktree when asked for, its seeded sidechain transcript and\nclaude-mock/internal/runner/agent_prepare.go:25:func prepareSubagent(ctx context.Context, cfg Config, inv *hooks.Invoker, toolUseID string, rawInput json.RawMessage, tr *transcript, background bool) (*subagentRun, agentToolInput, toolexec.Result) {\n// Package scenario runs the script that drives a mock: once per turn, it\n// prints stream-json lines that say what the agent does.\npackage scenario\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\n\t\"github.com/sloprail/harness-mocks/internal/procexec\"\n)\n\n// Input is what the script is told on each run, in A10N_MOCK_* variables.\ntype Input struct {\n\t// Prompt is the user's prompt, unchanged.\n\tPrompt string\n\t// AdditionalContext is the context a UserPromptSubmit hook added.\n\tAdditionalContext string\n\t// SessionFile is the session record so far.\n\tSessionFile string\n}\n\n// ToolUse is a tool call the script asked for.\ntype ToolUse struct {\n\tID    string\n\tName  string\n\tInput json.RawMessage\n}\n\n// Turn is what one run of the script said: the agent's messages in order, and\n// how the turn ends, with a tool call or with the result that ends the run\n// (neither: the script ended without a tool call or a result).\ntype Turn struct {\n\tTexts  []string\n\tTool   *ToolUse\n\tResult *string\n}\n\n// Idents are the variables a script is given.\n//\n// The script receives the user's prompt, unchanged, in A10N_MOCK_PROMPT; the\n// session record so far in A10N_MOCK_SESSION_FILE; and a UserPromptSubmit\n// hook's additional context in A10N_MOCK_ADDITIONAL_CONTEXT, never in place of\n// the prompt.\n//\n// sr:invariant scenario-prompt-env\n// sr:invariant session-file-env\n// sr:invariant prompt-context-appended\nfunc Idents(in Input) map[string]string {\n\treturn map[string]string{\n\t\t\"A10N_MOCK_PROMPT\":             in.Prompt,\n\t\t\"A10N_MOCK_ADDITIONAL_CONTEXT\": in.AdditionalContext,\n\t\t\"A10N_MOCK_SESSION_FILE\":       in.SessionFile,\n\t}\n}\n\n// RunTurn runs the script once and reads its lines up to the first tool call\n// or result.\n//\n// The script runs once per turn and prints stream-json lines: a tool_use line\n// ends the turn, the mock runs the tool and runs the script again; a result\n// line ends the run.\n//\n// sr:invariant turn-loop\nfunc RunTurn(ctx context.Context, script, dir string, environ []string, in Input) (Turn, error) {\n\tres, err := procexec.Run(ctx, procexec.Spec{\n\t\tArgv: []string{\"/bin/sh\", script}, Dir: dir, Env: procexec.Env(environ, Idents(in), nil),\n\t})\n\tif err != nil {\n\t\treturn Turn{}, fmt.Errorf(\"codex-mock: cannot run the scenario script: %w\", err)\n\t}\n\tvar t Turn\n\tsc := bufio.NewScanner(bytes.NewReader(res.Stdout))\n\tsc.Buffer(make([]byte, 64*1024), 16*1024*1024)\n\tfor sc.Scan() {\n\t\tline := bytes.TrimSpace(sc.Bytes())\n\t\tif len(line) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tdone, err := t.read(line)\n\t\tif err != nil {\n\t\t\treturn Turn{}, fmt.Errorf(\"codex-mock: scenario script printed an invalid line: %w\\nline: %s\", err, line)\n\t\t}\n\t\tif done {\n\t\t\tbreak\n\t\t}\n\t}\n\treturn t, nil\n}\ncommit e6d6ecdc4da5ac0345a9242c99826327d5f5af0f\nAuthor: Mykyta Svyrydenko <<redacted-email>>\nDate:   Sat Oct 3 17:14:26 2026 +0200\n\n    codex: session-transcript-file cell supported, recorded in runs/session-transcript-file (#95)","is_error":false}]},"uuid":"adc65c88-e5d0-4a22-b899-ee9c3a0b3d0b","timestamp":"2026-10-03T15:16:01.701Z","sourceToolAssistantUUID