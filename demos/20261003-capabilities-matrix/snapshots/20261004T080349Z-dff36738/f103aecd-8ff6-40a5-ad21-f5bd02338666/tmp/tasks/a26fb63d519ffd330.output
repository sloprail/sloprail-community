n &ErrNoRollout{ID: nc.SessionID}\n\t}\n\treturn nil\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1767,"cache_read_input_tokens":98133,"cache_creation":{"ephemeral_5m_input_tokens":1767,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_017eF5mfdT9s9Db5bE3yCJqB":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a26fb63d519ffd330/codex-mock/internal/session/resume.go","content":"package session\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\tcoresession \"github.com/sloprail/harness-mocks/internal/session\"\n)\n\n// findRollout is the rollout of session id under <home>/sessions, whichever\n// day it was begun: \"\" when there is none, and for an id that is not a plain\n// name.\nfunc findRollout(home, id string) string {\n\tif id == \"\" || strings.ContainsAny(id, `/\\*?[`) {\n\t\treturn \"\"\n\t}\n\thits, _ := filepath.Glob(filepath.Join(home, \"sessions\", \"*\", \"*\", \"*\", \"rollout-*-\"+id+\".jsonl\"))\n\tfor _, p := range hits {\n\t\tif fi, err := os.Stat(p); err == nil && fi.Mode().IsRegular() {\n\t\t\treturn p\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// ErrNoRollout is `codex exec resume <id>` naming a session that has no\n// rollout: it fails with this message before any session starts, so no hook\n// fires at all, neither its start nor its end (recorded:\n// snapshots/runs/session-resume-unknown).\ntype ErrNoRollout struct{ ID string }\n\nfunc (e *ErrNoRollout) Error() string {\n\treturn fmt.Sprintf(\"Error: thread/resume: thread/resume failed: no rollout found for thread id %s (code -32600)\", e.ID)\n}\n\n// ResumeUnknown is the failure of resuming session id, or nil when its rollout\n// exists. No hook phase fires on it.\n// sr:provides session-resume-unknown/codex\nfunc ResumeUnknown(home, id string) error {\n\t_, err := coresession.ResumeAt(findRollout(home, id), id)\n\tvar nc *coresession.NoConversationError\n\tif errors.As(err, &nc) {\n\t\treturn &ErrNoRollout{ID: nc.SessionID}\n\t}\n\treturn nil\n}\n"}},"apiBlockIndex":2,"requestId":"req_011CffVs97LKfCrtzQG421qG","attributionAgent":"general-purpose","type":"assistant","uuid":"6ee14bc8-f0fc-46f9-b4f6-371ae17c5086","timestamp":"2026-10-03T14:56:39.381Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a26fb63d519ffd330","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
