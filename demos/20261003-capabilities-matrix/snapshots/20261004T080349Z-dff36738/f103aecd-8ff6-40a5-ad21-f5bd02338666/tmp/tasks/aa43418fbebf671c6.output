onl\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/samples/20261003-162521/exit.txt\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/samples/20261003-162521/payloads.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/samples/20261003-162521/stderr.txt\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/samples/20261003-162521/stream.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/samples/20261003-162521/transcript/rollout-2026-10-03T18-25-26-01a10295-aa9f-7871-b37f-46b68c3f95f7.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/setup/args\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/setup/hook.sh\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/setup/hooks.json\ncodex-mock/snapshots/runs/manual-compaction-auto-post-stopped/setup/prompt.txt\ncodex-mock/snapshots/runs/manual-compaction-auto/run.yaml\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/SEAL\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/events.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/exit.txt\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/payloads.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/stderr.txt\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/stream.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto/samples/20261003-145222/transcript/rollout-2026-10-03T16-52-23-01a10240-7b13-79b3-ae55-786c08642a19.jsonl\ncodex-mock/snapshots/runs/manual-compaction-auto/setup/args\ncodex-mock/snapshots/runs/manual-compaction-auto/setup/hook.sh\ncodex-mock/snapshots/runs/manual-compaction-auto/setup/hooks.json\ncodex-mock/snapshots/runs/manual-compaction-auto/setup/prompt.txt\ncodex-mock/snapshots/runs/manual-compaction-slash/run.yaml\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/SEAL\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/events.jsonl\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/exit.txt\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/payloads.jsonl\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/stderr.txt\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/stream.jsonl\ncodex-mock/snapshots/runs/manual-compaction-slash/samples/20261003-144845/transcript/rollout-2026-10-03T16-48-48-01a1023d-3121-7773-9798-4a725c9d3ae6.jsonl\ncodex-mock/snapshots/runs/manual-compaction-slash/setup/hook.sh\ncodex-mock/snapshots/runs/manual-compaction-slash/setup/hooks.json\ncodex-mock/snapshots/runs/manual-compaction-slash/setup/prompt.txt\ncursor-mock/snapshots/runs/manual-compaction-slash/run.yaml\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/SEAL\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/events.jsonl\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/exit.txt\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/payloads.jsonl\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/stderr.txt\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/stream.jsonl\ncursor-mock/snapshots/runs/manual-compaction-slash/samples/20261003-145843/transcript/5c916b45-35b3-40f4-8012-103b46829e6e/5c916b45-35b3-40f4-8012-103b46829e6e.jsonl\ncursor-mock/snapshots/runs/manual-compaction-slash/setup/hook.sh\ncursor-mock/snapshots/runs/manual-compaction-slash/setup/hooks.json\ncursor-mock/snapshots/runs/manual-compaction-slash/setup/prompt.txt\ninternal/compaction/candidates.sh\ninternal/compaction/compaction_test.go\ninternal/compaction/module.yaml\ninternal/compaction/plan.go\ninternal/compaction/resume_last_test.go\ninternal/compaction/run.go\ninternal/scenario/compact_test.go\ninternal/turnloop/compact.go\nspec/capabilities/compaction-transcript-continuity.yaml\nspec/capabilities/manual-compaction.yaml\nstatement: >-\n  A compaction leaves a boundary in the transcript, followed by a summary and\n  a preserved tail of earlier records, so a reader can still follow the record\n  chain across it.\nproviders:\n  claude:\n    docs:\n      - https://code.claude.com/docs/en/claude-directory#application-data\n    runs:\n      - claude-mock/snapshots/runs/compact\n      - claude-mock/snapshots/runs/compact-nohooks\n  codex: pending\n  cursor: pending\npackage runner\n\nimport (\n\t\"context\"\n\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/hooks\"\n\t\"github.com/sloprail/harness-mocks/internal/compaction\"\n\t\"github.com/sloprail/harness-mocks/internal/turnloop\"\n)\n\n// Compact compacts the session, the way Codex does (recorded under\n// codex-mock/snapshots/runs/manual-compaction-auto, -auto-blocked and\n// -auto-post-stopped): PreCompact fires with the trigger; a hook printing\n// `continue: false` stops the compaction, and nothing more happens. Otherwise\n// the rollout records the compaction and PostCompact fires; unless that hook\n// printed `continue: false`, SessionStart with source \"compact\" follows. A hook\n// that stopped it, before or after, also aborts the turn: the rollout records\n// it interrupted, the stream prints nothing more, no Stop hook fires and the\n// run fails (turnloop.ErrAborted). The scenario's compact record names the\n// trigger, \"manual\" when it names none.\n//\n// sr:provides manual-compaction/codex\n// sr:docs https://developers.openai.com/codex/hooks#precompact\n// sr:docs https://developers.openai.com/codex/hooks#postcompact\nfunc (h turnHost) Compact(ctx context.Context, trigger string) error {\n\tif trigger == \"\" {\n\t\ttrigger = \"manual\"\n\t}\n\ts := h.state\n\town := map[string]any{\"turn_id\": s.turnID, \"trigger\": trigger}\n\tstops := func(ev hooks.Event) (stop bool) {\n\t\tfor _, o := range s.hooks.Fire(ctx, ev, trigger, own) {\n\t\t\tstop = stop || hooks.Stops(o)\n\t\t}\n\t\treturn stop\n\t}\n\tres := compaction.Do(false, compaction.Steps{\n\t\tBefore:     func() bool { return stops(hooks.PreCompact) },\n\t\tBoundary:   s.rollout.Compacted,\n\t\tSummary:    func() {},\n\t\tAfterStops: func() bool { return stops(hooks.PostCompact) },\n\t\tResume: func() {\n\t\t\tfor _, o := range s.hooks.Fire(ctx, hooks.SessionStart, \"compact\", map[string]any{\"source\": \"compact\"}) {\n\t\t\t\tif d := hooks.Interpret(hooks.SessionStart, o); d.Context != \"\" {\n\t\t\t\t\ts.rollout.Developer(d.Context)\n\t\t\t\t}\n\t\t\t}\n\t\t},\n\t\tResumeLast: true,\n\t})\n\tif res.Stopped {\n\t\ts.rollout.TurnAborted(s.turnID)\n\t\ts.events.Abort()\n\t\treturn turnloop.ErrAborted\n\t}\n\treturn nil\n}","is_error":false}]},"uuid":"384d40ba-ee77-4065-92ba-40b916a952d3","timestamp":"2026-10-03T18:29:59.940Z","sourceToolAssistantUUID":"9a132932-f8ea-4ecb-bc7c-7e6287155bb2","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-aa43418fbebf671c6","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a11c0a040e3cf682b"}
