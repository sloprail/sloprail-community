mand\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUseFailure\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n### 20261001-124123/payloads.jsonl\nUserPromptSubmit None None {\"session_id\": \"bd53d959-3a6b-456c-b6d8-586f6883902e\", \"transcript_path\": \"<TMP>/home/.claude/projects/<RUN_DIRNAME>/bd53d959-3a6b-456c-b6d8-586f6883902e.jsonl\", \"cwd\": \"<RUN>\", \"prompt_id\": \"405a3319-5681-43ef-9db6-06a24ca7758a\", \"permission_mode\": \"bypassPermissions\", \"hook_event_name\": \"UserPromptSubmit\", \"prompt\": \"Step 1: run the Bash command: echo SECOND . Step 2: use the Agent tool (not in \nPreToolUse Agent None {\"session_id\": \"bd53d959-3a6b-456c-b6d8-586f6883902e\", \"transcript_path\": \"<TMP>/home/.claude/projects/<RUN_DIRNAME>/bd53d959-3a6b-456c-b6d8-586f6883902e.jsonl\", \"cwd\": \"<RUN>\", \"prompt_id\": \"405a3319-5681-43ef-9db6-06a24ca7758a\", \"permission_mode\": \"bypassPermissions\", \"hook_event_name\": \"PreToolUse\", \"tool_name\": \"Agent\", \"tool_input\": {\"description\": \"helper\", \"prompt\": \"Reply with the single w\nSubagentStart None ab9feaf3cf8de12c2 {\"session_id\": \"bd53d959-3a6b-456c-b6d8-586f6883902e\", \"transcript_path\": \"<TMP>/home/.claude/projects/<RUN_DIRNAME>/bd53d959-3a6b-456c-b6d8-586f6883902e.jsonl\", \"cwd\": \"<RUN>\", \"prompt_id\": \"405a3319-5681-43ef-9db6-06a24ca7758a\", \"agent_id\": \"ab9feaf3cf8de12c2\", \"agent_type\": \"general-purpose\", \"hook_event_name\": \"SubagentStart\"}\nSubagentStop None ab9feaf3cf8de12c2 {\"session_id\": \"bd53d959-3a6b-456c-b6d8-586f6883902e\", \"transcript_path\": \"<TMP>/home/.claude/projects/<RUN_DIRNAME>/bd53d959-3a6b-456c-b6d8-586f6883902e.jsonl\", \"cwd\": \"<RUN>\", \"prompt_id\": \"405a3319-5681-43ef-9db6-06a24ca7758a\", \"permission_mode\": \"bypassPermissions\", \"agent_id\": \"ab9feaf3cf8de12c2\", \"agent_type\": \"general-purpose\", \"hook_event_name\": \"SubagentStop\", \"stop_hook_active\": false