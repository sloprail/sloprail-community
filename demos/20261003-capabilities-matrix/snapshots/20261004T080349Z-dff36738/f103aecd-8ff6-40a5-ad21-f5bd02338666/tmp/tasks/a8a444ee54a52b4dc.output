h.Glob(filepath.Join(dir, \"*.md\"))\n\t\tfor _, f := range files {\n\t\t\traw, err := os.ReadFile(f)\n\t\t\tif err != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif fm := frontmatter(string(raw)); fm[\"name\"] == name {\n\t\t\t\treturn fm[\"background\"] == \"true\"\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\n// frontmatter is the top-level `key: value` pairs between the leading `---`\n// lines of a markdown file.\nfunc frontmatter(text string) map[string]string {\n\tlines := strings.Split(text, \"\\n\")\n\tout := map[string]string{}\n\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n\t\treturn out\n\t}\n\tfor _, l := range lines[1:] {\n\t\tif strings.TrimSpace(l) == \"---\" {\n\t\t\tbreak\n\t\t}\n\t\tk, v, ok := strings.Cut(l, \":\")\n\t\tif !ok || strings.HasPrefix(l, \" \") {\n\t\t\tcontinue\n\t\t}\n\t\tout[strings.TrimSpace(k)] = strings.Trim(strings.TrimSpace(v), `\"'`)\n\t}\n\treturn out\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1066,"cache_read_input_tokens":152754,"output_tokens":1280,"output_tokens_details":{"thinking_tokens":164},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1066},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1280,"cache_read_input_tokens":152754,"cache_creation_input_tokens":1066,"cache_creation":{"ephemeral_5m_input_tokens":1066,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01JpQDXi8ZZujGKJxp858LRU":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a8a444ee54a52b4dc/claude-mock/internal/runner/agent_definition.go","content":"package runner\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/f