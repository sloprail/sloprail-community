urrentLimit = 20\n\n// AtConcurrentLimit reports whether another sub-agent may not be spawned: the\n// running ones already are the limit.\nfunc AtConcurrentLimit(running, limit int) bool { return running >= limit }\n''')\nsub('internal/subagents/limits_test.go', '''func TestConcurrentLimit(t *testing.T) {\n\tassert.Equal(t, 20, ConcurrentLimit(\"\"))\n\tassert.Equal(t, 3, ConcurrentLimit(\"3\"))\n\tfor _, bad := range []string{\"0\", \"-2\", \"1.5\", \"two\", \"1e3\", \" 4\"} {\n\t\tassert.Equal(t, DefaultConcurrentLimit, ConcurrentLimit(bad), bad)\n\t}\n\tassert.False(t, AtConcurrentLimit(19, 20))\n\tassert.True(t, AtConcurrentLimit(20, 20))\n}''', '''func TestAtConcurrentLimit(t *testing.T) {\n\tassert.False(t, AtConcurrentLimit(DefaultConcurrentLimit-1, DefaultConcurrentLimit))\n\tassert.True(t, AtConcurrentLimit(DefaultConcurrentLimit, DefaultConcurrentLimit))\n}''')\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2004,"cache_read_input_tokens":442638,"cache_creation":{"ephemeral_5m_input_tokens":2004,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01HLVMPFoskwsMk8vT2mFSo5":{"file_path":"/private/tmp/claude-501/-Users-nsviridenko-ws-sloprail-harness-mocks--claude-worktrees-harness-mocks-architecture-3031e7/f103aecd-8ff6-40a5-ad21-f5bd02338666/scratchpad/nd-edit17.py","content":"import os, subprocess\nos.chdir('/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a8a444ee54a52b4dc')\n\ndef sub(p, a, b):\n    s = open(p).read()\n    assert a in s, (p, a)\n    open(p, 'w').write(s.replace(a, b, 1))\n\nsubprocess.check_call(['git', 'checkout', 'origin/main', '--', 'claude-mock/run.go', 'claude-mock/internal/runner/config.go'])\nsub('claude-mock/internal/runner/agent_stop.go', '\t\tMaxConcurrentSubagents:  s.parent.MaxConcurrentSubagents,\\n', '')\nsub('claude-mock/internal/runner/agent_concurrency.go', 'subagents.ConcurrentLimit(cfg.MaxConcurrentSubagents)', 'subagents.DefaultConcurrentLimit')\ns = open('claude-mock/internal/runner/agent_concurrency.go').read()\ns = s.replace('''// session's running sub-agents are at the limit (CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS,\n// 20 by default): a tool error''', '''// session's running sub-agents are at the limit (20, the docs' default): a tool error''')\ns = s.replace('''// snapshots/runs/bgagent-concurrent-limit). ok is false when it may spawn.''', '''// snapshots/runs/bgagent-concurrent-limit, which set the limit to 1 with\n// CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS). ok is false when it may spawn.''')\nopen('claude-mock/internal/runner/agent_concurrency.go', 'w').write(s)\n\n# core: the default and the check only\nopen('internal/subagents/concurrency.go', 'w').write('''package subagents\n\n// DefaultConcurrentLimit is how many sub-agents may run in a session at once.\nconst DefaultConcurrentLimit = 20\n\n// AtConcurrentLimit reports whether another sub-agent may not be spawned: the\n// running ones already are the limit.\nfunc AtConcurrentLimit(running, limit int) bool { return running >= limit }\n''')\nsub('internal/subagents/limits_test.go', '''func TestConcurrentLimit(t *testing.T) {\n\tassert.Equal(t, 20, ConcurrentLimit(\"\"))\n\tassert.Equal(t, 3, ConcurrentLimit(\"3\"))\n\tfor _, bad := range []string{\"0\", \"-2\", \"1.5\", \"two\", \"1e3\", \" 4\"} {\n\t\tassert.Equal(t, DefaultConcurrentLimit, ConcurrentLimit(bad), bad)\n\t}\n\tassert.False(t, AtConcurrentLimit(19, 20))\n\tassert.True(t, AtConcurrentLimit(20, 20))\n}''', '''func TestAtConcurrentLimit(t *testing.T) {\n\tassert.False(t, AtConcurrentLimit(DefaultConcurrentLimit-1, DefaultConcurrentLimit))\n\tassert.True(t, AtConcurrentLimit(DefaultConcurrentLimit, DefaultConcurrentLimit))\n}''')\n"}},"apiBlockIndex":1,"requestId":"req_011CffocBjGNjcV8LQru17LQ","attribu