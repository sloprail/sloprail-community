ckground Bash\n// call the real claude made in a recorded run.\nfunc recordedBackgroundBashInput(t *testing.T, run string) map[string]any {\n\tt.Helper()\n\tfor _, p := range recordedHooks(t, run) {\n\t\tif in, _ := p[\"tool_input\"].(map[string]any); p[\"hook_event_name\"] == \"PreToolUse\" && p[\"tool_name\"] == \"Bash\" && in[\"run_in_background\"] == true {\n\t\t\treturn in\n\t\t}\n\t}\n\tt.Fatalf(\"run %s has no background Bash call\", run)\n\treturn nil\n}''')\nsub(p, \"// isImage and noOutputExpected false, and a backgroundTaskId (recorded:\\n// snapshots/runs/bgbash and snapshots/runs/midturn, payloads.jsonl).\", \"// isImage and noOutputExpected false, and a backgroundTaskId (recorded:\\n// snapshots/runs/bgbash and snapshots/runs/midturn, payloads.jsonl).\")\nsub('test_017_02f_nested_background_test.go', \"// sr:proves nested-subagents/claude\\n\", \"// sr:proves background-agent/claude\\n// sr:proves nested-subagents/claude\\n\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2223,"cache_read_input_tokens":329478,"cache_creation":{"ephemeral_5m_input_tokens":2223,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01XMbpNFmX8MWK7Qgp2DDuf5":{"file_path":"/private/tmp/claude-501/-Users-nsviridenko-ws-sloprail-harness-mocks--claude-worktrees-harness-mocks-architecture-3031e7/f103aecd-8ff6-40a5-ad21-f5bd02338666/scratchpad/nd-edit5.py","content":"import os\nos.chdir('/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a8a444ee54a52b4dc/claude-mock/e2e/017_session_lifecycle')\n\ndef sub(p, a, b):\n    s = open(p).read()\n    assert a in s, (p, a)\n    open(p, 'w').write(s.replace(a, b, 1))\n\np = 'test_017_61_background_bash_hook_payloads_test.go'\nsub(p, '''\t// bgbash recorded the input with a descri