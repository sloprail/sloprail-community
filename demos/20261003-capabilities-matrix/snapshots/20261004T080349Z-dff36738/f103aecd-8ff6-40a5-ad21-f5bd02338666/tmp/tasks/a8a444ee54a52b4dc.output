{"parentUuid":"4766d512-c1d0-4222-862f-dde76107cd5a","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a8a444ee54a52b4dc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MhmFZzyj34y1wVRWsg6pRx","type":"tool_result","content":"105\t// Its toolUseResult (also PostToolUse's tool_response) carries status\n106\t// \"completed\", the report as content, and the run's counts. The mock spends no\n107\t// tokens: subagent_tokens is 0.\n108\t//\n109\t// sr:provides foreground-subagent-result/claude\n110\tfunc buildAgentResult(sub *subagentRun, in agentToolInput, model string, out subagentOutcome, durationMs int64, worktreePath string) toolexec.Result {\n111\t\treport := out.finalText\n112\t\tcontent := []map[string]any{{\"type\": \"text\", \"text\": report}}\n113\t\tif report == \"\" {\n114\t\t\tcontent = []map[string]any{}\n115\t\t}\n116\t\ttext := subagents.HandBack(handbackFrame, noOutput, out.finalText)\n117\t\twt := \"\"\n118\t\tif worktreePath != \"\" {\n119\t\t\twt = \"\\nworktreePath: \" + worktreePath\n120\t\t}\n121\t\ttext += \"\\nagentId: \" + sub.agentID + \" (use SendMessage with to: '\" + sub.agentID + \"', summary: '<5-10 word recap>' to continue this agent)\" + wt +\n122\t\t\tfmt.Sprintf(\"\\n<usage>subagent_tokens: 0\\ntool_uses: %d\\nduration_ms: %d</usage>\", out.toolUses, durationMs)\n123\t\tif model == \"\" {\n124\t\t\tmodel = \"default\"\n125\t\t}\n126\t\tif in.Model != \"\" {\n127\t\t\tmodel = in.Model\n128\t\t}\n129\t\ttur := map[string]any{\n130\t\t\t\"status\": \"completed\", \"prompt\": in.Prompt, \"agentId\": sub.agentID, \"agentType\": sub.agentType,\n131\t\t\t\"harnessNoteCount\": 0, \"harnessTailCount\": 0, \"harnessSectionHash\": sectionHash(content),\n132\t\t\t\"content\": content, \"resolvedModel\": model, \"totalDurationMs\": durationMs, \"totalTokens\": 0,\n133\t\t\t\"totalToolUseCount\": out.toolUses,\n134\t\t}\n135\t\tif worktreePath != \"\" {\n136\t\t\ttur[\"worktreePath\"] = worktreePath\n137\t\t}\n138\t\treturn toolexec.Result{Output: text, ContentAsBlocks: true, ToolUseResult: tur}\n139\t}\n140\t"}]},"uuid":"665c112c-e3a0-4f25-8d3a-7b067319dd31","timestamp":"2026-10-03T17:51:09.170Z","sourceToolAssistantUUID":"4766d512-c1d0-4222-862f-dde76107cd5a","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a8a444ee54a52b4dc","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a5206b5b2ad4bea59"}
