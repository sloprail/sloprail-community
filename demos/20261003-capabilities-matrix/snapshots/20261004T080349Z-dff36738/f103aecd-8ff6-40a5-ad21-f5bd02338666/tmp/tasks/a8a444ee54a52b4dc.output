{"parentUuid":"0b76e688-1fec-41f9-9155-802593048558","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a8a444ee54a52b4dc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qw9ck1ouGJZ9GPMTt4jcUS","type":"tool_result","content":"// returned no output.)\" when it said nothing), then the trailer\n//\n//\tagentId: <id> (use SendMessage with to: '<id>', summary: '<5-10 word recap>' to continue this agent)[\\nworktreePath: <p>]\n//\t<usage>subagent_tokens: N\\ntool_uses: N\\nduration_ms: N</usage>\n//\n// Its toolUseResult (also PostToolUse's tool_response) carries status\n// \"completed\", the report as content, and the run's counts. The mock spends no\n// tokens: subagent_tokens is 0.\n//\n// sr:provides foreground-subagent-result/claude\nfunc buildAgentResult(sub *subagentRun, in agentToolInput, model string, out subagentOutcome, durationMs int64, worktreePath string) toolexec.Result {\n\treport, matched := subagents.Scan(out.finalText, claudeScanRules)\n\tcontent := []map[string]any{{\"type\": \"text\", \"text\": report}}\n\tif report == \"\" {\n\t\tcontent = []map[string]any{}\n\t}\n\ttext := subagents.HandBack(handbackFrame, noOutput, report)\n\tnotes := 0\n\tif len(matched) > 0 {\n\t\t// A report the scan reported on is headed by its notice: a block of\n\t\t// its own in the content, a line (and an empty one) ahead of the frame.\n\t\tnotice := scanNotice(matched)\n\t\tcontent = append([]map[string]any{{\"type\": \"text\", \"text\": notice + \"\\n\"}}, content...)\n\t\ttext = \"  \" + notice + \"\\n  \\n\" + text\n\t\tnotes = 1\n\t}\n\twt := \"\"\n\tif worktreePath != \"\" {\n\t\twt = \"\\nworktreePath: \" + worktreePath\n\t}\n\ttext += \"\\nagentId: \" + sub.agentID + \" (use SendMessage with to: '\" + sub.agentID + \"', summary: '<5-10 word recap>' to continue this agent)\" + wt +\n\t\tfmt.Sprintf(\"\\n<usage>subagent_tokens: 0\\ntool_uses: %d\\nduration_ms: %d</usage>\", out.toolUses, durationMs)\n\tif model == \"\" {\n\t\tmodel = \"default\"\n\t}\n\tif in.Model != \"\" {\n\t\tmodel = in.Model\n\t}\n\ttur := map[string]any{\n\t\t\"status\": \"completed\", \"prompt\": in.Prompt, \"agentId\": sub.agentID, \"agentType\": sub.agentType,\n\t\t\"harnessNoteCount\": notes, \"harnessTailCount\": 0, \"harnessSectionHash\": sectionHash(content),\n\t\t\"content\": content, \"resolvedModel\": model, \"totalDurationMs\": durationMs, \"totalTokens\": 0,\n\t\t\"totalToolUseCount\": out.toolUses, \"usage\": zeroUsage(),\n\t}\n\tif ts := toolStatsOf(sub.sidechain); ts != nil {\n\t\ttur[\"toolStats\"] = ts\n\t}\n\tif worktreePath != \"\" {\n\t\ttur[\"worktreePath\"] = worktreePath\n\t\tif sub.branch != \"\" {\n\t\t\ttur[\"worktreeBranch\"] = sub.branch\n\t\t}\n\t}\n\treturn toolexec.Result{Output: text, ContentAsBlocks: true, ToolUseResult: tur}\n}\n\n// zeroUsage is the usage object a sub-agent's result carries, with the mock's\n// token counts: it spends none.\nfunc zeroUsage() map[string]any {\n\treturn map[string]any{\n\t\t\"output_tokens_details\": map[string]any{\"thinking_tokens\": 0},\n\t\t\"input_tokens\":          0, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 0, \"output_tokens\": 0,\n\t\t\"server_tool_use\": map[string]any{\"web_search_requests\": 0, \"web_fetch_requests\": 0},\n\t\t\"service_tier\":    \"standard\",\n\t\t\"cache_creation\":  map[string]any{\"ephemeral_1h_input_tokens\": 0, \"ephemeral_5m_input_tokens\": 0},\n\t\t\"inference_geo\":   \"not_available\", \"iterations\": []any{}, \"speed\": \"standard\", \"fallback_credit\": nil,\n\t}\n}","is_error":false}]},"uuid":"91afb67b-4d5e-4aa3-b164-59bb4090cc30","timestamp":"2026-10-03T17:58:39.636Z","sourceToolAssistantUUID":"0b76e688-1fec-41f9-9155-802593048558","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a8a444ee54a52b4dc","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-a