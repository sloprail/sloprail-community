     statement: >-\n          The mock does not take tools away''', '''      - adr: modeled-surface\n        statement: >-\n          The mock does not model what the docs say of a background sub-agent's\n          background shell command that runs past the end of its turn: that Claude\n          Code sends the sub-agent a notification when the command ends. A mock\n          sub-agent is a script run to its result, which nothing wakes again.\n      - adr: modeled-surface\n        statement: >-\n          The mock does not model conversation forks: `/subtask` and `/fork` are\n          slash commands of an interactive session, and the docs' rule that a fork\n          takes a slot of the concurrent limit while it runs, and is never refused\n          by it, is theirs.\n      - adr: modeled-surface\n        statement: >-\n          The mock does not take tools away''')\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1286,"cache_read_input_tokens":413181,"cache_creation":{"ephemeral_5m_input_tokens":1286,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_019ae8CWD59txwKgJkJwpoQ4":{"file_path":"/private/tmp/claude-501/-Users-nsviridenko-ws-sloprail-harness-mocks--claude-worktrees-harness-mocks-architecture-3031e7/f103aecd-8ff6-40a5-ad21-f5bd02338666/scratchpad/nd-edit12.py","content":"import os, subprocess\nos.chdir('/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a8a444ee54a52b4dc')\nsubprocess.check_call(['git', 'checkout', 'origin/main', '--', 'claude-mock/run.go'])\nsubprocess.check_call(['git', 'checkout', 'origin/main', '--', 'claude-mock/internal/runner/config.go'])\n\ndef sub(p, a, b):\n    s = open(p).read()\n    assert a in s, (p, a)\n    open(p, 'w').write(s.replace(a, b, 1))\n\nsub('claude-mock