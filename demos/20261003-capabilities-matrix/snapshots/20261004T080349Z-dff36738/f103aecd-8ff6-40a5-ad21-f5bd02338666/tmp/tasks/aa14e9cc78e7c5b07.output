\n+ func (c Call) Background() bool { _, ok := c.Args[\"blockUntilMs\"]; return ok }\n++>>>>>>> 34e0a57 (cursor, codex: foreground-subagent-bash-ends-with-response (cursor supported with deviations, codex unsupported), recorded)\n  \n  // Command is the shell line of a Shell call.\n  func (c Call) Command() string { return c.str(\"command\") }\ndiff --cc internal/subagents/module.yaml\nindex d13be3c,6359673..0000000\n--- a/internal/subagents/module.yaml\n+++ b/internal/subagents/module.yaml\n@@@ -1,5 -1,5 +1,9 @@@\n  # A module is an area of code with a boundary; its decisions live here, not in an ADR.\n  # No core yet (internal/subagents): the code lives in the claude-mock files below, until it moves.\n  concern: \"a nested agent run: its identity, working directory or worktree, transcript, hooks and result\"\n++<<<<<<< HEAD\n +home: [\"internal/subagents/**\", \"claude-mock/internal/runner/agent*.go\", \"claude-mock/internal/runner/session_subagent.go\", \"codex-mock/internal/runner/agent_tool.go\", \"codex-mock/internal/runner/agent_host.go\"]   # everything about the concern lives here\n++=======\n+ home: [\"internal/subagents/**\", \"claude-mock/internal/runner/agent*.go\", \"claude-mock/internal/runner/session_subagent.go\", \"cursor-mock/internal/runner/agent*.go\"]   # everything about the concern lives here\n++>>>>>>> 34e0a57 (cursor, codex: foreground-subagent-bash-ends-with-response (cursor supported with deviations, codex unsupported), recorded)\n  api: [\"internal/subagents\"]       # the only packages others may import\ndiff --cc internal/tasks/module.yaml\nindex d585174,269ba81..0000000\n--- a/internal/tasks/module.yaml\n+++ b/internal/tasks/module.yaml\n@@@ -1,5 -1,5 +1,9 @@@\n  # A module is an area of code with a boundary; its decisions live here, not in an ADR.\n  # No core yet (internal/tasks): the code lives in the claude-mock files below, until it moves.\n  concern: \"background tasks: launching, tracking, delivering their notifications and kil