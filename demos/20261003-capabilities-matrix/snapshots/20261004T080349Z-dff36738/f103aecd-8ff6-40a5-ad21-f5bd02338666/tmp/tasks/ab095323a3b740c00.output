{"parentUuid":"9e82b070-21a0-4fa8-afc1-8e92cc782df7","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ab095323a3b740c00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LfC4oL5u4kuW1e51S6MqsQ","type":"tool_result","content":"package runner\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n)\n\n// A compaction streams frames a `claude -p --output-format stream-json` run shows\n// around it (recorded: snapshots/runs/compact): system/status \"compacting\" when\n// it starts, system/status with compact_result \"success\" when the summary is\n// done, a system/init frame, and the system/compact_boundary frame carrying the\n// boundary's metadata in snake_case. The summary and, for a manual compaction,\n// the /compact command's output follow as user frames.\n\n// writeCompactingStatus announces that a compaction has begun.\nfunc writeCompactingStatus(cfg Config) {\n\twriteFrame(cfg, map[string]any{\"type\": \"system\", \"subtype\": \"status\", \"status\": \"compacting\"})\n}\n\n// writeCompactedFrames streams what a finished compaction reports before its\n// summary: the end status, a session init and the boundary, whose metadata is the\n// transcript boundary's (meta) with its keys in snake_case.\nfunc writeCompactedFrames(cfg Config, meta map[string]any, logicalParent string) {\n\twriteFrame(cfg, map[string]any{\"type\": \"system\", \"subtype\": \"status\", \"status\": nil, \"compact_result\": \"success\"})\n\tinit := map[string]any{\"type\": \"system\", \"subtype\": \"init\", \"cwd\": cfg.Cwd, \"claude_code_version\": stampVersion}\n\tif cfg.Model != \"\" {\n\t\tinit[\"model\"] = cfg.Model\n\t}\n\twriteFrame(cfg, init)\n\twriteFrame(cfg, map[string]any{\n\t\t\"type\": \"system\", \"subtype\": \"compact_boundary\",\n\t\t\"compact_metadata\": snakeKeys(meta), \"logical_parent_uuid\": logicalParent,\n\t})\n}\n\nvar camelHump = regexp.MustCompile(`([a-z0-9])([A-Z])`)\n\n// snakeKeys is v with every map key camelCase turned to snake_case.\nfunc snakeKeys(v any) any {\n\tswitch x := v.(type) {\n\tcase map[string]any:\n\t\tout := make(map[string]any, len(x))\n\t\tfor k, val := range x {\n\t\t\tout[strings.ToLower(camelHump.ReplaceAllString(k, \"${1}_${2}\"))] = snakeKeys(val)\n\t\t}\n\t\treturn out\n\tcase []string:\n\t\treturn x\n\t}\n\treturn v\n}\nhook_frames.go:13:// writeSessionStartFrames streams each SessionStart handler's run as a\nhook_frames.go:19:func writeSessionStartFrames(cfg Config, in hooks.Input, runs []hooks.HandlerRun) {\nhook_frames.go:60:// startSource is SessionStart's source for how a session began.\nhook_frames.go:70:\t\treturn \"compact\"\nhook_frames.go:113:// fireCompactedStart fires SessionStart for the session continuing after a\nhook_frames.go:114:// compaction. Its context is not carried to a next turn here, and no hook\nhook_frames.go:119:\t_, _ = fireSessionStart(ctx, cfg, inv, corehooks.SessionStartKind(false, false, true))\ncontrol_boundary.go:8:\t\"github.com/sloprail/harness-mocks/internal/compaction\"\ncontrol_boundary.go:11:// writeCompactBoundary appends the compact_boundary a compaction opens with.\ncontrol_boundary.go:13:// a real compaction happened in holds its boundary part-way down (46 of the 65\ncontrol_boundary.go:18:// accounts for) is the compaction capability's plan (compaction.PlanBoundary);\ncontrol_boundary.go:19:// this writes it in Claude Code's compactMetadata shape. Two shapes, both\ncontrol_boundary.go:20:// observed in manual compactions of claude 2.1.282:\ncontrol_boundary.go:22://   - with a preserved segment (F:compact; 64 of 65 real boundaries):\ncontrol_boundary.go:23://     compactMetadata names the kept records — preservedMessages {anchorUuid,\ncontrol_boundary.go:27://   - without one (F:compact-nohooks; 1 of 65): neither field.\ncontrol_boundary.go:29:// sr:provides compaction-transcript-continuity/claude\ncontrol_boundary.go:30:func writeCompactBoundary(cfg Config, tr *transcript, spec compactionSpec) {\ncontrol_boundary.go:31:\tplan := compaction.PlanBoundary(compaction.PlanInput{\ncontrol_boundary.go:52:\t// cumulativeDroppedTokens: what the session's compactions have dropped so\ncontrol_boundary.go:59:\t\t\"subtype\":         \"compact_boundary\",\ncontrol_boundary.go:60:\t\t\"content\":         \"Conversation compacted\",\ncontrol_boundary.go:63:\t\t\"compactMetadata\": meta,\ncontrol_boundary.go:71:// lastCumulativeDropped is the cumulativeDroppedTokens of the last compact\ncontrol_boundary.go:80:\t\tif !strings.Contains(line, \"compact_boundary\") {\ncontrol_boundary.go:87:\t\t\t} `json:\"compactMetadata\"`\ncontrol_boundary.go:89:\t\tif json.Unmarshal([]byte(line), &rec) == nil && rec.Subtype == \"compact_boundary\" {\ncontrol_compact.go:10:\t\"github.com/sloprail/harness-mocks/internal/compaction\"\ncontrol_compact.go:13:// compact is a compaction, the way real Claude Code performs one. Evidence:\ncontrol_compact.go:14:// the manual /compact runs under claude-mock/snapshots/runs/compact and\ncontrol_compact.go:15:// compact-nohooks, the 65 compact_boundary records in the real transcripts,\ncontrol_compact.go:16:// and the binary's compaction path.\ncontrol_compact.go:19://     decision:block stops the compaction — nothing is written.\ncontrol_compact.go:20://  2. For a MANUAL compaction, SubagentStop fires for the summarizer that\ncontrol_compact.go:22://     compaction, so not fired for one.)\ncontrol_compact.go:23://  3. A compact_boundary is APPENDED to the file the session is writing (see\ncontrol_compact.go:26://  4. SessionStart fires with source \"compact\", then PostCompact\ncontrol_compact.go:27://     {trigger, compact_summary}. Neither Pre- nor PostCompact leaves an\ncontrol_compact.go:29://  5. A manual compaction is the /compact command, so the three records a\ncontrol_compact.go:31://     SessionStart:compact's attachments come after them.\ncontrol_compact.go:33:// The order is the compaction capability's (internal/compaction); this supplies\ncontrol_compact.go:34:// each step. It returns whether the compaction happened, or an error for a\ncontrol_compact.go:36:// {\"type\":\"compact\"[,\"summary\":…][,\"trigger\":\"auto\"|\"manual\"][,\"preserve\":N]\ncontrol_compact.go:41:// sr:provides manual-compaction/claude\ncontrol_compact.go:42:// sr:docs https://code.claude.com/docs/en/hooks#precompact\ncontrol_compact.go:43:// sr:docs https://code.claude.com/docs/en/hooks#postcompact\ncontrol_compact.go:44:func compact(ctx context.Context, cfg Config, inv *hooks.Invoker, tr *transcript, rec *cliRecord, line []byte) (bool, error) {\ncontrol_compact.go:49:\t\treturn false, fmt.Errorf(\"claude-mock: compact: tail_offset must not be negative, got %d\", rec.TailOffset)\ncontrol_compact.go:53:\t\t\treturn false, fmt.Errorf(\"claude-mock: compact: tail_offset needs a preserved segment, but preserved_segment is false\")\ncontrol_compact.go:56:\t\t\treturn false, fmt.Errorf(\"claude-mock: compact: tail_offset %d leaves no record for the preserved segment to end on: only %d records are written\", rec.TailOffset, have)\nagent.go\nagent_layout.go\nagent_prepare.go\nagent_result.go\nagent_run.go\nagent_stop.go\nagent_worktree.go\nbackground_agent.go\nbackground_bash.go\nbackground_command.go\nbackground_frames.go\nbackground_notify.go\nbackground_queue.go\nbackground_task.go\nbackground_test.go\nconfig.go\ncontrol.go\ncontrol_boundary.go\ncontrol_compact.go\ncontrol_frames.go\ncontrol_records.go\ncontrol_spec.go\ncontrol_summary.go\nfork_test.go\nhook_frames.go\nrecord.go\nrecord_extract.go\nrunner.go\nrunner_print.go\nrunner_resume.go\nrunner_session_hooks.go\nschedulewakeup.go\nsession_append.go\nsession_fork.go\nsession_paths.go\nsession_resume.go\nsession_seed.go\nsession_subagent.go\nsession_test.go\nsessionwriter.go\nsessionwriter_chain.go\nstream.go\nstream_hook.go\nstream_scan.go\nstream_tool.go\nstream_turn.go\ntool_hooks.go\ntool_result_test.go\ntranscript.go\ntranscript_hookname.go\ntranscript_hookrecord.go\ntranscript_hookruns.go\ntranscript_hooks.go\ntranscript_stamp.go\ntranscript_stop.go\ntranscript_test.go","is_error":false}]},"uuid":"8a503043-7ccc-4d05-943d-3f12595681e3","timestamp":"2026-10-03T18:33:41.922Z","sourceToolAssistantUUID":"9e82b070-21a0-4fa8-afc1-8e92cc782df7","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-adc1470310079e23b"}
