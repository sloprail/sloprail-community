{"parentUuid":"d6f94122-9166-4880-948c-63bb6e6c8821","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ab095323a3b740c00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SZmdUsjYX6zhF9MTeaWPZD","type":"tool_result","content":"47-\treturn nil\n48-}\n49-\n50-// firePostTool fires the hook a tool call's result calls for: PostToolUse\n51-// with the tool's response, or PostToolUseFailure with the error text the\n52-// agent got, or neither.\n53:func firePostTool(ctx context.Context, cfg Config, inv *hooks.Invoker, pending pendingToolUse, res toolexec.Result, took time.Duration) {\n54-\toutcome := corehooks.ToolSucceeded\n55-\tswitch {\n56-\tcase res.Failed:\n57-\t\toutcome = corehooks.ToolFailed\n58-\tcase res.IsError:\n59-\t\toutcome = corehooks.ToolErrored\n60-\t}\n61-\t// sr:provides tool-failure-hook/claude\n62-\tswitch corehooks.AfterToolHook(outcome) {\n63-\tcase corehooks.AfterFailure:\n64-\t\tnotInterrupted := false\n65-\t\tms := took.Milliseconds()\n66-\t\t_, _ = inv.Fire(ctx, hooks.Input{\n67-\t\t\tSessionID:     cfg.SessionID,\n68-\t\t\tCwd:           cfg.Cwd,\n69-\t\t\tHookEventName: hooks.EventPostToolUseFailure,\n70-\t\t\tToolName:      pending.ToolName,\n71-\t\t\tToolUseID:     pending.ToolUseID,\n72-\t\t\tToolInput:     pending.ToolInput,\n73-\t\t\tError:         res.Output,\n74-\t\t\tIsInterrupt:   &notInterrupted,\n75-\t\t\tDurationMs:    &ms,\n76-\t\t})\n77-\tcase corehooks.AfterSuccess:\n78-\t\t// sr:provides posttooluse-payload/claude\n79-\t\tn := corehooks.NewPostTool(pending.ToolInput, toolResponse(res), took)\n80-\t\t_, _ = inv.Fire(ctx, hooks.Input{\n81-\t\t\tSessionID:     cfg.SessionID,\n82-\t\t\tCwd:           cfg.Cwd,\n83-\t\t\tHookEventName: hooks.EventPostToolUse,\n84-\t\t\tToolName:      pending.ToolName,\n85-\t\t\tToolUseID:     pending.ToolUseID,\n86-\t\t\tToolInput:     n.Input,\n87-\t\t\tToolResponse:  n.Response,\n88-\t\t\tDurationMs:    &n.DurationMs,\n89-\t\t})\n90-\t}\n91-}","is_error":false}]},"uuid":"b4409f22-9e31-47c6-afcf-3d1348e58c3f","timestamp":"2026-10-03T18:52:02.443Z","sourceToolAssistantUUID":"d6f94122-9166-4880-948c-63bb6e6c8821","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a8a444ee54a52b4dc"}
