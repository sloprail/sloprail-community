ns=s.replace('''// session's does not. The mock spends no tokens, so the token facts are 0.''','''// session's does not. The mock counts no tokens: context_tokens is an estimate\n// from the transcript's size, priced as the recorded runs price theirs (2 dollars\n// per million tokens, test T017_78).''')\ns=s.replace('''\t\tassert.Equal(t, float64(0), p[\"context_tokens\"])\n\t\tassert.Equal(t, false, p[\"prompt_cache_likely_expired\"])\n\t\tassert.Equal(t, float64(0), p[\"estimated_cache_write_usd\"])''','''\t\tassert.Greater(t, p[\"context_tokens\"], float64(0), \"a resumed session has a context to send again\")\n\t\tassert.Equal(t, false, p[\"prompt_cache_likely_expired\"])\n\t\tassert.Greater(t, p[\"estimated_cache_write_usd\"], float64(0))''')\nopen(p,'w').write(s)\nEOF\ncd claude-mock && gofmt -w internal/runner/runner_resume.go && go build ./... "},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":686,"cache_read_input_tokens":302457,"output_tokens":1081,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":686},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1081,"cache_read_input_tokens":302457,"cache_creation_input_tokens":686,"cache_creation":{"ephemeral_5m_input_tokens":686,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UGGTbpAZVo7qeck3XLkgFY":{"command":"python3 - <<'EOF'\np='claude-mock/internal/runner/runner_resume.go'\ns=open(p).read()\ns=s.replace('''// resumeFields is what the SessionStart of a resumed session carries beyond\n// source: the time since the transcript's last record, and the cost facts of\n// re-sending the contex