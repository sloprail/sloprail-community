{"parentUuid":"91c51337-1c5e-48a0-9b67-858f10b3ca13","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ab095323a3b740c00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TFnYdf8wM9CjU57eAK2pgw","type":"tool_result","content":"28\t\n29\t// rootRunE implements the root command's RunE — the primary entrypoint when the\n30\t// binary is used as a drop-in for 'claude -p --output-format stream-json ...'.\n31\t// sr:provides session-resume/claude\n32\t// sr:provides session-fork/claude\n33\t// sr:provides noninteractive-run/claude\n34\t// a10n:blueprint:ignore\n35\tfunc rootRunE(cmd *cobra.Command, args []string) error {\n36\t\tscriptPath, _ := cmd.Flags().GetString(flagScript)\n37\t\tif scriptPath == \"\" {\n38\t\t\tscriptPath = os.Getenv(\"A10N_MOCK_SCRIPT\")\n39\t\t}\n40\t\n41\t\tsessionID, _ := cmd.Flags().GetString(flagSessionID)\n42\t\tresumeID, _ := cmd.Flags().GetString(flagResume)\n43\t\tforkSession, _ := cmd.Flags().GetBool(flagForkSession)\n44\t\tisResume := false\n45\t\tforkFrom := \"\"\n46\t\n47\t\t// Normalise: --resume takes precedence and sets isResume — except with\n48\t\t// --fork-session, where the resumed id is what is continued FROM and the\n49\t\t// session runs under --session-id (or a fresh id).\n50\t\tswitch {\n51\t\tcase resumeID != \"\" && forkSession:\n52\t\t\tforkFrom = resumeID\n53\t\t\tisResume = true\n54\t\t\tif sessionID == \"\" {\n55\t\t\t\tsessionID = runner.NewSessionID()\n56\t\t\t}\n57\t\tcase resumeID != \"\":\n58\t\t\tsessionID = resumeID\n59\t\t\tisResume = true\n60\t\t}\n61\t\tif sessionID == \"\" {\n62\t\t\treturn fmt.Errorf(\"claude-mock: --session-id or --resume is required\")\n63\t\t}\n64\t\n65\t\tprojectDir, _ := cmd.Flags().GetString(flagProjectDir)\n66\t\tif projectDir == \"\" {\n67\t\t\tvar err error\n68\t\t\tprojectDir, err = os.Getwd()\n69\t\t\tif err != nil {\n70\t\t\t\treturn fmt.Errorf(\"claude-mock: getwd: %w\", err)\n71\t\t\t}\n72\t\t}\n73\t\n74\t\t// A10N_MOCK_NO_RESUME=1 makes every --resume behave as one naming a session\n75\t\t// that does not exist (see noConversation), whatever is on disk.\n76\t\t// sr:invariant no-resume\n77\t\tif isResume && os.Getenv(\"A10N_MOCK_NO_RESUME\") == \"1\" {\n78\t\t\tnoConversation(cmd, &runner.ErrNoConversation{SessionID: sessionID})\n79\t\t}\n80\t\n81\t\tconfigDir, _ := cmd.Flags().GetString(flagConfigDir)\n82\t\tpluginCacheDir, _ := cmd.Flags().GetString(flagPluginCacheDir)\n83\t\tprintMode, _ := cmd.Flags().GetBool(flagPrint)\n84\t\tsystemPrompt, _ := cmd.Flags().GetString(\"system-prompt\")\n85\t\t// sr:invariant system-prompt-env\n86\t\tif systemPrompt != \"\" {\n87\t\t\tos.Setenv(\"A10N_MOCK_SYSTEM_PROMPT\", systemPrompt) //nolint:errcheck"}]},"uuid":"5f5ee287-0408-4029-9a62-71812f97cd98","timestamp":"2026-10-03T18:44:00.148Z","sourceToolAssistantUUID":"91c51337-1c5e-48a0-9b67-858f10b3ca13","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a8a444ee54a52b4dc"}
