esume; an unnamed session carries none (recorded:\n\t// snapshots/runs/resume-name).\n\tSessionTitle string `json:\"session_title,omitempty\"`","is_error":false}]},"uuid":"03139fbe-490c-4915-87d2-535794ee2cd5","timestamp":"2026-10-03T19:22:21.015Z","sourceToolAssistantUUID":"16d5ee7e-49de-4f87-a13e-6ea43b97c2b4","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a8a444ee54a52b4dc"}
