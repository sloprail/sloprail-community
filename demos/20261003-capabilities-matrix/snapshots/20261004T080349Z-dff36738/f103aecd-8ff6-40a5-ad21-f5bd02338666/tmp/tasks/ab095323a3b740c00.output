= \"\" {\n\t\t\t\ttoolName = toolNameInTranscript(tr, toolUseID)\n\t\t\t}\n\t\t\tif toolName != \"\" {\n\t\t\t\t_, _ = inv.Fire(ctx, hooks.Input{\n\t\t\t\t\tSessionID:     cfg.SessionID,\n\t\t\t\t\tCwd:           cfg.Cwd,\n\t\t\t\t\tHookEventName: hooks.EventPostToolUse,\n\t\t\t\t\tToolName:      toolName,\n\t\t\t\t\tToolUseID:     toolUseID,\n\t\t\t\t\tToolResponse:  toolOutput,\nbackground_agent.go-72-// writeStreamLine writes one line to the output stream in a single Write, so\nbackground_agent.go-73-// a frame another goroutine writes (a background sub-agent's) can never land\nbackground_agent.go-74-// between a line and its newline.\nbackground_agent.go:75:func writeStreamLine(cfg Config, line []byte) {\nbackground_agent.go-76-\tif len(line) == 0 {\nbackground_agent.go-77-\t\treturn\nbackground_agent.go-78-\t}\nbackground_agent.go-79-\tbuf := make([]byte, 0, len(line)+1)\nbackground_agent.go-80-\tbuf = append(append(buf, line...), '\\n')\nbackground_agent.go-81-\tcfg.Out.Write(buf) //nolint:errcheck\nbackground_agent.go-82-}\nbackground_agent.go-83-\nbackground_agent.go-84-// inputValidationError is the tool_result real Claude Code returns for a call\nbackground_agent.go-85-// missing required parameters: \"<tool_use_error>InputValidationError: <Tool>\nbackground_agent.go-86-// failed due to the following issue(s):\\nThe required parameter `x` is\nbackground_agent.go-87-// missing</tool_use_error>\", with the zod issues as toolUseResult.\nbackground_agent.go-88-func inputValidationError(tool string, missing []string) toolexec.Result {\nbackground_agent.go-89-\tnoun := \"issue\"\nbackground_agent.go-90-\tif len(missing) > 1 {\nbackground_agent.go-91-\t\tnoun = \"issues\"\nbackground_agent.go-92-\t}\nbackground_agent.go-93-\tvar lines []string\nbackground_agent.go-94-\tvar issues []map[string]any\nbackground_agent.go-95-\tfor _, m := range missing {\nbackground_agent.go-96-\t\tlines = append(lines, \"The required parameter `\"+m+\"` is missing\")\nbackground_agent.go-97-\t\tissues = append(issues, map[string]any{\nbackground_agent.go-98-\t\t\t\"expected\": \"string\", \"code\": \"invalid_type\", \"path\": []string{m},\nbackground_agent.go-99-\t\t\t\"message\": \"Invalid input: expected string, received undefined\",\nbackground_agent.go-100-\t\t})","is_error":false}]},"uuid":"150ac558-c405-487c-bde8-17bf91d1596a","timestamp":"2026-10-03T19:16:38.387Z","sourceToolAssistantUUID":"b1c0c743-b40e-491d-9fb1-dcdd8ecac41d","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a8a444ee54a52b4dc"}
