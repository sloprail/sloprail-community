{"parentUuid":"a306258d-10a3-48e4-8cc5-b540eb5fe5e5","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ab095323a3b740c00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124QFUBtVmcKJtMTzEkc9xL","type":"tool_result","content":"\tif cfg.IsResume {\n\t\tif r, err := session.Resume(claudeLayout, cfg.ConfigDir, cfg.Cwd, cfg.SessionID); err == nil {\n\t\t\treturn openTranscript(r.Path, r.Reported, stamp)\n\t\t}\n\t}\n\treturn openTranscript(here, here, stamp)\n}\n\n// writeRootPrompt writes a FRESH session's prompt as the human turn it is,\n// chained after whatever the session has written so far — which, if a\n// SessionStart hook printed anything, is that hook's attachment. Its uuid is\n// the deterministic `e2e-root-<session>`. Like a real `claude -p` prompt it is\n// marked promptSource/turnOrigin \"sdk\".\n//\n// A caller that pre-seeded the transcript with that same record before the\n// mock ran (the older sloprail harness did) is honoured rather than\n// duplicated: the record is left where it is and the preamble put ahead of it.\nfunc writeRootPrompt(tr *transcript, sessionID, cwd, prompt string) {\n\tif prompt == \"\" {\n\t\treturn\n\t}\n\trootID := \"e2e-root-\" + sessionID\n\tif tr.exists() && fileHasUUID(tr.path, rootID) {\n\t\tseedPreamble(tr.file(), sessionID)\n\t\treturn\n\t}\n\trec := map[string]any{\n\t\t\"type\":    \"user\",\n\t\t\"uuid\":    rootID,\n\t\t\"cwd\":     cwd,\n\t\t\"message\": map[string]any{\"role\": \"user\", \"content\": prompt},\n\t}\n\tmarkPrompt(rec)\n\ttr.persistMap(rec)\n}\n\n// appendResumePrompt writes a RESUME's prompt as the next human turn, chained\n// to the last record on disk. A re-entry that already wrote this prompt as the\n// last human turn is not written twice.\nfunc appendResumePrompt(tr *transcript, sessionID, prompt string) {\n\tif prompt == \"\" {\nsession_append.go:45:// sr:provides session-resume/claude\nrunner_resume.go:20:// sr:provides session-resume-unknown/claude\nrunner_resume.go:21:// sr:docs https://code.claude.com/docs/en/cli-reference#cli-flags\n../hooks/event.go:58:\t// ResumeFields are a resumed session's: what the resume costs and how stale it is.\n../hooks/event.go:59:\t*ResumeFields\n../hooks/resume_fields.go:3:// ResumeFields are the SessionStart fields only a resumed session carries (recorded:\n../hooks/resume_fields.go:5:type ResumeFields struct {\nact.go\naftertool.go\nblockreason.go\nblockreason_test.go\ncandidates.sh\ndir.go\ndir_test.go\nexitcode.go\nexitcode_test.go\nhandling_test.go\nhttp.go\nlifecycle.go\nlifecycle_test.go\nmatch.go\nmodule.yaml\noutput.go\npayload.go\npayload_test.go\nplugin.go\npretool.go\nrecord.go\nrefusal.go\nrefusal_told_test.go\nrun.go\nrun_test.go\nstrict.go\nstrict_test.go\ntool_test.go","is_error":false}]},"uuid":"1db3db34-41e9-42b0-9b5e-9d19f87256d5","timestamp":"2026-10-03T18:55:10.776Z","sourceToolAssistantUUID":"a306258d-10a3-48e4-8cc5-b540eb5fe5e5","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a8a444ee54a52b4dc"}
