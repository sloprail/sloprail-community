{"parentUuid":"644f7181-e8be-4f08-a0f4-5e12d01348e8","isSidechain":true,"agentId":"ab095323a3b740c00","attachment":{"type":"edited_text_file","filename":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00/claude-mock/e2e/017_session_lifecycle/test_017_subagent_compaction_test.go","snippet":"1\tpackage e2e\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t\n9\t\t\"github.com/stretchr/testify/assert\"\n10\t\t\"github.com/stretchr/testify/require\"\n11\t)\n12\t\n...\n14\t// subagents/agent-<id>.jsonl, under its own chain and sidechain flags, and the\n15\t// session's file holds no boundary (sub-agents doc, auto-compaction).\n16\t// sr:proves subagent-transcripts/claude\n17\tfunc TestT017_85_SubagentCompactionIsLoggedInItsOwnFile(t *testing.T) {\n18\t\tdir := t.TempDir()\n19\t\tcfg := filepath.Join(dir, \"config\")\n20\t\tsub := script(t, dir, \"sub\",\n21\t\t\ttoolUse(\"sb1\", \"Bash\", `{\"command\":\"true\"}`),\n22\t\t\t`{\"type\":\"compact\",\"summary\":\"sub summary @MARK@\",\"trigger\":\"auto\",\"pre_tokens\":9000,\"post_tokens\":900}`)\n23\t\torch := script(t, dir, \"orch\", toolUse(\"ag1\", \"Agent\", `{\"prompt\":\"work\",\"description\":\"compacter\",\"script\":\"`+sub+`\"}`))\n24\t\tout, code := runInDir(t, dir, nil, \"--script\", orch, \"--session-id\", \"subcmp-1\",\n25\t\t\t\"--project-dir\", dir, \"--config-dir\", cfg, \"-p\", \"hello\")\n26\t\trequire.Equal(t, 0, code, out)\n27\t\n28\t\tmain := transcriptPath(t, cfg, dir, \"subcmp-1\")\n29\t\tassert.NotContains(t, readString(t, main), \"compact_boundary\", \"the session's own file has no boundary\")\n30\t\tsides, err := filepath.Glob(filepath.Join(strings.TrimSuffix(main, \".jsonl\"), \"subagents\", \"agent-*.jsonl\"))\n31\t\trequire.NoError(t, err)\n32\t\trequire.Len(t, sides, 1)\n33\t\tagentID := strings.TrimSuffix(strings.TrimPrefix(filepath.Base(sides[0]), \"agent-\"), \".jsonl\")\n34\t\tboundaries := 0\n35\t\tfor _, r := range readRecs(t, sides[0]) {\n36\t\t\tif r.Subtype == \"compact_boundary\" {\n37\t\t\t\tboundaries++\n38\t\t\t\tvar full map[string]any\n39\t\t\t\trequire.NoError(t, json.Unmarshal([]byte(r.Raw), &full))\n40\t\t\t\tassert.Equal(t, \"system\", full[\"type\"])\n41\t\t\t\tmeta := full[\"compactMetadata\"].(map[string]any)\n42\t\t\t\tassert.Equal(t, \"auto\", meta[\"trigger\"])\n43\t\t\t\tassert.EqualValues(t, 9000, meta[\"preTokens\"])\n44\t\t\t\tassert.True(t, r.IsSidechain)\n45\t\t\t\tassert.Equal(t, agentID, r.AgentID)\n46\t\t\t\tassert.Equal(t, \"subcmp-1\", r.SessionID)\n47\t\t\t}\n48\t\t}\n49\t\tassert.Equal(t, 1, boundaries, \"the boundary is in the sub-agent's file\")\n50\t\tassert.Contains(t, readString(t, sides[0]), `\"isCompactSummary\":true`)\n51\t\tassert.NotContains(t, readString(t, main), \"sub summary\")"},"type":"attachment","uuid":"1929cd8a-74c1-42a6-b086-7fed5ea541a4","timestamp":"2026-10-03T19:34:59.989Z","rendered":[{"content":"<system-reminder>\nNote: /Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00/claude-mock/e2e/017_session_lifecycle/test_017_subagent_compaction_test.go changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\tpackage e2e\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t\n9\t\t\"github.com/stretchr/testify/assert\"\n10\t\t\"github.com/stretchr/testify/require\"\n11\t)\n12\t\n...\n14\t// subagents/agent-<id>.jsonl, under its own chain and sidechain flags, and the\n15\t// session's file holds no boundary (sub-agents doc, auto-compaction).\n16\t// sr:proves subagent-transcripts/claude\n17\tfunc TestT017_85_SubagentCompactionIsLoggedInItsOwnFile(t *testing.T) {\n18\t\tdir := t.TempDir()\n19\t\tcfg := filepath.Join(dir, \"config\")\n20\t\tsub := script(t, dir, \"sub\",\n21\t\t\ttoolUse(\"sb1\", \"Bash\", `{\"command\":\"true\"}`),\n22\t\t\t`{\"type\":\"compact\",\"summary\":\"sub summary @MARK@\",\"trigger\":\"auto\",\"pre_tokens\":9000,\"post_tokens\":900}`)\n23\t\torch := script(t, dir, \"orch\", toolUse(\"ag1\", \"Agent\", `{\"prompt\":\"work\",\"description\":\"compacter\",\"script\":\"`+sub+`\"}`))\n24\t\tout, code := runInDir(t, dir, nil, \"--script\", orch, \"--session-id\", \"subcmp-1\",\n25\t\t\t\"--project-dir\", dir, \"--config-dir\", cfg, \"-p\", \"hello\")\n26\t\trequire.Equal(t, 0, code, out)\n27\t\n28\t\tmain := transcriptPath(t, cfg, dir, \"subcmp-1\")\n29\t\tassert.NotContains(t, readString(t, main), \"compact_boundary\", \"the session's own file has no boundary\")\n30\t\tsides, err := filepath.Glob(filepath.Join(strings.TrimSuffix(main, \".jsonl\"), \"subagents\", \"agent-*.jsonl\"))\n31\t\trequire.NoError(t, err)\n32\t\trequire.Len(t, sides, 1)\n33\t\tagentID := strings.TrimSuffix(strings.TrimPrefix(filepath.Base(sides[0]), \"agent-\"), \".jsonl\")\n34\t\tboundaries := 0\n35\t\tfor _, r := range readRecs(t, sides[0]) {\n36\t\t\tif r.Subtype == \"compact_boundary\" {\n37\t\t\t\tboundaries++\n38\t\t\t\tvar full map[string]any\n39\t\t\t\trequire.NoError(t, json.Unmarshal([]byte(r.Raw), &full))\n40\t\t\t\tassert.Equal(t, \"system\", full[\"type\"])\n41\t\t\t\tmeta := full[\"compactMetadata\"].(map[string]any)\n42\t\t\t\tassert.Equal(t, \"auto\", meta[\"trigger\"])\n43\t\t\t\tassert.EqualValues(t, 9000, meta[\"preTokens\"])\n44\t\t\t\tassert.True(t, r.IsSidechain)\n45\t\t\t\tassert.Equal(t, agentID, r.AgentID)\n46\t\t\t\tassert.Equal(t, \"subcmp-1\", r.SessionID)\n47\t\t\t}\n48\t\t}\n49\t\tassert.Equal(t, 1, boundaries, \"the boundary is in the sub-agent's file\")\n50\t\tassert.Contains(t, readString(t, sides[0]), `\"isCompactSummary\":true`)\n51\t\tassert.NotContains(t, readString(t, main), \"sub summary\")\n</system-reminder>"}],"renderedRole":"