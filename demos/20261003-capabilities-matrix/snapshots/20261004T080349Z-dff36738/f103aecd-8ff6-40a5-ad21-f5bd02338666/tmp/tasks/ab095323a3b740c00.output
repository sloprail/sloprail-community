{"parentUuid":"a4c2880f-470b-4c33-999d-be9e2d9574f4","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ab095323a3b740c00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011MG5p9w8TosDCRjfozzZGB","type":"tool_result","content":"24\t\treturn\n25\t}\n26\t\n27\t// TestT017_78_ResumeByNameAsRecorded: a session that was given a name (by\n28\t// --name, which the mock does not model; the real harness records it as a\n29\t// custom-title and an agent-name record, as the resume-name run's transcript\n30\t// shows) is resumed by `--resume <name>`: the same session continues in its own\n31\t// file, and the resume's SessionStart and UserPromptSubmit carry session_title\n32\t// (its Stop and SessionEnd do not), which an unnamed session's resume never does.\n33\t// sr:proves session-resume/claude\n34\tfunc TestT017_78_ResumeByNameAsRecorded(t *testing.T) {\n35\t\traw, err := os.ReadFile(recordedFile(t, \"../../snapshots/runs/resume-name/samples/*/payloads.jsonl\"))\n36\t\trequire.NoError(t, err)\n37\t\tvar recordedPayloads []map[string]any\n38\t\tfor _, l := range strings.Split(string(raw), \"\\n\") {\n39\t\t\tvar p map[string]any\n40\t\t\tif json.Unmarshal([]byte(l), &p) == nil && p[\"hook_event_name\"] != nil {\n41\t\t\t\trecordedPayloads = append(recordedPayloads, p)\n42\t\t\t}\n43\t\t}\n44\t\trecEvents, recTitles := titlesOf(recordedPayloads, recordedPayloads[0][\"session_id\"].(string))\n45\t\twantEvents := []string{\"SessionStart\", \"UserPromptSubmit\", \"Stop\", \"SessionEnd\"}\n46\t\twantTitles := []string{\"earlier-by-name\", \"earlier-by-name\", \"\", \"\"}\n47\t\trequire.Equal(t, wantEvents, recEvents)\n48\t\trequire.Equal(t, wantTitles, recTitles, \"recorded: the title is on the resume's SessionStart and UserPromptSubmit only\")\n49\t\trealRecs := readRecs(t, recordedFile(t, \"../../snapshots/runs/resume-name/samples/*/transcript/*.jsonl\"))\n50\t\trequire.Contains(t, realRecs[0].Raw, `\"type\":\"custom-title\"`)\n51\t\trequire.Contains(t, realRecs[1].Raw, `\"type\":\"agent-name\"`)\n52\t\n53\t\tdir := t.TempDir()\n54\t\tcfg := filepath.Join(dir, \"config\")\n55\t\tlog := filepath.Join(dir, \"payloads.log\")\n56\t\th := payloadLogger(t, dir, \"log.sh\", log, \"\")\n57\t\tsettings(t, dir, map[string]string{\"SessionStart\": h, \"UserPromptSubmit\": h, \"Stop\": h, \"SessionEnd\": h})\n58\t\trun := func(args ...string) {\n59\t\t\tout, code := runInDir(t, dir, nil, append([]string{\"--script\", script(t, dir, \"s\"), \"--project-dir\", dir, \"--config-dir\", cfg, \"-p\", \"go\"}, args...)...)\n60\t\t\trequire.Equal(t, 0, code, out)\n61\t\t}\n62\t\trun(\"--session-id\", \"plain-1\")\n63\t\trun(\"--session-id\", \"named-1\")\n64\t\t// the records the real harness left in its named session, in the real order\n65\t\tnamed := transcriptPath(t, cfg, dir, \"named-1\")\n66\t\tbody, err := os.ReadFile(named)\n67\t\trequire.NoError(t, err)\n68\t\thead := `{\"type\":\"custom-title\",\"customTitle\":\"earlier-by-name\",\"sessionId\":\"named-1\"}` + \"\\n\" +\n69\t\t\t`{\"type\":\"agent-name\",\"agentName\":\"earlier-by-name\",\"sessionId\":\"named-1\"}` + \"\\n\"\n70\t\trequire.NoError(t, os.WriteFile(named, append([]byte(head), body...), 0o644))\n71\t\tbefore := len(payloads(t, log))\n72\t\trun(\"--resume\", \"earlier-by-name\")\n73\t\trun(\"--resume\", \"plain-1\")\n74\t\n75\t\tevents, titles := titlesOf(payloads(t, log)[before:], \"named-1\")\n76\t\tassert.Equal(t, wantEvents, events, \"the name finds the named session\")\n77\t\tassert.Equal(t, wantTitles, titles)\n78\t\t_, plainTitles := titlesOf(payloads(t, log), \"plain-1\")\n79\t\tassert.Equal(t, make([]string, len(plainTitles)), plainTitles, \"an unnamed session's hooks carry no title\")\n80\t\tfiles, err := filepath.Glob(filepath.Join(filepath.Dir(named), \"*.jsonl\"))\n81\t\trequire.NoError(t, err)\n82\t\tassert.Len(t, files, 2, \"resuming by name made no new transcript\")\n83\t}\n84\t"}]},"uuid":"1b7765e4-0feb-47a6-8caa-91b813724689","timestamp":"2026-10-03T19:29:59.813Z","sourceToolAssistantUUID":"a4c2880f-470b-4c33-999d-be9e2d9574f4","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab095323a3b740c00","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a122781128a284455"}
