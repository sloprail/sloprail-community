g limit reached (depth %d of %d). Complete this task directly using your tools instead of spawning another agent. If the user explicitly requested deeper nesting, ask them to raise CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH.\",\n\t\tcfg.spawnDepth, limit)}\n}\nEOF\npython3 - <<'EOF'\np='claude-mock/internal/runner/agent_prepare.go'\ns=open(p).read()\ns=s.replace('''\t\treturn nil, in, toolexec.Result{Output: \"Error: No such tool available: Agent\", IsError: true}\n\t}\n''','''\t\treturn nil, in, atSpawnLimit(cfg)\n\t}\n''')\ns=s.replace('''\tif subCwd != cfg.Cwd {\n\t\tmeta.WorktreePath''','''\tif agentType == forkAgentType {\n\t\tmeta.IsFork = true\n\t\tif meta.Model == \"\" {\n\t\t\tmeta.Model = \"inherit\"\n\t\t}\n\t}\n\tif subCwd != cfg.Cwd {\n\t\tmeta.WorktreePath''')\nopen(p,'w').write(s)\np='claude-mock/internal/runner/session_subagent.go'\ns=open(p).read()\ns=s.replace('''\tAgentType             string `json:\"agentType\"`\n''','''\tAgentType             string `json:\"agentType\"`\n\tIsFork                bool   `json:\"isFork,omitempty\"`\n''')\nopen(p,'w').write(s)\np='claude-mock/internal/runner/background_command.go'\ns=open(p).read()\ns=s.replace('''\tvar in struct {\n\t\tRunInBackground any `json:\"run_in_background\"`\n\t}\n\tif json.Unmarshal(input, &in) != nil {\n\t\treturn false\n\t}\n''','''\tvar in struct {\n\t\tRunInBackground any `json:\"run_in_background\"`\n\t}\n\tif json.Unmarshal(input, &in) != nil {\n\t\treturn false\n\t}\n\tif isForkInput(input) { // fork mode runs every sub-agent in the background\n\t\treturn true\n\t}\n''')\nopen(p,'w').write(s)\nEOF\ncd claude-mock && go build ./... && gofmt -l ."},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1417,"cache_read_input_tokens":200552,"output_tokens":1590,"output_tokens_details":{"thinking_tokens":117},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"serv