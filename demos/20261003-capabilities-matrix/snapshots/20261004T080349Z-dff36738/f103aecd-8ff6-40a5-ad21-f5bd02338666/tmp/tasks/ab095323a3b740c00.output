5:// sr:proves manual-compaction/claude\ntest_017_compaction_hooks_test.go:116:// sr:proves compaction-transcript-continuity/claude\ntest_017_compaction_hooks_test.go:117:func TestT017_07j_CompactionStreamsItsFrames(t *testing.T) {\ntest_017_compaction_hooks_test.go:195:// sr:proves manual-compaction/claude\ntest_017_compaction_hooks_test.go:196:func TestT017_07h_CompactHookMatchersSelectTheTrigger(t *testing.T) {\ntest_017_compaction_hooks_test.go:230:// sr:proves manual-compaction/claude\ntest_017_compaction_hooks_test.go:231:func TestT017_07k_CompactionWithoutHooksStreamsNoHookFrames(t *testing.T) {\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUseFailure\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$