{"parentUuid":"51273a36-e2ec-40db-9150-37d9e89f6b10","isSidechain":true,"promptId":"6b8557a2-9430-4f17-946a-1ea07dab5643","agentId":"ab2efb1b0554a0078","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013WJ8xUwZJtQWk6HUXhPUHV","type":"tool_result","content":"# Where files may land in harness-mocks. Everything not allowed here is refused\n# before the write, so new code maps to a declared place or the place is agreed\n# first (a change here is a change to the architecture: adr-grounded does not\n# cover this file, so pair it with an ADR change the user asked for).\n#\n# Names are kebab (specs, ADRs, runs) or Go-style lowercase (packages, files).\nallow:\n  # the rules, and what they are about\n  - glob: \".sloprail/**\"\n  - regex: '^adr/[a-z][a-z0-9]*(-[a-z0-9]+)*/ADR\\.md$'\n  - regex: '^spec/(invariants|capabilities)/[a-z][a-z0-9]*(-[a-z0-9]+)*\\.yaml$'\n\n  # the shared core: modules, each with its boundary\n  - regex: '^internal/[a-z0-9]+(/[a-z0-9]+)*/[a-z0-9_]+\\.go$'\n  - regex: '^internal/[a-z0-9]+(/[a-z0-9]+)*/(module\\.yaml|candidates\\.sh)$'\n\n  # a harness mock: entrypoint, adapter packages, e2e suites\n  - regex: '^[a-z0-9]+-mock/[a-z0-9_]+\\.go$'\n  - regex: '^[a-z0-9]+-mock/internal/[a-z0-9]+(/[a-z0-9]+)*/[a-z0-9_]+\\.go$'\n  - regex: '^[a-z0-9]+-mock/e2e/[0-9]{3}_[a-z0-9_]+/[a-z0-9_]+_test\\.go$'\n  - regex: '^[a-z0-9]+-mock/e2etest/[a-z0-9_]+\\.go$'\n  - regex: '^[a-z0-9]+-mock/Makefile$'\n\n  # snapshots: only what a person authors. Everything else under snapshots/ is\n  # written by capture.sh alone (gate snapshots-read-only).\n  - regex: '^[a-z0-9]+-mock/snapshots/capture\\.sh$'\n  - regex: '^[a-z0-9]+-mock/snapshots/runs/[a-z][a-z0-9]*(-[a-z0-9]+)*/setup/[^/]+$'\n\n  # repo tooling (e.g. tools/moveonly)\n  - regex: '^tools/[a-z0-9-]+(/[a-z0-9]+)*/[a-z0-9_]+\\.go$'\n\n  # the repository itself\n  - regex: '^(README|CONTRIBUTING|CLA)\\.md$'\n  - regex: '^(LICENSE|\\.gitignore|go\\.mod|go\\.sum)$'\n  - regex: '^\\.github/workflows/[a-z0-9-]+\\.yml$'\n  - regex: '^\\.claude/settings\\.json$'\n\n  # this proposal, until it is activated\n  - glob: \"proposals/**\"\n M codex-mock/snapshots/capture.sh","is_error":false}]},"uuid":"420c3f90-59e5-4dbd-821c-d099dcba561d","timestamp":"2026-10-03T14:50:29.021Z","sourceToolAssistantUUID":"51273a36-e2ec-40db-9150-37d9e89f6b10","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-adc1470310079e23b"}
