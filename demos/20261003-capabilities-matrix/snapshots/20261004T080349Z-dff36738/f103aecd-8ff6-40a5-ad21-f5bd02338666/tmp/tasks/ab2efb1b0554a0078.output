{"parentUuid":"c28b107e-c486-42db-9e4d-08ebbc3a2da9","isSidechain":true,"promptId":"6b8557a2-9430-4f17-946a-1ea07dab5643","agentId":"ab2efb1b0554a0078","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015BRbauzNHB4SKgkn29ALkp","type":"tool_result","content":"== runs/forkresume/setup/args\n--session-id\n00000000-0000-4000-8000-0000000000a1\n== runs/forkresume/setup/hook.sh\n#!/bin/sh\nIN=$(cat); printf '%s\\n' \"$IN\" >>\"$HOOK_LOG\"\n== runs/forkresume/setup/prompt.txt\nRun the Bash command: echo ORIGINAL . Then reply only OK.== runs/forkresume/setup/settings.json\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUseFailure\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"SubagentStart\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"SubagentStop\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"SessionEnd\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PreCompact\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostCompact\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$CLAUDE_PROJECT_DIR\\\"/hook.sh\"\n          }\n        ]\n      }\n    ]\n  }\n}\n== runs/forkresume/setup/then\ncat: runs/forkresume/setup/then: Is a directory\nSEAL\nevents.jsonl\nexit.txt\npayloads.jsonl\nstderr.txt\nstream.jsonl\ntranscript\n24:#   runs/<name>/setup/then/<NN>/       optional later steps, run in name order in the same\n55:  jq -c --arg sid \"${sid:-<none>}\" --arg pid \"${pid:-<none>}\" 'walk(if type == \"object\" then del(.transcript_path, .cwd, .agent_id,\n57:          elif type == \"string\" then gsub($sid; \"<SESSION_ID>\") | gsub(\"\\\\b\" + $pid + \"\\\\b\"; \"<PID>\") else . end)\n97:  # each runs/<name>/setup/then/<NN>/ is a later one, in name order, in the same\n102:  steps=(\"$run/setup\"); [ -d \"$run/setup/then\" ] && for d in \"$run/setup/then\"/*/; do steps+=(\"${d%/}\"); done\n110:    # then a project of its own: the hooks of the repo root are not loaded from below it\n145:  if grep -rhoE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[a-z]{2,}' \"$cap\" | grep -vxq 'noreply@anthropic.com'; then\n152:    if cmp -s \"$other/events.jsonl\" \"$cap/events.jsonl\"; then\n23:#   runs/<name>/setup/args             optional: extra claude flags, one per line\n24:#   runs/<name>/setup/then/<NN>/       optional later steps, run in name order in the same\n25:#                                      repo and HOME: prompt.txt, args, and `cwd` (a directory\n42:seal() { (cd \"$1\" && find . -type f ! -name 'SEAL*' | LC_ALL=C sort | xargs shasum -a 256 >SEAL.tmp && mv SEAL.tmp SEAL); }\n55:  jq -c --arg sid \"${sid:-<none>}\" --arg pid \"${pid:-<none>}\" 'walk(if type == \"object\" then del(.transcript_path, .cwd, .agent_id,\n57:          elif type == \"string\" then gsub($sid; \"<SESSION_ID>\") | gsub(\"\\\\b\" + $pid + \"\\\\b\"; \"<PID>\") else . end)\n97:  # each runs/<name>/setup/then/<NN>/ is a later one, in name order, in the same\n98:  # repo and under the same fake HOME, so a later step can resume or fork what\n99:  # an earlier one left (the scenario fixes the session ids in each step's args).\n102:  steps=(\"$run/setup\"); [ -d \"$run/setup/then\" ] && for d in \"$run/setup/then\"/*/; do steps+=(\"${d%/}\"); done\n104:    sargs=(); [ -f \"$step/args\" ] && while IFS= read -r a; do [ -n \"$a\" ] && sargs+=(\"$a\"); done <\"$step/args\"\n110:    # then a project of its own: the hooks of the repo root are not loaded from below it\n116:        ${sargs[@]+\"${sargs[@]}\"} \"$(cat \"$step/prompt.txt\")\" </dev/null >>\"$cap/stream.jsonl\" 2>>\"$cap/stderr.txt\")\n145:  if grep -rhoE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[a-z]{2,}' \"$cap\" | grep -vxq 'noreply@anthropic.com'; then\n152:    if cmp -s \"$other/events.jsonl\" \"$cap/events.jsonl\"; then\n#!/usr/bin/env bash\n# The ONLY writer of cursor-mock/snapshots/ (the snapshots-read-only gate\n# refuses every other write). Everything it writes is sealed; snapshots-current\n# refuses a snapshot whose seal does not match, so a hand edit is caught at the\n# commit even if it slipped past the gate.\n#\n#   capture.sh run <name>    run the scenario in runs/<name>/setup/ against the\n#                            real `cursor-agent`, and add a sample\n#   capture.sh doc <url>     freeze a doc page (e.g. https://cursor.com/docs/hooks):\n#                            its sha256 goes in the MANIFEST; its text only into a cache\n#                            under the git dir, never into the repo\n#   capture.sh drop <run> <ts>  remove one sample (a bad or non-hermetic capture)\n#   capture.sh all           re-capture every run and doc at the installed\n#                            cursor-agent's version, and set MANIFEST.version to it\n#\n# The version is cursor-agent's release date (`2026.09.28`): `--version` also\n# prints a build hash after it (`2026.09.28-64d2043`), which the schema's\n# version pattern does not take, so the hash is dropped.\n#\n# Login: cursor-agent has no environment-only login in this setup, so the fake\n# HOME links to the user's Keychains directory and nothing else (the same as\n# claude-mock's capture). No credential is copied into the fake HOME; the\n# email the login reports is nulled out of every payload before anything is\n# sealed. A CURSOR_API_KEY is never read or passed.\n#\n# A scenario is hand-authored, and only its setup/ is:\n#   runs/<name>/setup/prompt.txt       the prompt\n#   runs/<name>/setup/hooks.json       the project's .cursor/hooks.json\n#   runs/<name>/setup/*.sh             optional: the hook scripts, installed in .cursor/hooks/;\n#                                      hook.sh appends to $HOOK_LOG\n#   runs/<name>/setup/args             optional: extra cursor-agent flags, one per line\n#   runs/<name>/setup/env              optional: KEY=VALUE lines cursor-agent inherits on\n#                                      top of the hermetic env\nset -euo pipefail\nhere=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nmanifest=\"$here/MANIFEST.yaml\"\ndie() { echo \"capture.sh: $*\" >&2; exit 1; }\nversion() { yq -r '.version' \"$manifest\"; }\ninstalled() { cursor-agent --version | awk '{print $1}' | sed 's/-.*$//'; }\n# The first capture creates the MANIFEST, frozen at the installed version: it is","is_error":false}]},"uuid":"2dccefde-17b7-48f3-bf55-16845252e078","timestamp":"2026-10-03T14:49:17.866Z","sourceToolAssistantUUID":"c28b107e-c486-42db-9e4d-08ebbc3a2da9","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a4d84e01b97891e91"}
