orded in runs/session-fork)\n51\t\treturn s, nil\n52\t}\n53\t\n54\tfunc (s *File) append(kind string, payload map[string]any) {\n55\t\tenc := json.NewEncoder(s.f)\n56\t\tenc.SetEscapeHTML(false)\n57\t\t_ = enc.Encode(map[string]any{\"timestamp\": time.Now().UTC().Format(time.RFC3339Nano), \"type\": kind, \"payload\": payload})\n58\t}\n59\t\n60\tfunc message(role, ctype, text string) map[string]any {\n61\t\treturn map[string]any{\"type\": \"message\", \"role\": role,"}]},"uuid":"ba634fcd-c9dd-40df-b110-441ff5de0316","timestamp":"2026-10-03T16:55:30.491Z","sourceToolAssistantUUID":"7582953e-c0ef-4f72-9b6a-fcf30b7429d7","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
