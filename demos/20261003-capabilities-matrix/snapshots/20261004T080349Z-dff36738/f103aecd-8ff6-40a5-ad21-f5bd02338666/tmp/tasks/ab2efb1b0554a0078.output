 _, l := range orig.hookLog() {\n\t\tif l[\"hook_event_name\"] == \"SessionStart\" {\n\t\t\tgot = append(got, l[\"source\"].(string))\n\t\t\tif l[\"source\"] == \"fork\" {\n\t\t\t\tassert.Equal(t, forkID, l[\"session_id\"])\n\t\t\t}\n\t\t}\n\t}\n\tassert.Equal(t, []string{\"startup\", \"fork\"}, got)\n}\n'''\nopen(p,'w').write(s)\nEOF"}},"wireIngestContext":{"toolu_017Zw8t4zWmKekKKVUEd9TzR":{"cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078"}},"apiBlockIndex":1,"requestId":"req_011CffZSaAz55QqmbLCehBAh","attributionAgent":"general-purpose","type":"assistant","uuid":"4a6337de-02f3-4fb8-908c-86106a3b03a3","timestamp":"2026-10-03T15:43:32.197Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a7e54ea3099505a7e"}
