tcmd.Dir = r.Repo\n\tcmd.Env = append(append(os.Environ(), withCalls(t)...), \"CODEX_HOME=\""},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1434,"cache_read_input_tokens":202370,"cache_creation":{"ephemeral_5m_input_tokens":1434,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01TtQzJwQnpNhSf5ENghEJnB":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078/codex-mock/e2e/001_hooks/session_fork_test.go","old_string":"// answerFromHistory is a script that answers with the word the earlier shell\n// command printed, read from the history the session file holds: the fork has\n// it, a session of its own has none.\nconst answerFromHistory = `#!/bin/sh\nw=$(grep -h function_call_output \"$A10N_MOCK_SESSION_FILE\" | grep -o ORIGINAL | head -n1)\nprintf '%s\\n' '{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"'\"$w\"'\"}]}}' '{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"'\"$w\"'\"}'\n`\n\n// execFork runs `exec fork <from> <prompt>` in the repository and CODEX_HOME of r.\nfunc execFork(t *testing.T, r result, from, prompt string) result {\n\tt.Helper()\n\tscript := filepath.Join(t.TempDir(), \"scenario.sh\")\n\trequire.NoError(t, os.WriteFile(script, []byte(answerFromHistory), 0o755))\n\tcmd := exec.Command(mockBinary, \"exec\", \"fork\", \"--json\", \"--skip-git-repo-check\", \"--script\", script, \"-m\", \"mock-model\", from, prompt)\n\tcmd.Dir = r.Repo\n\tcmd.Env = append(os.Environ(), \"CODEX_HOME=\"","new_string":"// execFork runs `exec fork <from> <prompt>` in the repository and CODEX_HOME of r.\nfunc execFork(t *testing.T, r result, from, prompt string) result {\n\tt.Helper()\n\tscript := filepath.Join(t.TempDir(), \"scenario.sh\")\n\