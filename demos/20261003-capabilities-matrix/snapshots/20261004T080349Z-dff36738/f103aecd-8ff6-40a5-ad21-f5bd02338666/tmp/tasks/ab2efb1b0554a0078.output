{"parentUuid":"4fe5fd66-f788-490b-93d0-75a97b2a9eca","isSidechain":true,"promptId":"9af44ced-bc96-4c0c-851c-b7a4d67027a3","agentId":"ab2efb1b0554a0078","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WqrtHPSpo1Zbc6SwzrWWpp","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport \"time\"\n4\t\n5\t// ResumeStats is what a resumed session's start hook is told of the resume: how\n6\t// long it has been since the last response, how many tokens the first request\n7\t// re-sends, whether the prompt cache is likely gone, and what writing the context\n8\t// into it again is estimated to cost.\n9\ttype ResumeStats struct {\n10\t\tSecondsSinceLastResponse int\n11\t\tContextTokens            int\n12\t\tCacheLikelyExpired       bool\n13\t\tEstimatedCacheWriteUSD   float64\n14\t}\n15\t\n16\t// Stats is the stats of resuming at now a session whose last response was at\n17\t// lastResponse (the zero time when it has none): the cache is likely gone when\n18\t// the last response is older than cacheLifetime, and a rewrite of contextTokens\n19\t// costs usdPerMillionTokens per million of them, rounded to a hundredth of a cent.\n20\tfunc Stats(lastResponse, now time.Time, cacheLifetime time.Duration, contextTokens int, usdPerMillionTokens float64) ResumeStats {\n21\t\tvar since time.Duration\n22\t\tif !lastResponse.IsZero() {\n23\t\t\tsince = max(now.Sub(lastResponse), 0)\n24\t\t}\n25\t\tusd := float64(contextTokens) * usdPerMillionTokens / 1e6\n26\t\treturn ResumeStats{\n27\t\t\tSecondsSinceLastResponse: int(since.Round(time.Second) / time.Second),\n28\t\t\tContextTokens:            contextTokens,\n29\t\t\tCacheLikelyExpired:       !lastResponse.IsZero() && since > cacheLifetime,\n30\t\t\tEstimatedCacheWriteUSD:   float64(int(usd*10000+0.5)) / 10000,\n31\t\t}\n32\t}\n33\t"}]},"uuid":"e0274a2c-60a2-4095-b046-2b1eb285a3b8","timestamp":"2026-10-03T14:55:56.305Z","sourceToolAssistantUUID":"4fe5fd66-f788-490b-93d0-75a97b2a9eca","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
