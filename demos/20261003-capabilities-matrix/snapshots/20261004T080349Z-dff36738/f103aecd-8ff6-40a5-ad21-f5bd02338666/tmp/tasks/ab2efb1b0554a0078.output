(t, \"session-fork\")\n\trecIDs := threadIDs(result{Stdout: readFile(t, filepath.Join(rec.sample, \"stream.jsonl\"))})\n\tvar want []string\n\tfor _, l := range jsonLines(readFile(t, filepath.Join(rec.sample, \"payloads.jsonl\"))) {\n\t\tif l[\"hook_event_name\"] == \"SessionStart\" {\n\t\t\twant = append(want, l[\"source\"].(string))\n\t\t}\n\t}\n\trequire.Equal(t, []string{\"startup\", \"fork\", \"resume\"}, want)\n\trequire.Len(t, recIDs, 3)\n\n\torig := execMock(t, scenario{\n\t\tHooksJSON: readFile(t, filepath.Join(rec.setup, \"hooks.json\")),\n\t\tFiles:     map[string]string{\"hook.sh\": readFile(t, filepath.Join(rec.setup, \"hook.sh\"))},\n\t\tScript:    callThenResult, Prompt: \"go\", Env: withCalls(t),\n\t})\n\torigID := threadIDs(orig)[0]\n\tfork := execFork(t, orig, origID, \"again\")\n\tforkID := threadIDs(fork)[0]\n\tvar got []string\n\tfor _, l := range orig.hookLog() {\n\t\tif l[\"hook_event_name\"] == \"SessionStart\" {\n\t\t\tgot = append(got, l[\"source\"].(string))\n\t\t\tif l[\"source\"] == \"fork\" {\n\t\t\t\tassert.Equal(t, forkID, l[\"session_id\"])\n\t\t\t}\n\t\t}\n\t}\n\tassert.Equal(t, []string{\"startup\", \"fork\"}, got)\n}\n'''\nopen(p,'w').write(s)\nEOF\ngofmt -l .; go vet ./codex-mock/... && go test -count=1 ./codex-mock/e2e/... -run 'Fork' 2>&1 | tail -20","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2081,"cache_read_input_tokens":197079,"output_tokens":1540,"output_tokens_details":{"thinking_tokens":112},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2081},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1540,"cache_read_input_tokens":197079,"cache_creation_input_tokens":2081,"cache_creation":{"ephemeral_5m_input_tokens":2081,"ephemeral_1h_inpu