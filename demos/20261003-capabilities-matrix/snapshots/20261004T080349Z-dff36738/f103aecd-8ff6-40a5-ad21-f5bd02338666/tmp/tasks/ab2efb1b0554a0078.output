\"mock-context\")\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn nil, err\n\t}\n\tview, err := os.Create(filepath.Join(dir, id+\".jsonl\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif _, err := view.Write(base.Through(data)); err != nil {\n\t\treturn nil, err\n\t}\n\ts.view = view\n\treturn s, nil\n}\n\n// Find is the rollout of session id under home, \"\" when there is none.\nfunc Find(home, id string) string {\n\tif id == \"\" || strings.ContainsAny(id, `/\\*?[`) {\n\t\treturn \"\"\n\t}\n\tpaths, _ := filepath.Glob(filepath.Join(home, \"sessions\", \"*\", \"*\", \"*\", \"rollout-*-\"+id+\".jsonl\"))\n\tif len(paths) == 0 {\n\t\treturn \"\"\n\t}\n\treturn paths[len(paths)-1]\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2037,"cache_read_input_tokens":145336,"output_tokens":1190,"output_tokens_details":{"thinking_tokens":166},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2037},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1190,"cache_read_input_tokens":145336,"cache_creation_input_tokens":2037,"cache_creation":{"ephemeral_5m_input_tokens":2037,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01F9sJdwMmXj2hYVimZjuZBL":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078/codex-mock/internal/session/fork.go","content":"package session\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\tcoresession \"github.com/sloprail/harness-mocks/internal/session\"\n)\n\n// Fork starts the rollout of session id as a fork of session from, what\n// `codex exec fork <from>` leaves (recorde