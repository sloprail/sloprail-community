{"parentUuid":"fa65e344-b7ec-494b-b42a-8bfb293655e9","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ab2efb1b0554a0078","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011UfLxNeyrcbHcXkNiEmnrg","type":"tool_result","content":"diff --git a/codex-mock/internal/runner/run.go b/codex-mock/internal/runner/run.go\nindex 7857dafb..49c97d39 100644\n--- a/codex-mock/internal/runner/run.go\n+++ b/codex-mock/internal/runner/run.go\n@@ -28,6 +28,8 @@ type Config struct {\n \t// CodexHome holds the user's hooks.json and the session's rollout.\n \tCodexHome string\n \tModel     string\n+\t// ForkFrom is the id of the session `exec fork` continues in a new one.\n+\tForkFrom string\n \t// Environ is the environment the mock was started with.\n \tEnviron []string\n \t// JSON prints the event stream on Stdout; otherwise Stdout gets the\n@@ -66,7 +68,14 @@ func Run(ctx context.Context, cfg Config) error {\n \t\treturn fmt.Errorf(\"codex-mock: cannot load hooks: %w\", err)\n \t}\n \tid := coresession.NewID()\n-\trollout, err := session.Create(cfg.CodexHome, id, cfg.Cwd, time.Now())\n+\tsource := \"startup\"\n+\tvar rollout *session.File\n+\tif cfg.ForkFrom != \"\" {\n+\t\tsource = \"fork\"\n+\t\trollout, err = session.Fork(cfg.CodexHome, cfg.ForkFrom, id, cfg.Cwd, time.Now())\n+\t} else {\n+\t\trollout, err = session.Create(cfg.CodexHome, id, cfg.Cwd, time.Now())\n+\t}\n \tif err != nil {\n \t\treturn fmt.Errorf(\"codex-mock: cannot create the session file: %w\", err)\n \t}\n@@ -94,7 +103,7 @@ func Run(ctx context.Context, cfg Config) error {\n \t\ts.events.Warning(\"running async SessionEnd hook synchronously in \" + f)\n \t}\n \thalted := false\n-\tfor _, o := range s.hooks.Fire(ctx, hooks.SessionStart, \"startup\", map[string]any{\"source\": \"startup\"}) {\n+\tfor _, o := range s.hooks.Fire(ctx, hooks.SessionStart, source, map[string]any{\"source\": source}) {\n \t\td := hooks.Interpret(hooks.SessionStart, o)\n \t\thalted = halted || d.Halt\n \t\tif d.Context != \"\" {\n\tcorehooks \"github.com/sloprail/harness-mocks/internal/hooks\"\n\tcoresession \"github.com/sloprail/harness-mocks/internal/session\"\n\t\"github.com/sloprail/harness-mocks/internal/tasks\"\n\t\"github.com/sloprail/harness-mocks/internal/turnloop\"\n)\n\n// Config is everything a run is told, read once at the entrypoint.\ntype Config struct {\n\t// Script is the scenario script that drives the agent.\n\tScript string\n\tPrompt string\n\t// Cwd is the session's working directory.\n\tCwd string\n\t// CodexHome holds the user's hooks.json and the session's rollout.\n\tCodexHome string\n\tModel     string\n\t// ForkFrom is the id of the session `exec fork` continues in a new one.\n\tForkFrom string\n\t// Environ is the environment the mock was started with.\n\tEnviron []string\n\t// JSON prints the event stream on Stdout; otherwise Stdout gets the\n\t// agent's final message.\n\tJSON bool\n\t// BypassHookTrust is --dangerously-bypass-hook-trust: hooks run without\n\t// review, and Codex warns of it.\n\tBypassHookTrust bool\n\tStdout, Stderr  io.Writer\n}\n\n// state is the state of one run, shared by Codex's side of the turn and of\n// its tool calls.\ntype state struct {\n\tcfg     Config\n\tid      string\n\tturnID  string\n\thooks   *hooks.Invoker\nagent_host.go\nagent_stop.go\nagent_tool.go\nbackground.go\ncontrol_compact.go\npatch_tool.go\nrun.go\nspawn_background.go\nspawn_depth.go\nspawn_subhost.go\ntool_host.go\nturn_host.go","is_error":false}]},"uuid":"cf8ffa81-6447-4607-84e9-195e30c895b8","timestamp":"2026-10-03T19:14:34.562Z","sourceToolAssistantUUID":"fa65e344-b7ec-494b-b42a-8bfb293655e9","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ab2efb1b0554a0078","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-abb30e7cdc8998b15"}
