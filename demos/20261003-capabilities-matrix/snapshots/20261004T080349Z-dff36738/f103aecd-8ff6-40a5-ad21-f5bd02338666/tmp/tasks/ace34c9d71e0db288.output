{"parentUuid":"af69c597-295b-423a-b01d-09014f9be7a6","isSidechain":true,"promptId":"6b8557a2-9430-4f17-946a-1ea07dab5643","agentId":"ace34c9d71e0db288","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H52Lezi45D5hvLB86wPmhw","type":"tool_result","content":"#!/bin/sh\n# Every event logs its payload. PreToolUse refuses DENYME by JSON and EXIT2ME\n# by exit 2; Stop blocks by JSON, then by exit 2, then lets the turn end.\nIN=$(cat)\nprintf '%s\\n' \"$IN\" >>\"$HOOK_LOG\"\nEV=$(printf '%s' \"$IN\" | jq -r '.hook_event_name')\ncase \"$EV\" in\n  SessionStart) echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"SS-CTX\"}}' ;;\n  PreToolUse)\n    if printf '%s' \"$IN\" | grep -q DENYME; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"DENY-REASON\"}}'; fi\n    if printf '%s' \"$IN\" | grep -q EXIT2ME; then echo \"PRE-BLOCK-MSG\" >&2; exit 2; fi ;;\n  Stop)\n    N=$(cat \"$TMPDIR/stopn\" 2>/dev/null || echo 0); N=$((N + 1)); echo $N >\"$TMPDIR/stopn\"\n    if [ $N = 1 ]; then echo '{\"decision\":\"block\",\"reason\":\"BLOCK-JSON-REASON\"}'; exit 0; fi\n    if [ $N = 2 ]; then echo \"BLOCK-EXIT2-REASON\" >&2; exit 2; fi ;;\nesac\nexit 0\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ]\n  }\n}\nMake every shell command its own separate tool call, never combined with another command or put in a script. Step 1: run the shell command: echo DENYME . Step 2: whatever happens, run the shell command: echo EXIT2ME . Step 3: run the shell command: echo FINE . Then reply only DONE. If you are told to continue after that, just reply DONE2.\nSEAL\nevents.jsonl\nexit.txt\npayloads.jsonl\nstderr.txt\nstream.jsonl\ntranscript\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"SessionStart\",\"model\":\"gpt-5.6-luna\",\"permission_mode\":\"bypassPermissions\",\"source\":\"\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"UserPromptSubmit\",\"model\":\"gpt-5.6-l\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"PreToolUse\",\"model\":\"gpt-5.6-luna\",\"\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"PreToolUse\",\"model\":\"gpt-5.6-luna\",\"\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"PreToolUse\",\"model\":\"gpt-5.6-luna\",\"\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"PostToolUse\",\"model\":\"gpt-5.6-luna\",\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"Stop\",\"model\":\"gpt-5.6-luna\",\"permis\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"Stop\",\"model\":\"gpt-5.6-luna\",\"permis\n{\"session_id\":\"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\",\"turn_id\":\"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\",\"transcript_path\":\"<TMP>/home/.codex/sessions/2026/10/01/rollout-2026-10-01T14-43-20-01a0f77d-9eb6-75e2-bc4b-3d7c801284ba.jsonl\",\"cwd\":\"<RUN>\",\"hook_event_name\":\"Stop\",\"model\":\"gpt-5.6-luna\",\"permis\nspec/capabilities/background-bash.yaml\nspec/capabilities/bash-tool-result.yaml\nspec/capabilities/hook-additional-context.yaml\nspec/capabilities/hook-common-payload.yaml\nspec/capabilities/hook-matcher-filter.yaml\nspec/capabilities/hook-command-handler.yaml\nspec/capabilities/hook-exit-code-semantics.yaml\nspec/capabilities/hook-output-transcript-records.yaml\nspec/capabilities/nested-subagents.yaml\nspec/capabilities/manual-compaction.yaml\nspec/capabilities/pretooluse-refusal.yaml\nspec/capabilities/noninteractive-run.yaml\nspec/capabilities/posttooluse-payload.yaml\nspec/capabilities/session-transcript-file.yaml\nspec/capabilities/session-start-hook.yaml\nspec/capabilities/stop-block-cap.yaml\nspec/capabilities/subagent-lifecycle-hooks.yaml\nspec/capabilities/stop-hook-payload.yaml\nspec/capabilities/stop-block-continuation.yaml\nspec/capabilities/subagent-stop-block-loop.yaml\nspec/capabilities/tool-failure-hook.yaml\n(eval):1: no matches found: --include=*.go\n#!/usr/bin/env bash\n# The ONLY writer of cursor-mock/snapshots/ (the snapshots-read-only gate\n# refuses every other write). Everything it writes is sealed; snapshots-current\n# refuses a snapshot whose seal does not match, so a hand edit is caught at the\n# commit even if it slipped past the gate.\n#\n#   capture.sh run <name>    run the scenario in runs/<name>/setup/ against the\n#                            real `cursor-agent`, and add a sample\n#   capture.sh doc <url>     freeze a doc page (e.g. https://cursor.com/docs/hooks):\n#                            its sha256 goes in the MANIFEST; its text only into a cache\n#                            under the git dir, never into the repo\n#   capture.sh drop <run> <ts>  remove one sample (a bad or non-hermetic capture)\n#   capture.sh all           re-capture every run and doc at the installed\n#                            cursor-agent's version, and set MANIFEST.version to it\n#\n# The version is cursor-agent's release date (`2026.09.28`): `--version` also\n# prints a build hash after it (`2026.09.28-64d2043`), which the schema's\n# version pattern does not take, so the hash is dropped.\n#\n# Login: cursor-agent has no environment-only login in this setup, so the fake\n# HOME links to the user's Keychains directory and nothing else (the same as\n# claude-mock's capture). No credential is copied into the fake HOME; the\n# email the login reports is nulled out of every payload before anything is\n# sealed. A CURSOR_API_KEY is never read or passed.\n#\n# A scenario is hand-authored, and only its setup/ is:\n#   runs/<name>/setup/prompt.txt       the prompt\n#   runs/<name>/setup/hooks.json       the project's .cursor/hooks.json\n#   runs/<name>/setup/*.sh             optional: the hook scripts, installed in .cursor/hooks/;\n#                                      hook.sh appends to $HOOK_LOG\n#   runs/<name>/setup/args             optional: extra cursor-agent flags, one per line\n#   runs/<name>/setup/env              optional: KEY=VALUE lines cursor-agent inherits on\n#                                      top of the hermetic env\nset -euo pipefail\nhere=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nmanifest=\"$here/MANIFEST.yaml\"\ndie() { echo \"capture.sh: $*\" >&2; exit 1; }\nversion() { yq -r '.version' \"$manifest\"; }\ninstalled() { cursor-agent --version | awk '{print $1}' | sed 's/-.*$//'; }\n# The first capture creates the MANIFEST, frozen at the installed version: it is\n# a snapshot file too, so nothing else may write it.\n[ -f \"$manifest\" ] || printf 'version: \"%s\"\\n' \"$(installed)\" >\"$manifest\"\n\n# seal DIR — SEAL lists the sha256 of every other file under DIR.\n# Written to SEAL.tmp and renamed only on success, so a SEAL always means a\n# complete sample (the cleanup trap relies on it).\nseal() { (cd \"$1\" && find . -type f ! -name 'SEAL*' | LC_ALL=C sort | xargs shasum -a 256 >SEAL.tmp && mv SEAL.tmp SEAL); }\n\n# normalize — hook payloads and stream frames into events.jsonl: what a\n# scenario did, without what differs between two captures of the same","is_error":false}]},"uuid":"2b322e08-e6f0-4f7f-a921-f78d71cf8e3c","timestamp":"2026-10-03T14:49:20.254Z","sourceToolAssistantUUID":"af