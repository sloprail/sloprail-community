ype":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ace34c9d71e0db288","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a4d84e01b97891e91"}
{"parentUuid":"7bb8cceb-7c66-435c-890b-bdb927102b2b","isSidechain":true,"promptId":"6b8557a2-9430-4f17-946a-1ea07dab5643","agentId":"ace34c9d71e0db288","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T7Xs5iW66WAxZumEH3Ane1","type":"tool_result","content":"#!/bin/sh\n# One hook for every event; each call exits with the status its command asks\n# for, and the payload and that status are logged.\n#   EXIT2ME  beforeShellExecution exits 2 (stderr says why)\n#   EXIT1ME  beforeShellExecution exits 1; EXIT3ME exits 3\n#   BADJSON  beforeShellExecution prints text that is not JSON and exits 0\n#   AFTER2ME afterShellExecution exits 2\nIN=$(cat)\nprintf '%s\\n' \"$IN\" >>\"$HOOK_LOG\"\nEV=$(printf '%s' \"$IN\" | jq -r '.hook_event_name')\ncode=0\ncase \"$EV\" in\n  beforeShellExecution)\n    if printf '%s' \"$IN\" | grep -q EXIT2ME; then echo \"SHELL-BLOCK-MSG\" >&2; code=2; fi\n    if printf '%s' \"$IN\" | grep -q EXIT1ME; then echo \"SHELL-EXIT1-MSG\" >&2; code=1; fi\n    if printf '%s' \"$IN\" | grep -q EXIT3ME; then echo \"SHELL-EXIT3-MSG\" >&2; code=3; fi\n    if printf '%s' \"$IN\" | grep -q BADJSON; then echo \"this is not json\"; fi ;;\n  afterShellExecution)\n    if printf '%s' \"$IN\" | grep -q AFTER2ME; then echo \"AFTER-EXIT2-MSG\" >&2; code=2; fi ;;\nesac\nprintf '{\"hook_result\":{\"event\":\"%s\",\"exit\":%s}}\\n' \"$EV\" \"$code\" >>\"$HOOK_LOG\"\nexit $code\n{\n  \"version\": 1,\n  \"hooks\": {\n    \"sessionStart\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"sessionEnd\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"preToolUse\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"postToolUse\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"postToolUseFailure\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"subagentStart\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"subagentStop\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"beforeShellExecution\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"afterShellExecution\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"beforeMCPExecution\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"afterMCPExecution\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"beforeReadFile\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"afterFileEdit\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"beforeSubmitPrompt\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"preCompact\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"stop\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"afterAgentResponse\": [{ \"command\": \".cursor/hooks/hook.sh\" }],\n    \"afterAgentThought\": [{ \"command\": \".cursor/hooks/hook.sh\" }]\n  }\n}\nDo these as separate shell tool calls, one command per call, in order, whatever happens: 1) echo EXIT2ME 2) echo EXIT1ME 3) echo EXIT3ME 4) echo BADJSON 5) echo AFTER2ME 6) echo FINE. If a call is refused, do not retry it or look for a workaround; go on to the next. Then reply only DONE.\nUsage: agent [options] [command] [prompt...]\n\nStart the Cursor Agent\n\nArguments:\n  prompt                       Initial prompt for the agent\n\nOptions:\n  -v, --version                Output the version number\n  --api-key <key>              API key for authentication (can also use\n                               CURSOR_API_KEY env var)\n  -H, --header <header>        Add custom header to agent requests (format:\n                               'Name: Value', can be used multiple times)\n  -e, --endpoint <url>         Target API endpoint URL (can also use\n                               CURSOR_API_ENDPOINT env var) (default:\n                               \"https://api2.cursor.sh\", env:\n                               CURSOR_API_ENDPOINT)\n  -p, --print                  Print responses to console (for scripts or\n                               non-interactive use). Has access to all tools,\n                               including write and shell. (default: false)\n  --output-format <format>     Output format (only works with --print): text |\n                               json | stream-json (default: \"text\")\n  --stream-partial-output      Stream partial output as individual text deltas\n                               (only works with --print and stream-json format)\n                               (default: false)\n  --mode <mode>                Start in the given execution mode. plan:\n                               read-only/planning (analyze, propose plans, no\n                               edits). ask: Q&A style for explanations and\n                               questions (read-only). (choices: \"plan\", \"ask\")\n  --plan                       Start in plan mode (shorthand for --mode=plan).\n                               (default: false)\n  --resume [chatId]            Select a session to resume (default: false)\n  --continue                   Continue previous session (default: false)\n  --model <model>              Model to use (e.g., gpt-5, sonnet-4-thinking).\n                               Parameterized models accept quoted bracket\n                               overrides, e.g.\n                               'claude-opus-4-8[context=1m,effort=high,fast=false]'\n  --list-models                List available models and exit (default: false)\n  -f, --force                  Force allow commands unless explicitly denied\n                               (default: false)\n  --yolo                       Alias for --force (Run Everything) (default:\n                               false)\n  --auto-review                Use Auto-review (Smart Auto): a server classifier\n                               auto-runs safe tool calls and prompts for the\n                               rest (default: false)\n  --sandbox <mode>             Explicitly enable or disable sandbox mode\n                               (overrides config) (choices: \"enabled\",\n                               \"disabled\")\n  --approve-mcps               Automatically approve all MCP servers (default:\n                               false)","is_error":false}]},"uuid":"acbea341-6cc2-40b3-9af9-d4209c482175","timestamp":"2026-10-03T14:49:26.813Z","sourceToolAssistantUUID":"7bb8cceb-7c66-435c-890b-bdb927102b2b","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ace34c9d71e0db288","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a4d84e01b97891e91"}
