{"parentUuid":"110265ef-80eb-4981-8c5a-253e05c5e587","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a1623904b5d23ad05","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01458sHModUiPLDHaFM2h6cN","type":"tool_result","content":"{\n  \"version\": 1,\n  \"hooks\": {\n    \"sessionStart\": [{ \"command\": \".cursor/hooks/ran.sh nomatch-session-start\", \"matcher\": \"zzz-never\" }],\n    \"preToolUse\": [\n      { \"command\": \".cursor/hooks/ran.sh pre-Shell\", \"matcher\": \"Shell\" },\n      { \"command\": \".cursor/hooks/ran.sh pre-Read\", \"matcher\": \"Read\" },\n      { \"command\": \".cursor/hooks/ran.sh pre-Write\", \"matcher\": \"Write\" },\n      { \"command\": \".cursor/hooks/ran.sh pre-regex\", \"matcher\": \"Sh.*|Rea\" },\n      { \"command\": \".cursor/hooks/ran.sh pre-star\", \"matcher\": \"*\" },\n      { \"command\": \".cursor/hooks/ran.sh pre-none\" }\n    ],\n    \"beforeShellExecution\": [\n      { \"command\": \".cursor/hooks/ran.sh shell-MATCH\", \"matcher\": \"echo MATCH\" },\n      { \"command\": \".cursor/hooks/ran.sh shell-OTHER\", \"matcher\": \"nomatch\" }\n    ],\n    \"postToolUse\": [{ \"command\": \".cursor/hooks/ran.sh post-Shell\", \"matcher\": \"Shell\" }, { \"command\": \".cursor/hooks/ran.sh post-Read\", \"matcher\": \"Read\" }],\n    \"afterFileEdit\": [{ \"command\": \".cursor/hooks/ran.sh edit-Write\", \"matcher\": \"Write\" }, { \"command\": \".cursor/hooks/ran.sh edit-Shell\", \"matcher\": \"Shell\" }]\n  }\n}\ncursor-mock/snapshots/runs/hook-matchers/setup/hooks.json\ncursor-mock/snapshots/runs/hook-matchers/setup/prompt.txt\ncursor-mock/snapshots/runs/hook-matchers/setup/ran.sh\n\ncursor-mock/snapshots/runs/hook-matchers/setup:\nhooks.json\nprompt.txt\nran.sh\nversion: 2026.09.28\ncommand: cursor-agent -p --force --trust --model auto --output-format stream-json\n#!/usr/bin/env bash\n# The ONLY writer of cursor-mock/snapshots/ (the snapshots-read-only gate\n# refuses every other write). Everything it writes is sealed; snapshots-current\n# refuses a snapshot whose seal does not match, so a hand edit is caught at the\n# commit even if it slipped past the gate.\n#\n#   capture.sh run <name>    run the scenario in runs/<name>/setup/ against the\n#                            real `cursor-agent`, and add a sample\n#   capture.sh doc <url>     freeze a doc page (e.g. https://cursor.com/docs/hooks):\n#                            its sha256 goes in the MANIFEST; its text only into a cache\n#                            under the git dir, never into the repo\n#   capture.sh drop <run> <ts>  remove one sample (a bad or non-hermetic capture)\n#   capture.sh all           re-capture every run and doc at the installed\n#                            cursor-agent's version, and set MANIFEST.version to it\n#\n# The version is cursor-agent's release date (`2026.09.28`): `--version` also\n# prints a build hash after it (`2026.09.28-64d2043`), which the schema's\n# version pattern does not take, so the hash is dropped.\n#\n# Login: cursor-agent has no environment-only login in this setup, so the fake\n# HOME links to the user's Keychains directory and nothing else (the same as\n# claude-mock's capture). No credential is copied into the fake HOME; the\n# email the login reports is nulled out of every payload before anything is\n# sealed. A CURSOR_API_KEY is never read or passed.\n#\n# A scenario is hand-authored, and only its setup/ is:\n#   runs/<name>/setup/prompt.txt       the prompt\n#   runs/<name>/setup/hooks.json       the project's .cursor/hooks.json\n#   runs/<name>/setup/*.sh             optional: the hook scripts, installed in .cursor/hooks/;\n#                                      hook.sh appends to $HOOK_LOG\n#   runs/<name>/setup/args             optional: extra cursor-agent flags, one per line\n#   runs/<name>/setup/env              optional: KEY=VALUE lines cursor-agent inherits on\n#                                      top of the hermetic env\nset -euo pipefail\nhere=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nmanifest=\"$here/MANIFEST.yaml\"\ndie() { echo \"capture.sh: $*\" >&2; exit 1; }\nversion() { yq -r '.version' \"$manifest\"; }\ninstalled() { cursor-agent --version | awk '{print $1}' | sed 's/-.*$//'; }\n# The first capture creates the MANIFEST, frozen at the installed version: it is","is_error":false}]},"uuid":"a72664b7-c641-44dd-b9d4-e2038385ce41","timestamp":"2026-10-03T15:17:16.853Z","sourceToolAssistantUUID":"110265ef-80eb-4981-8c5a-253e05c5e587","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a1623904b5d23ad05","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a7e54ea3099505a7e"}
