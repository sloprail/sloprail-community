go\", \"codex-mock/internal/runner/tool_host.go\", \"cursor-mock/internal/runner/toolhost.go\", \"cursor-mock/internal/runner/toolcall_frames.go\"]   # everything about the concern lives here\ninternal/session/module.yaml:4:home: [\"internal/session/**\", \"claude-mock/internal/runner/session_append.go\", \"claude-mock/internal/runner/session_fork.go\", \"claude-mock/internal/runner/session_paths.go\", \"claude-mock/internal/runner/session_resume.go\", \"claude-mock/internal/runner/session_seed.go\", \"claude-mock/internal/runner/session_test.go\", \"claude-mock/internal/runner/fork_test.go\", \"claude-\ninternal/session/module.yaml:5:api: [\"internal/session\", \"codex-mock/internal/session\"]       # the only packages others may import\n# A module is an area of code with a boundary; its decisions live here, not in an ADR.\n# Its core is internal/scenario (record type, the run's one result); claude-mock's adapter lives in the claude-mock files below.\nconcern: \"driving the scenario script and routing its records\"\nhome: [\"internal/scenario/**\", \"claude-mock/internal/runner/runner.go\", \"claude-mock/internal/runner/runner_print.go\", \"claude-mock/internal/runner/config.go\", \"claude-mock/internal/runner/record*.go\", \"claude-mock/internal/runner/stream_scan.go\", \"claude-mock/main.go\", \"claude-mock/run.go\", \"claude-mock/run_flags.go\", \"claude-mock/e2etest/**\", \"codex-mock/main.go\", \"codex-mock/exec.go\", \"codex-mock/internal/runner/run.go\", \"codex-mock/internal/events/**\", \"cursor-mock/main.go\", \"cursor-mock/root.go\", \"cursor-mock/run.go\", \"cursor-mock/internal/runner/config.go\", \"cursor-mock/internal/runner/frames.go\"]   # everything about the concern lives here\napi: [\"internal/scenario\", \"codex-mock/internal/events\"]       # the only packages others may import\n// Package scenario runs the script that drives a mock: once per turn, it\n// prints stream-json lines that say what the agent does.\npackage scenario\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\n\t\"github.com/sloprail/harness-mocks/internal/procexec\"\n)\n\n// Input is what the script is told on each run, in A10N_MOCK_* variables.\ntype Input struct {\n\t// Prompt is the user's prompt, unchanged.\n\tPrompt string\n\t// AdditionalContext is the context a UserPromptSubmit hook added.\n\tAdditionalContext string\n\t// SessionFile is the session record so far.\n\tSessionFile string\n}\n\n// ToolUse is a tool call the script asked for.\ntype ToolUse struct {\n\tID    string\n\tName  string\n\tInput json.RawMessage\n}\n\n// Turn is what one run of the script said: the agent's messages in order, and\n// how the turn ends, with a tool call or with the result that ends the run\n// (neither: the script ended without a tool call or a result).\ntype Turn struct {\n\tTexts  []string\n\tTool   *ToolUse\n\tResult *string\n}\n\n// Idents are the variables a script is given.\n//\n// The script receives the user's prompt, unchanged, in A10N_MOCK_PROMPT; the\n// session record so far in A10N_MOCK_SESSION_FILE; and a UserPromptSubmit\n// hook's additional context in A10N_MOCK_ADDITIONAL_CONTEXT, never in place of\n// the prompt.\n//\n// sr:invariant scenario-prompt-env\n// sr:invariant session-file-env\n// sr:invariant prompt-context-appended\nfunc Idents(in Input) map[string]string {\n\treturn map[string]string{\n\t\t\"A10N_MOCK_PROMPT\":             in.Prompt,\n\t\t\"A10N_MOCK_ADDITIONAL_CONTEXT\": in.AdditionalContext,\n\t\t\"A10N_MOCK_SESSION_FILE\":       in.SessionFile,\n\t}\n}\n\n// RunTurn runs the script once and reads its lines up to the first tool call\n// or result.","is_error":false}]},"uuid":"1e7cc50d-fe47-4154-b7f4-e94cf722edcb","timestamp":"2026-10-03T15:20:33.527Z","sourceToolAssistantUUID":"69a259d0-70a9-4437-b52a-154fd258c6a2","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a1623904b5d23ad05","sessionId":"f1