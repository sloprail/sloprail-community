ything about the concern lives here\ninternal/procexec/module.yaml:5:api: [\"internal/procexec\", \"claude-mock/internal/childenv\", \"codex-mock/internal/childenv\", \"cursor-mock/internal/childenv\"]       # the only packages others may import\ninternal/session/module.yaml:4:home: [\"internal/session/**\", \"claude-mock/internal/runner/session_append.go\", \"claude-mock/internal/runner/session_fork.go\", \"claude-mock/internal/runner/session_paths.go\", \"claude-mock/internal/runner/session_resume.go\", \"claude-mock/internal/runner/session_seed.go\", \"claude-mock/internal/runner/session_test.go\", \"claude-mock/internal/runner/fork_test.go\", \"claude-mock/internal/runner/runner_session_hooks.go\", \"claude-mock/internal/runner/runner_resume.go\", \"codex-mock/internal/session/**\"]   # everything about the concern lives here\ninternal/session/module.yaml:5:api: [\"internal/session\", \"codex-mock/internal/session\"]       # the only packages others may import\ninternal/toolcall/module.yaml:4:home: [\"internal/toolcall/**\", \"claude-mock/internal/runner/stream_tool.go\", \"claude-mock/internal/runner/tool_hooks.go\", \"codex-mock/internal/runner/tool_host.go\", \"cursor-mock/internal/runner/toolhost.go\", \"cursor-mock/internal/runner/toolcall_frames.go\"]   # everything about the concern lives here\ninternal/subagents/module.yaml:4:home: [\"internal/subagents/**\", \"claude-mock/internal/runner/agent*.go\", \"claude-mock/internal/runner/session_subagent.go\", \"claude-mock/internal/runner/control.go\", \"codex-mock/internal/runner/agent_tool.go\", \"codex-mock/internal/runner/agent_host.go\", \"codex-mock/internal/runner/agent_stop.go\", \"cursor-mock/internal/runner/agent*.go\", \"codex-mock/internal/runner/spawn_*.go\"]   # everything about the concern lives here\ninternal/tools/module.yaml:4:home: [\"internal/tools/**\", \"claude-mock/internal/toolexec/**\", \"claude-mock/internal/runner/schedulewakeup.go\", \"cursor-mock/internal/toolexec/**\", \"codex-mock/internal/toolexec/**\", \"codex-mock/internal/runner/patch_tool.go\"]   # everything about the concern lives here\ninternal/tools/module.yaml:5:api: [\"internal/tools\", \"claude-mock/internal/toolexec\", \"cursor-mock/internal/toolexec\", \"codex-mock/internal/toolexec\"]      # the only packages others may import\ninternal/tasks/module.yaml:4:home: [\"internal/tasks/**\", \"claude-mock/internal/runner/background*.go\", \"codex-mock/internal/runner/background*.go\", \"cursor-mock/internal/runner/background*.go\"]   # everything about the concern lives here\ninternal/turnloop/module.yaml:4:home: [\"internal/turnloop/**\", \"claude-mock/internal/runner/stream.go\", \"claude-mock/internal/runner/stream_hook.go\", \"claude-mock/internal/runner/stream_turn.go\", \"codex-mock/internal/runner/turn_host.go\", \"cursor-mock/internal/runner/run.go\", \"cursor-mock/internal/runner/host.go\"]   # everything about the concern lives here\n#!/usr/bin/env bash\n# `space` and `exceptions` (globs) come from the ADR(s) linking this rule.\n# Exceptions only shrink (adr/modules-cover-code: \"nothing new is added there\"): the list may not\n# grow against the range's base (an entry that covers more than the base's entries did), and a\n# file ADDED in the range (or renamed in) may not match one.\nset -uo pipefail\npayload=\"$(cat)\"\n. \"${SR_GUARDRAIL_DIR:-.}/../../_lib/changeset.sh\"\n. \"${SR_GUARDRAIL_DIR:-.}/../../_lib/adr.sh\"\n. \"${SR_GUARDRAIL_DIR:-.}/../../_lib/modules.sh\"\nload_adrs \"$(rule_qname)\"\nspace=(); while IFS= read -r g; do [ -n \"$g\" ] && space+=(\"$g\"); done < <(jq -r '[.[] | .frontmatter.space // [] | .[]] | .[]' <<<\"$ADRS\")\nexc=(); while IFS= read -r g; do [ -n \"$g\" ] && exc+=(\"$g\"); done < <(jq -r '[.[] | .frontmatter.exceptions // [] | .[]] | .[]' <<<\"$ADRS\")\n[ \"${#space[@]}\" -gt 0 ] || refuse \"no ADR linking $(rule_qname) declares a space, so module coverage cannot be checked\"\nload_modules\n# every module states its concern (adr/modules-cover-code): an empty `concern:` cannot be judged\nnoconcern=\"$(jq -r '.[] | select((.concern | tostring | gsub(\"\\\\s\"; \"\")) == \"\") | .dir' <<<\"$MODULES\")\" || refuse \"could not read the modules' concern lines\"\n[ -z \"$noconcern\" ] || refuse \"these modules have no \\`concern:\\` line in their module.yaml; state each module's responsibility there (adr/modules-cover-code):\n$noconcern\"\nfiles=\"$(git -C \"$SR_TREE\" ls-files -- '*.go' ':!*_test.go' ':!proposals/**' 2>&1)\" || refuse \"could not list Go files: $files\"\n\nproblems=\"\"\nwhile IFS= read -r f; do\n  [ -n \"$f\" ] || continue\n  in_globs \"$f\" \"${space[@]}\" || continue\n  [ \"${#exc[@]}\" -gt 0 ] && in_globs \"$f\" \"${exc[@]}\" && continue\n  owners=\"\"\n  while IFS= read -r m; do\n    home=(); while IFS= read -r g; do home+=(\"$g\"); done < <(jq -r '.home[]' <<<\"$m\")\n    [ \"${#home[@]}\" -gt 0 ] && in_globs \"$f\" \"${home[@]}\" && owners=\"${owners:+$owners, }$(jq -r '.dir' <<<\"$m\")\"\n  done < <(jq -c '.[]' <<<\"$MODULES\")\n  case \"$owners\" in\n    \"\") problems=\"${problems}- $f belongs to no module: put it in a module's home, or add a module.yaml for it\"$'\\n' ;;\n    *,*) problems=\"${problems}- $f lies in more than one module's home ($owners): module homes may not overlap\"$'\\n' ;;\n  esac\ndone <<<\"$files\"\n# exceptions never grow\nif [ \"${#exc[@]}\" -gt 0 ]; then\n  base=\"$(cs '.changeset.base')\"\n  [ -n \"$base\" ] || refuse \"the range's base is unknown, so it cannot be told whether the exceptions grew\"\nevery-file-mapped.sh\nfile-guard.yaml","is_error":false}]},"uuid":"6665768d-5a3c-4f5e-b8d1-7157bee7400f","timestamp":"2026-10-03T19:30:46.195Z","sourceToolAssistantUUID":"abde25d7-fbbd-40e3-94ef-4e52449b6d30","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a122781128a284455","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a12278