{"parentUuid":"abc0397e-b903-467b-8436-c94849d61998","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a122781128a284455","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013dJ6Cqqq51DAP4bYpHY9Ac","type":"tool_result","content":"80-\n81:      --skip-git-repo-check\n82-          Allow running Codex outside a Git repository\n83-\n84-      --ephemeral\n--\n92-\n93:      --output-schema <FILE>\n94-          Path to a JSON Schema file describing the model's final response shape\n95-\n96-      --color <COLOR>\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/runner\"\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/session\"\n)\n\n// newExec is `exec`, the non-interactive run. It accepts the flags a real\n// `codex exec` accepts and has no use for, so a caller's command line works\n// unchanged.\nfunc newExec() *cobra.Command {\n\tcmd := &cobra.Command{\n\t\tUse:   \"exec [flags] [prompt]\",\n\t\tShort: \"Run the scenario script as a non-interactive Codex session\",\n\t\tRunE:  runExec,\n\t}\n\tf := cmd.Flags()\n\tf.String(\"script\", \"\", \"Scenario script that drives the agent (env: A10N_MOCK_SCRIPT)\")\n\tf.Bool(\"json\", false, \"Print events to stdout as JSONL\")\n\tf.StringP(\"cd\", \"C\", \"\", \"Working directory of the session (default: the current one)\")\n\tf.StringP(\"model\", \"m\", \"\", \"Model name reported in hook payloads\")\n\t// Accepted for compatibility with `codex exec`; no effect.\n\tf.StringArrayP(\"config\", \"c\", nil, \"Config override key=value; only agents.max_depth has an effect\")\n\tf.StringArray(\"enable\", nil, \"Accepted; no effect\")\n\tf.StringArray(\"disable\", nil, \"Accepted; no effect\")\n\tf.StringP(\"sandbox\", \"s\", \"\", \"Accepted; no effect\")\n\tf.StringP(\"profile\", \"p\", \"\", \"Accepted; no effect\")\n\tf.String(\"color\", \"\", \"Accepted; no effect\")\n\tf.StringP(\"output-last-message\", \"o\", \"\", \"Accepted; no effect\")\n\tf.String(\"output-schema\", \"\", \"Accepted; no effect\")\n\tf.String(\"thread-source\", \"\", \"Accepted; no effect\")\n\tfor _, name := range []string{\"skip-git-repo-check\", \"ephemeral\", \"ignore-user-config\", \"ignore-rules\",\n\t\t\"strict-config\", \"dangerously-bypass-approvals-and-sandbox\", \"dangerously-bypass-hook-trust\", \"approve-for-me\"} {\n\t\tf.Bool(name, false, \"Accepted; no effect\")\n\t}\n\treturn cmd\n}\n\nfunc runExec(cmd *cobra.Command, args []string) error {\n\tf := cmd.Flags()\n\tscript, _ := f.GetString(\"script\")\n\tif script == \"\" {\n\t\tscript = os.Getenv(\"A10N_MOCK_SCRIPT\")\n\t}\n\tcwd, _ := f.GetString(\"cd\")\n\tif cwd == \"\" {\n\t\tvar err error\n\t\tif cwd, err = os.Getwd(); err != nil {\n\t\t\treturn fmt.Errorf(\"codex-mock: getwd: %w\", err)\n\t\t}\n\t}\n\tif resolved, err := filepath.EvalSymlinks(cwd); err == nil {\n\t\tcwd = resolved\n\t}\n\thome := os.Getenv(\"CODEX_HOME\")\n\tif home == \"\" {\n\t\tuser, err := os.UserHomeDir()\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"codex-mock: no CODEX_HOME and no home directory: %w\", err)\n\t\t}\n\t\thome = filepath.Join(user, \".codex\")\n\t}\n\tasJSON, _ := f.GetBool(\"json\")\n\tbypass, _ := f.GetBool(\"dangerously-bypass-hook-trust\")\n\tmodel, _ := f.GetString(\"model\")\n\tif len(args) >= 2 && args[0] == \"resume\" { // `exec resume <session id> [prompt]`\n\t\treturn session.Resume(home, args[1])\n\t}\n\toverrides, _ := f.GetStringArray(\"config\")\n\trunner.Agents = runner.AgentSettings{MaxDepth: maxDepthOf(overrides), Script: os.Getenv(\"A10N_MOCK_SUBAGENT_SCRIPT\")}\n\treturn runner.Run(cmd.Context(), runner.Config{\n\t\tScript: script, Prompt: strings.Join(args, \" \"), Cwd: cwd, CodexHome: home, Model: model,\n\t\tEnviron: os.Environ(), JSON: asJSON, BypassHookTrust: bypass, Stdout: cmd.OutOrStdout(), Stderr: os.Stderr,\n\t})\n}\n\n// maxDepthOf is the agents.max_depth a -c override sets (the last one wins),\n// 0 when none does: Codex's default depth.\nfunc maxDepthOf(overrides []string) int {\n\tdepth := 0\n\tfor _, o := range overrides {\n\t\tif v, ok := strings.CutPrefix(o, \"agents.max_depth=\"); ok {\n\t\t\tif n, err := strconv.Atoi(strings.TrimSpace(v)); err == nil {\n\t\t\t\tdepth = n\n\t\t\t}\n\t\t}\n\t}\n\treturn depth\n}\nagent-input-validation\nagent-input-validation-spawn\nbackground-agent\nbackground-bash-start\nbg-bash-reaped-at-exit\ncompaction-transcript-continuity\nfile-tools\nfile-tools-failure\nforeground-subagent-bash-ends-with-response\nhook-exit-codes\nhook-exit-json\nhook-matchers\nhook-timeout\nhook-unstartable\nhooks-all-matching-run-blockers-fast-first\nhooks-all-matching-run-blockers-slow-first\nhooks-all-matching-run-same-hook-two-files\nmanual-compaction-auto\nmanual-compaction-auto-blocked\nmanual-compaction-auto-post-stopped\nmanual-compaction-slash\nnested-session-env\nnested-subagents\nnested-subagents-limit\nnested-subagents-nowait\nnoninteractive-run-text-output\nposttool-block\npretool-decisions\nprint-waits-for-background-agents\nprompt-blocked\nschedule-wakeup-ask\nsession-end\nsession-end-hook-failure\nsession-end-hook-output\nsession-resume-unknown\nsession-start-continue-false\nsession-transcript-file\nshell-exit-status\nstop-block-cap-30\nstop-continue-false\nstop-no-message\nstops\nsubagent-lifecycle-hooks\nsubagent-start-refused\nsubagent-stop-block-loop\nsubagent-stop-block-loop-cap\nsubagent-worktree-isolation\nsubprocess-session-env\ntask-notifications-bg\ntask-stream-frames\nuser-prompt-submit-hook-bg\nuser-prompt-submit-hook-json-block\nuser-prompt-submit-hook-rewrite\ncodex: tests/recordings for session-start-hook, session-end-hook, noninteractive-run, subprocess-session-env, session-transcript-file (#121)\n\n codex-mock/snapshots/capture.sh | 7 +++++--\n 1 file changed, 5 insertions(+), 2 deletions(-)\ncodex, cursor: session-resume-unknown cells (codex supported with deviations, cursor unsupported) (#103)\n\n codex-mock/snapshots/capture.sh | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)\ncodex: hooks-all-matching-run supported, recorded in three runs (#99)\n\n codex-mock/snapshots/capture.sh | 2 ++\n 1 file changed, 2 insertions(+)","is_error":false}]},"uuid":"ab0f4a91-b272-4eff-a1a1-a0923415a8bd","timestamp":"2026-10-03T19:19:15.589Z","sourceToolAssistantUUID":"abc0397e-b903-467b-8436-c94849d61998","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a122781128a284455","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a8a444ee54a52b4dc"}
