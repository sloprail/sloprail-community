the mock and\n\t\t\t// its tests to the deviation, not to the doc, for exactly that point)\n\t\t\tdocs: [#DocRef, ...#DocRef]\n\t\t\truns: [string & =~\"^\\(H)-mock/snapshots/runs/[a-z][a-z0-9]*(-[a-z0-9]+)*$\", ...string & =~\"^\\(H)-mock/snapshots/runs/[a-z][a-z0-9]*(-[a-z0-9]+)*$\"]\n\t\t}\n\t}\n}\n\n#DocRef: string & =~\"^https://[^\\\\s#]+#[a-z0-9-]+$\"\n3:  https://developers.openai.com/codex/hooks:\n6:  https://developers.openai.com/codex/noninteractive:","is_error":false}]},"uuid":"db749c88-a03c-43d4-a2ec-f1f0e6f05d21","timestamp":"2026-10-03T15:28:21.451Z","sourceToolAssistantUUID":"5c1813ce-633c-40c2-a05c-1dc76179969a","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a4d84e01b97891e91"}
