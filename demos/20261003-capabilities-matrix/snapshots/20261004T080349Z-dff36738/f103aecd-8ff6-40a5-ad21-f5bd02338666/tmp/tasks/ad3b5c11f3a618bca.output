{"parentUuid":"3c4bba5c-dabf-4df7-862b-d4a1f84677de","isSidechain":true,"agentId":"ad3b5c11f3a618bca","attachment":{"type":"edited_text_file","filename":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca/codex-mock/e2e/001_hooks/collab_test.go","snippet":"60\t\tgot := execMock(t, scenario{Script: script, Files: map[string]string{\"sub.sh\": sub}, Prompt: \"go\"})\n61\t\trequire.Equal(t, 0, got.Code, got.Stderr)\n62\t\n63\t\t// the mock's items are the recording's, apart from the order: the mock\n64\t\t// runs the calls one after the other, where the real agent made the spawn\n65\t\t// and the command together\n66\t\tassert.Equal(t, want, collabShape(got.stream()))\n67\t\n68\t\t// the shell command is no task: an ordinary command_execution item,\n69\t\t// started and completed with exit 0, and no stream item of any other kind\n70\t\t// than the real run's\n71\t\tvar started, completed int\n72\t\tfor _, e := range got.stream() {\n73\t\t\titem, _ := e[\"item\"].(map[string]any)\n74\t\t\tswitch item[\"type\"] {\n75\t\t\tcase \"command_execution\":\n76\t\t\t\tif e[\"type\"] == \"item.started\" {\n77\t\t\t\t\tstarted++\n78\t\t\t\t} else {\n79\t\t\t\t\tcompleted++\n80\t\t\t\t\tassert.Equal(t, float64(0), item[\"exit_code\"])\n81\t\t\t\t}\n82\t\t\tcase \"collab_tool_call\", \"agent_message\", \"error\", nil:\n83\t\t\tdefault:\n84\t\t\t\tt.Errorf(\"unexpected stream item %v\", item[\"type\"])\n85\t\t\t}\n86\t\t}\n87\t\tassert.Equal(t, [2]int{1, 1}, [2]int{started, completed})\n88\t\n89\t\t// the answer is what the agent was told by the wait\n90\t\trollout := got.rollout(t)\n91\t\tassert.Contains(t, rollout, `\\\"completed\\\":\\\"PONG\\\"`)\n92\t\n93\t\t// a sub-agent's thread is named by the spawn, and the wait names the same\n94\t\tvar spawned, waited []any\n95\t\tfor _, e := range got.stream() {\n96\t\t\titem, _ := e[\"item\"].(map[string]any)"},"type":"attachment","uuid":"68075727-c8b2-44b3-9740-ef5fa7ccffcb","timestamp":"2026-10-03T1