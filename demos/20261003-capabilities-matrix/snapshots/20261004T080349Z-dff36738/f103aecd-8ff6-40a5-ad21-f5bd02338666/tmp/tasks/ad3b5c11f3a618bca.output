shal(tu.Input, &in)\n\tswitch tu.Name {\n\tcase \"spawn_agent\":\n\t\th.rollout.ToolCall(tu.ID, tu.Name, tu.Input)\n\t\th.spawn(tu, in.Message, in.Reply)\n\tcase \"wait_agent\":\n\t\th.rollout.ToolCall(tu.ID, tu.Name, tu.Input)\n\t\th.wait(tu, in.Targets)\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\n// spawn starts a sub-agent: its call is shown as started, then, with the\n// sub-agent's thread, as completed, the sub-agent pending its first run.\nfunc (h turnHost) spawn(tu scenario.ToolUse, message, reply string) {\n\tif h.agents == nil {\n\t\th.agents = &spawned{byID: map[string]*tasks.Task{}}\n\t}\n\tt := tasks.NewTask(tasks.Agent, coresession.NewID())\n\tt.Result = reply\n\tt.Meta = spawnMeta{prompt: message}\n\tm := t.Meta.(spawnMeta)\n\tm.item = h.events.CollabStarted(events.Collab{Tool: \"spawn_agent\", Sender: h.id, Prompt: &message})\n\tt.Meta = m\n\th.agents.order = append(h.agents.order, t.ID)\n\th.agents.byID[t.ID] = t\n\ttasks.Announce(nil, t, &collabFrames{state: h.state})\n\tout, _ := json.Marshal(map[string]string{\"agent_id\": t.ID})\n\th.rollout.ToolOutput(tu.ID, string(out))\n}\n\n// wait waits for sub-agents to answer (all of those spawned, when it names\n// none): the call is shown as started, then completed with the state of each,\n// and that is how their end is told.\nfunc (h turnHost) wait(tu scenario.ToolUse, targets []string) {\n\tif len(targets) == 0 && h.agents != nil {\n\t\ttargets = h.agents.order\n\t}\n\th.events.CollabStarted(events.Collab{Tool: \"wait\", Sender: h.id, Receivers: targets})\n\tframes := &collabFrames{state: h.state, wait: len(h.events.Items()) - 1, states: map[string]events.AgentState{}}\n\tstatus := map[string]any{}\n\tfor _, id := range targets {\n\t\tif t, ok := h.agents.byID[id]; ok && h.agents != nil {\n\t\t\ttasks.Conclude(nil, t, frames)\n\t\t\tstatus[id] = map[string]string{string(t.Status()): t.Result}\n\t\t}\n\t}\n\th.events.CollabCompleted(frames.wait, events.Collab{Tool: \"wait\", Sender: h.id, Receivers: targets, States: frames.states})\n\tout, _ := json.Marshal(map[string]any{\"status\": status, \"timed_out\": false})\n\th.rollout.ToolOutput(tu.ID, string(out))\n}\n"}},"apiBlockIndex":1,"requestId":"req_011CffXydCgM7kVFQX2Lk3ZV","attributionAgent":"general-purpose","type":"assistant","uuid":"444a1222-7408-4d9b-a3b3-54578dd51db4","timestamp":"2026-10-03T15:24:27.706Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-aa43418fbebf671c6"}
