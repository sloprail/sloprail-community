{"parentUuid":"1c76433c-5fcb-4a1c-8f6a-5fcd36123706","isSidechain":true,"agentId":"ad3b5c11f3a618bca","message":{"model":"claude-sonnet-5-5","id":"msg_011CffXGoNTza5tDjy1mKy64","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011pmg3LmsGtKRCiFfHzDoah","name":"Bash","input":{"command":"ls codex-mock/snapshots/runs cursor-mock/snapshots/runs; cat codex-mock/snapshots/capture.sh | head -60; grep -rhoE '\"type\":\"[a-z_]+\"' codex-mock/snapshots/runs/*/samples/*/stream.jsonl | sort | uniq -c; grep -rhoE '\"subtype\":\"[a-z_]+\"|\"type\":\"[a-z_]+\"' cursor-mock/snapshots/runs/*/samples/*/stream.jsonl | sort | uniq -c"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1537,"cache_read_input_tokens":51216,"output_tokens":355,"output_tokens_details":{"thinking_tokens":68},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1537},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":355,"cache_read_input_tokens":51216,"cache_creation_input_tokens":1537,"cache_creation":{"ephemeral_5m_input_tokens":1537,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_011pmg3LmsGtKRCiFfHzDoah":{"command":"cd /Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca && ls codex-mock/snapshots/runs cursor-mock/snapshots/runs; cat codex-mock/snapshots/capture.sh | head -60; grep -rhoE '\"type\":\"[a-z_]+\"' codex-mock/snapshots/runs/*/samples/*/stream.jsonl | sort | uniq -c; grep -rhoE '\"subtype\":\"[a-z_]+\"|\"type\":\"[a-z_]+\"' cursor-mock/snapshots/runs/*/samples/*/stream.jsonl | sort | uniq -c"}},"wireIngestContext":{"toolu_011pmg3LmsGtKRCiFfHzDoah":{"cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca"}},"apiBlockIndex":1,"requestId":"req_011CffXGo3rtUCCMNxtJKoVL","attributionAgent":"general-purpose","type":"assistant","uuid":"c27f42e0-7471-471d-8b23-402b26c1e697","timestamp":"2026-10-03T15:15:01.842Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a26fb63d519ffd330"}
{"parentUuid":"c27f42e0-7471-471d-8b23-402b26c1e697","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"ad3b5c11f3a618bca","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011pmg3LmsGtKRCiFfHzDoah","type":"tool_result","content":"codex-mock/snapshots/runs:\nhook-exit-codes\nhook-exit-json\nhook-matchers\nhook-timeout\nhook-unstartable\nnested-session-env\nposttool-block\npretool-decisions\nprompt-blocked\nschedule-wakeup-ask\nsession-end\nshell-exit-status\nstops\nsubprocess-session-env\n\ncursor-mock/snapshots/runs:\nadditional-context\nfile-tools\nhook-exit-codes\nhook-fail-closed\nhook-json-nonzero\nhook-matchers\nhook-timeout\nhooks-together\nnested-session-env\npretool-refusal\nschedule-wakeup-ask\nsession-start-block\nshell-exit-status\nstop-block-continuation\nsubprocess-session-env\nsymlinked-cwd\ntool-failure\n#!/usr/bin/env bash\n# The ONLY writer of codex-mock/snapshots/ (the snapshots-read-only gate\n# refuses every other write). Everything it writes is sealed; snapshots-current\n# refuses a snapshot whose seal does not match, so a hand edit is caught at the\n# commit even if it slipped past the gate.\n#\n#   capture.sh run <name>    run the scenario in runs/<name>/setup/ against the\n#                            real `codex exec`, and add a sample\n#   capture.sh doc <url>     freeze a doc page (e.g. https://developers.openai.com/codex/hooks):\n#                            its sha256 goes in the MANIFEST; its text only into a cache\n#                            under the git dir, never into the repo\n#   capture.sh drop <run> <ts>  remove one sample (a bad or non-hermetic capture)\n#   capture.sh all           re-capture every run and doc at the installed\n#                            codex's version, and set MANIFEST.version to it\n#\n# A scenario is hand-authored, and only its setup/ is:\n#   runs/<name>/setup/prompt.txt       the prompt\n#   runs/<name>/setup/hooks.json       the user layer's $CODEX_HOME/hooks.json\n#   runs/<name>/setup/hook.sh          optional: the hook every event runs;\n#                                      it appends its stdin to $HOOK_LOG\n#   runs/<name>/setup/args             optional: extra codex exec flags, one per line\n#   runs/<name>/setup/env              optional: KEY=VALUE lines codex inherits on\n#                                      top of the hermetic env (e.g. an outer session's)\n#\n# Authentication: codex has no headless login but the user's. The run's fake\n# CODEX_HOME holds ONLY a symlink to the logged-in auth.json (the same trick as\n# claude-mock's Keychains link): nothing is copied, and a token codex refreshes\n# during the run is moved back over the original, so the login stays valid.\n# The link is gone with the fake home, and a capture is refused if any token\n# value reached the sample.\nset -euo pipefail\nhere=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nmanifest=\"$here/MANIFEST.yaml\"\ndie() { echo \"capture.sh: $*\" >&2; exit 1; }\nversion() { yq -r '.version' \"$manifest\"; }\ninstalled() { codex --version | awk '{print $2}'; }\nauth_src=\"${CODEX_AUTH_JSON:-$HOME/.codex/auth.json}\"\n# The first capture creates the MANIFEST, frozen at the installed version: it is\n# a snapshot file too, so nothing else may write it.\n[ -f \"$manifest\" ] || printf 'version: \"%s\"\\n' \"$(installed)\" >\"$manifest\"\n\n# One capture at a time: they are real model calls on one account.\nlock=/tmp/capture-codex.lock.d\nacquire() { local i=0; until mkdir \"$lock\" 2>/dev/null; do i=$((i + 1)); [ \"$i\" -le 600 ] || die \"another capture holds $lock\"; sleep 1; done; }\n\n# seal DIR — SEAL lists the sha256 of every other file under DIR.\n# Written to SEAL.tmp and renamed only on success, so a SEAL always means a\n# complete sample (the cleanup trap relies on it).\nseal() { (cd \"$1\" && find . -type f ! -name 'SEAL*' | LC_ALL=C sort | xargs shasum -a 256 >SEAL.tmp && mv SEAL.tmp SEAL); }\n\n# normalize — hook payloads and event-stream frames into events.jsonl: what a\n# scenario did, without what differs between two captures of the same\n# behaviour (ids, paths, timings, the model's own wording).\n# The run's own session (thread) id is kept as <SESSION_ID> wherever it appears\n# (a payload's session_id, a child's env, a command's output): that they match\n# is recorded, the value itself is not.\nnormalize() {\n  local cap=\"$1\" sid\n  sid=\"$(jq -r 'select(.session_id) | .session_id' \"$cap/payloads.jsonl\" 2>/dev/null | head -n1 || true)\"\n  jq -c --arg sid \"${sid:-<none>}\" 'walk(if type == \"object\" then del(.transcript_path, .cwd, .turn_id, .tool_use_id, .uuid,\n  18 \"type\":\"agent_message\"\n  58 \"type\":\"command_execution\"\n  28 \"type\":\"error\"\n 116 \"subtype\":\"completed\"\n 248 \"subtype\":\"delta\"\n  17 \"subtype\":\"init\"\n  50 \"subtype\":\"started\"\n  17 \"subtype\":\"success\"\n  31 \"type\":\"assistant\"\n   2 \"type\":\"number\"\n  14 \"type\":\"raw_string\"\n  17 \"type\":\"result\"\n  17 \"type\":\"system\"\n  48 \"type\":\"text\"\n 314 \"type\":\"thinking\"\n 100 \"type\":\"tool_call\"\n  17 \"type\":\"user\"\n  79 \"type\":\"word\"","is_error":false}]},"uuid":"5f83e81b-ae1b-4f8d-9285-6a120519f05a","timestamp":"2026-10-03T15:15:03.366Z","sourceToolAssistantUUID":"c27f42e0-7471-471d-8b23-402b26c1e697","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-ad3b5c11f3a618bca","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a26fb63d519ffd330"}
