{"parentUuid":"8c5c7195-1ae9-4ea8-b094-b9541e71cae6","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a63bb90a3bc6561be","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tgw21dbUj8fgnC9aeHzZNN","type":"tool_result","content":"internal/hooks/run.go:13:type Command struct {\ninternal/hooks/run.go-14-\t// Line is the shell command line.\ninternal/hooks/run.go-15-\tLine string\ninternal/hooks/run.go-16-\t// Timeout is how long it may run; zero is the Runtime's default.\ninternal/hooks/run.go-17-\tTimeout time.Duration\ninternal/hooks/run.go-18-\t// Env is what only this command is told, KEY=VALUE, after the Runtime's.\ninternal/hooks/run.go-19-\tEnv []string\ninternal/hooks/run.go-20-}\ninternal/hooks/run.go-21-\ninternal/hooks/run.go-22-// Outcome is how one hook command ended.\ninternal/hooks/run.go-23-type Outcome struct {\ninternal/hooks/run.go-24-\tCommand string\ninternal/hooks/run.go-25-\t// Exit is its exit status; -1 when it did not exit by itself.\ninternal/hooks/run.go:42:type Runtime struct {\ninternal/hooks/run.go-43-\t// Dir is the working directory of the session.\ninternal/hooks/run.go-44-\tDir string\ninternal/hooks/run.go-45-\t// Env is the environment of a hook command (procexec.Env builds it).\ninternal/hooks/run.go-46-\tEnv []string\ninternal/hooks/run.go-47-\t// DefaultTimeout applies to a command with none of its own.\ninternal/hooks/run.go-48-\tDefaultTimeout time.Duration\ninternal/hooks/run.go-49-\t// NewSession runs each command in a session of its own, with no\ninternal/hooks/run.go-50-\t// controlling terminal (a harness whose hooks cannot open /dev/tty).\ninternal/hooks/run.go-51-\tNewSession bool\ninternal/hooks/run.go-52-}\n// other reason to report.\n//\n// The sessionStart hook fires once, before the first turn, and what it prints or\n// exits with does not stop the session (recorded: runs/session-start-block); the\n// payload says no source, as Cursor's does not.\n//\n// sr:provides noninteractive-run/cursor\n// sr:provides session-end-hook/cursor\n// sr:provides session-start-hook/cursor\n// sr:docs https://cursor.com/docs/hooks#sessionend\n// sr:docs https://cursor.com/docs/hooks#sessionstart\nfunc Run(ctx context.Context, cfg Config) error {\n\ts := &session{cfg: cfg, id: coresession.NewID(), started: time.Now()}\n\tvar err error\n\tif s.tr, err = newTranscript(cfg.Home, cfg.Dir, s.id); err != nil {\n\t\treturn fmt.Errorf(\"cursor-mock: %w\", err)\n\t}\n\tconf, err := hooks.Load(cfg.Dir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cursor-mock: %w\", err)\n\t}\n\ts.hooks = &hooks.Hooks{Config: conf, Dir: cfg.Dir, Env: s.hookEnv, Common: s.common}\n\ts.forward(initFrame(s.id, cfg.Dir))\n\ts.forward(userFrame(s.id, cfg.Prompt))\n\ts.keep(s.hooks.Fire(ctx, hooks.SessionStart, hooks.NoSubject, map[string]any{\"is_background_agent\": false}))\n\ts.tr.user(cfg.Prompt) // the transcript file does not exist yet when the start hook runs\n\t_, runErr := turnloop.Run(ctx, s, turnloop.Params{Script: cfg.Script, Dir: cfg.Dir, Environ: cfg.Environ, Prompt: cfg.Prompt, Added: s.Context})\n\ts.named = true\n\ts.hooks.Fire(ctx, hooks.SessionEnd, hooks.NoSubject, map[string]any{\n\t\t\"reason\": \"completed\", \"duration_ms\": time.Since(s.started).Milliseconds(),\n\t\t\"is_background_agent\": false, \"final_status\": \"completed\",\n\t})\n\ts.tr.end()\n\tif runErr != nil {\n\t\treturn fmt.Errorf(\"cursor-mock: %w\", runErr)\n\t}\n\ts.forward(resultFrame(s.id, strings.Join(s.texts, \"\"), time.Since(s.started)))\n\treturn nil\n}\n\n// hookEnv is the environment of a hook command: the harness's own, with the\n// facts Cursor gives a hook (recorded: runs/subprocess-session-env,\n// runs/nested-session-env).\nfunc (s *session) hookEnv() []string {\n\treturn procexec.Env(s.cfg.Environ,\n\t\tchildenv.HookIdentity(s.cfg.Dir, s.common().TranscriptPath), childenv.HookDefaults(s.cfg.Dir, s.cfg.Version))\n}\n\n// common is what every hook payload carries now: the transcript path only once\n// the conversation has a transcript.\nfunc (s *session) common() hooks.Common {\n\tc := hooks.Common{SessionID: s.id, Dir: s.cfg.Dir, Version: s.cfg.Version}\n\tif s.named && s.tr.exists() {\n\t\tc.TranscriptPath = s.tr.path\n\t}\n\treturn c","is_error":false}]},"uuid":"4cbcbc5e-572a-4a3d-baef-7b68872eae1e","timestamp":"2026-10-03T16:56:41.111Z","sourceToolAssistantUUID":"8c5c7195-1ae9-4ea8-b094-b9541e71cae6","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a63bb90a3bc6561be","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
