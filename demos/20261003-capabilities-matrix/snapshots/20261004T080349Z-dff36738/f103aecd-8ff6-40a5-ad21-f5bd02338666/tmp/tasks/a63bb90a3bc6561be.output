{"parentUuid":"88ab15bb-0613-4dd5-bf6a-55b05e7c63e5","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a63bb90a3bc6561be","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJZYnfCvpW8PkcATGWU7fG","type":"tool_result","content":"24:func loadRecording(t *testing.T, name string) recording {\n45:func readFile(t *testing.T, path string) string {\n57:func replay(t *testing.T, rec recording, extraEnv ...string) result {\n71:func normalized(v any, sid string) any {\n92:func sortedHookLines(lines []map[string]any) []string {\n115:func TestReplayOfRecordedRuns(t *testing.T) {\n139:func failures(exits []float64) []bool {\n149:func streamShape(events []map[string]any) []string {\npackage e2e\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/assert\"\n\t\"github.com/stretchr/testify/require\"\n)\n\nconst runsDir = \"../../snapshots/runs\"\n\n// recording is one recorded sample of a real `codex exec` run.\ntype recording struct {\n\tsetup  string   // runs/<name>/setup\n\tsample string   // runs/<name>/samples/<ts>\n\tcalls  []string // the shell commands the model asked for, in order\n}\n\nfunc loadRecording(t *testing.T, name string) recording {\n\tt.Helper()\n\tsamples, err := filepath.Glob(filepath.Join(runsDir, name, \"samples\", \"*\"))\n\trequire.NoError(t, err)\n\trequire.NotEmpty(t, samples, \"no recorded sample of run %s\", name)\n\trec := recording{setup: filepath.Join(runsDir, name, \"setup\"), sample: samples[len(samples)-1]}\n\tseen := map[string]bool{}\n\tfor _, p := range jsonLines(readFile(t, filepath.Join(rec.sample, \"payloads.jsonl\"))) {\n\t\tid, _ := p[\"tool_use_id\"].(string)\n\t\tif p[\"hook_event_name\"] == \"PreToolUse\" && !seen[id] {\n\t\t\tseen[id] = true\n\t\t\tin, _ := p[\"tool_input\"].(map[string]any)\n\t\t\trec.calls = append(rec.calls, in[\"command\"].(string))\n\t\t}\n\t}\n\tif len(rec.calls) == 0 { // no before-tool hook logged: the commands that ran are the calls\n\t\trec.calls, _ = result{Stdout: readFile(t, filepath.Join(rec.sample, \"stream.jsonl\"))}.commands()\n\t}\n\treturn rec\n}\n\nfunc readFile(t *testing.T, path string) string {\n\tt.Helper()\n\tb, err := os.ReadFile(path)\n\tif os.IsNotExist(err) {\n\t\treturn \"\"\n\t}\n\trequire.NoError(t, err)\n\treturn string(b)\n}\n\n// replay runs the mock on the recorded run's own setup (its hooks.json, its\n// hook script, its prompt), with a script that makes the calls the model made.\nfunc replay(t *testing.T, rec recording, extraEnv ...string) result {\n\tt.Helper()\n\treturn execMock(t, scenario{\n\t\tHooksJSON: readFile(t, filepath.Join(rec.setup, \"hooks.json\")),\n46:\t\t\tgot := replay(t, rec)\n109:\tgot := replay(t, rec)","is_error":false}]},"uuid":"54af1b84-29f2-4010-9843-1eb16a4add05","timestamp":"2026-10-03T16:58:19.938Z","sourceToolAssistantUUID":"88ab15bb-0613-4dd5-bf6a-55b05e7c63e5","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a63bb90a3bc6561be","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
