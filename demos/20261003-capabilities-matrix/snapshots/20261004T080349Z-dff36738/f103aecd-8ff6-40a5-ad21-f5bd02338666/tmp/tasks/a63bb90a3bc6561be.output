')\n# cursor session-end\nsub(d+'session-end-hook.yaml','''      - cursor-mock/snapshots/runs/pretool-refusal\n''','''      - cursor-mock/snapshots/runs/pretool-refusal\n      - cursor-mock/snapshots/runs/session-end-hook-output\n''')\n# codex session end\nsub(d+'session-end-hook.yaml','''      - codex-mock/snapshots/runs/session-end\n    deviations:''','''      - codex-mock/snapshots/runs/session-end\n      - codex-mock/snapshots/runs/session-end-hook-output\n    deviations:''')\nsub(d+'session-end-hook.yaml','''      - adr: capability-grounding\n        statement: >-\n          That what the hook prints is not recorded in the transcript is not\n          shown for Codex: the docs say only that SessionEnd hooks are advisory\n          and their output does not steer Codex, and the recorded run's hook\n          prints nothing. The mock does not record it.\n''','')\n# cursor hooks-all\nsub(d+'hooks-all-matching-run.yaml','''      - cursor-mock/snapshots/runs/pretool-refusal\n    deviations:\n''','''      - cursor-mock/snapshots/runs/pretool-refusal\n      - cursor-mock/snapshots/runs/hooks-all-matching-run-same-hook-two-sources\n    deviations:\n      - adr: capability-grounding\n        statement: >-\n          Cursor does not run a hook configured in several sources once: the\n          same command in the user's ~/.cursor/hooks.json and the project's\n          .cursor/hooks.json ran once per source, twice in all (recorded:\n          runs/hooks-all-matching-run-same-hook-two-sources), as the docs say\n          all matching hooks from every source run. The mock reads only the\n          project source (below), so it runs such a hook once.\n''')\n# codex exit semantics\nsub(d+'hook-exit-code-semantics.yaml','''    deviations:\n      - adr: modeled-surface\n        statement: >-\n          The mock fires SessionStart, UserPromptSubmit, PreToolUse,\n          PostToolUse and Stop, and no others.''','''    deviations:\n      - adr: capability-grounding\n        statement: >-\n          Codex's exit 2 uses the hook's stderr as the message even when the\n          hook also printed a JSON reason: recorded, a PreToolUse hook that\n          printed a deny with the reason \"the JSON reason wins\" and wrote \"the\n          stderr loses\" to stderr, exiting 2, blocked the call, and the agent\n          was told the stderr text; the JSON on stdout was not read\n          (runs/hook-exit-json). The mock does the same.\n      - adr: modeled-surface\n        statement: >-\n          The mock fires SessionStart, UserPromptSubmit, PreToolUse,\n          PostToolUse and Stop, and no others.''')\n# codex stop\nsub(d+'stop-hook-payload.yaml','''      - codex-mock/snapshots/runs/stops\n  cursor:''','''      - codex-mock/snapshots/runs/stops\n      - codex-mock/snapshots/runs/user-prompt-submit-hook-bg\n    deviations:\n      - adr: capability-grounding\n        statement: >-\n          Codex's Stop payload does not list background tasks still running:\n          it carries the last assistant message and the continuation flag\n          beside the common fields, and no field names a background task, in\n          its doc or in any recorded payload, the Stop of a turn that started a\n          background command included (runs/stops,\n          runs/user-prompt-submit-hook-bg). The mock sends the same fields.\n  cursor:''')\n# codex ups\nsub(d+'user-prompt-submit-hook.yaml','''      - codex-mock/snapshots/runs/prompt-blocked\n  cursor:''','''      - codex-mock/snapshots/runs/prompt-blocked\n      - codex-mock/snapshots/runs/user-prompt-submit-hook-rewrite\n      - codex-mock/snapshots/runs/user-prompt-submit-hook-bg\n    deviations:\n      - adr: capability-grounding\n        statement: >-\n          Codex does not hand a background-task notification to the agent, so\n          its UserPromptSubmit hook does not fire for one: recorded, the hook\n          fired once, for the submitted prompt, in a run whose agent started a\n          background command and ended its turn with nothing handed back\n          (runs/user-prompt-submit-hook-bg, runs/task-notifications-bg). The\n          mock does the same.\n  cursor:''')\nEOF\ngit diff --stat"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1895,"cache_read_input_tokens":157623,"output_tokens":2829,"output_tokens_details":{"thinking_tokens":567},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1895},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2829,"cache_read_input_tokens":157623,"cache_creation_input_tokens":1895,"cache_creation":{"ephemeral_5m_input_tokens":1895,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Pc3f62v8bC2ApjtDchLike":{"command":"python3 - <<'EOF'\nimport re\ndef sub(path, old, new):\n    s=open(path).read()\n    assert old in s, (path, old[:40])\n    s=s.replace(old,new,1)\n    open(path,'w').write(s)\nd='spec/capabilities/'\n# cursor hook-common-payload\nsub(d+'hook-common-payload.yaml','''      - cursor-mock/snapshots/runs/pretool-refusal\n    deviations:\n      - adr: modeled-surface\n        statement: >-\n          The mock has no sub-agents (no Task tool''','''      - cursor-mock/snapshots/runs/pretool-refusal\n      - cursor-mock/snapshots/runs/file-tools\n    deviations:\n      - adr: capability-grounding\n        statement: >-\n          Cursor does not name the working directory as a cwd on every\n          payload: it names it as workspace_roots (the project's roots) on\n          every event, and a cwd field (recorded empty, the command having run\n          from the project root) is carried only by the events of a Shell call\n          (bef