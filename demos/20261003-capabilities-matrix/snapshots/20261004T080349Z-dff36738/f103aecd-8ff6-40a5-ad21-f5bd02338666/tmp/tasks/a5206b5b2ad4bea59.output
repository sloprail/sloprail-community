{"parentUuid":"905f14d5-25b6-4fe0-945b-266bfc498c24","isSidechain":true,"agentId":"a5206b5b2ad4bea59","message":{"model":"claude-sonnet-5-5","id":"msg_011CffdJVTTmrFxT5MT2QvHG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018wUxnkSYrhswSgBnP4scb1","name":"Write","input":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a5206b5b2ad4bea59/cursor-mock/e2e/001_hooks/session_end_duration_test.go","content":"package e2e\n\nimport (\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/require\"\n)\n\n// TestTheSessionEndHookGetsHowLongTheSessionLastedInMilliseconds: the doc\n// lists duration_ms among the sessionEnd input fields, and the recorded\n// sessionEnd payloads carry it (the replay's normalizer drops its value, which\n// differs from run to run): the mock's hook gets it as a number, beside the\n// reason and the final status.\n// sr:proves session-end-hook/cursor\nfunc TestTheSessionEndHookGetsHowLongTheSessionLastedInMilliseconds(t *testing.T) {\n\tgot, _ := replay(t, \"shell-exit-status\")\n\tvar seen int\n\tfor _, h := range got.raw {\n\t\tif h[\"hook_event_name\"] != \"sessionEnd\" {\n\t\t\tcontinue\n\t\t}\n\t\tseen++\n\t\td, ok := h[\"duration_ms\"].(float64)\n\t\trequire.True(t, ok, \"duration_ms is a number: %v\", h)\n\t\trequire.Greater(t, d, 0.0)\n\t\trequire.Equal(t, \"completed\", h[\"reason\"])\n\t\trequire.Equal(t, \"completed\", h[\"final_status\"])\n\t}\n\trequire.Equal(t, 1, seen, \"one sessionEnd\")\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":922,"cache_read_input_tokens":209136,"output_tokens":889,"output_tokens_details":{"thinking_tokens":311},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":922},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":889,"cache_read_input_tokens":209136,"cache_creation_input_tokens":922,"cache_creation":{"ephemeral_5m_input_tokens":922,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018wUxnkSYrhswSgBnP4scb1":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a5206b5b2ad4bea59/cursor-mock/e2e/001_hooks/session_end_duration_test.go","content":"package e2e\n\nimport (\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/require\"\n)\n\n// TestTheSessionEndHookGetsHowLongTheSessionLastedInMilliseconds: the doc\n// lists duration_ms among the sessionEnd input fields, and the recorded\n// sessionEnd payloads carry it (the replay's normalizer drops its value, which\n// differs from run to run): the mock's hook gets it as a number, beside the\n// reason and the final status.\n// sr:proves session-end-hook/cursor\nfunc TestTheSessionEndHookGetsHowLongTheSessionLastedInMilliseconds(t *testing.T) {\n\tgot, _ := replay(t, \"shell-exit-status\")\n\tvar seen int\n\tfor _, h := range got.raw {\n\t\tif h[\"hook_event_name\"] != \"sessionEnd\" {\n\t\t\tcontinue\n\t\t}\n\t\tseen++\n\t\td, ok := h[\"duration_ms\"].(float64)\n\t\trequire.True(t, ok, \"duration_ms is a number: %v\", h)\n\t\trequire.Greater(t, d, 0.0)\n\t\trequire.Equal(t, \"completed\", h[\"reason\"])\n\t\trequire.Equal(t, \"completed\", h[\"final_status\"])\n\t}\n\trequire.Equal(t, 1, seen, \"one sessionEnd\")\n}\n"}},"apiBlockIndex":1,"requestId":"req_011CffdJVBq8scw28RbV321P","attributionAgent":"general-purpose","type":"assistant","uuid":"c1b3efe4-91c5-4447-aa80-31a3fc47529f","timestamp":"2026-10-03T16:34:09.690Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a5206b5b2ad4bea59","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666