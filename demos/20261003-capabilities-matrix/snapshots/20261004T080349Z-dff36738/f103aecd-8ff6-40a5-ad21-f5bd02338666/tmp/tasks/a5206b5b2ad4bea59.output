{"parentUuid":"eced3dad-de9b-4e20-9556-aac4c979aced","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a5206b5b2ad4bea59","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016LuQAXM7H1xZL1JqZhdR9P","type":"tool_result","content":"package runner\n\nimport (\n\t\"context\"\n\n\t\"github.com/sloprail/harness-mocks/cursor-mock/internal/toolexec\"\n\t\"github.com/sloprail/harness-mocks/internal/scenario\"\n\t\"github.com/sloprail/harness-mocks/internal/toolcall\"\n)\n\n// SubmitPrompt fires nothing: cursor-agent in print mode was recorded not\n// firing beforeSubmitPrompt, so no hook blocks the prompt or adds context.\nfunc (s *session) SubmitPrompt(context.Context) (string, bool) { return \"\", false }\n\n// Say prints what the agent said, and records it.\nfunc (s *session) Say(text string) {\n\ts.texts = append(s.texts, text)\n\ts.tr.text(text)\n\ts.forward(assistantFrame(s.id, text))\n}\n\n// EndOfTurn fires no hook: cursor-agent in print mode was recorded not firing\n// the stop hook, so nothing blocks the end of the turn. What can continue it is\n// a background shell's end (afterTurn).\nfunc (s *session) EndOfTurn(ctx context.Context, _ string, _ bool) (string, bool) {\n\tif s.owner != \"\" { // a sub-agent ends with its final response: its parent goes on\n\t\treturn \"\", false\n\t}\n\treturn s.afterTurn(ctx)\n}\n\n// Continue records the turn a finished background shell gives the agent, as the\n// user message it is in the transcript.\nfunc (s *session) Continue(prompt string) { s.tr.user(prompt) }\n\n// CapOverridden is never asked for: no end-of-turn hook blocks, so there is no\n// cap to reach.\nfunc (s *session) CapOverridden(int) {}\n\n// SessionFile is the conversation's transcript so far.\n\t\t\"executionTime\": time.Since(start).Milliseconds(), \"shellId\": id, \"pid\": pid,\n\t\t\"backgroundReason\": \"SHELL_BACKGROUND_REASON_USER_REQUEST\",\n\t}\n\tshellID, _ := strconv.Atoi(id)\n\toutput, _ := json.Marshal(map[string]any{\"shell_id\": shellID, \"pid\": pid})\n\treturn toolexec.Result{\n\t\tBackground: true,\n\t\tFrame:      map[string]any{\"success\": body, \"isBackground\": true, \"terminalsFolder\": folder},\n\t\tToolOutput: string(output),\n\t\tTook:       time.Since(start),\n\t}\n}\n\n// terminalsFolder is where Cursor keeps a project's shells' output, beside its\n// transcripts.\nfunc (s *session) terminalsFolder() string {\n\tproject := nonAlnum.ReplaceAllString(strings.TrimPrefix(s.cfg.Dir, \"/\"), \"-\")\n\treturn filepath.Join(s.cfg.Home, \".cursor\", \"projects\", project, \"terminals\")\n}\n\n// registries holds each session's background shells (a session is one run, so\n// the registry is made on its first background shell, or its first wait).\nvar registries sync.Map // *session -> *tasks.Registry\n\nfunc (s *session) registry() *tasks.Registry {\n\tif s.parent != nil {\n\t\treturn s.parent.registry()\n\t}\n\tr, _ := registries.LoadOrStore(s, tasks.NewRegistry())\n\treturn r.(*tasks.Registry)\n}\n\n// afterTurn is what the session does once a turn has ended (the harness side of\n// the turn's end): it waits while a background shell still runs, and for each\n// one that finished prints its notification and continues the session with the\n// turn Cursor gives the agent for it. With none left, the session ends.\n//\n// sr:provides task-notifications/cursor\nfunc (s *session) afterTurn(ctx context.Context) (string, bool) {\n\tr := s.registry()\n\tt := r.AwaitAfterTurn(ctx, \"\") // a finished shell, at once\ncursor-mock/internal/runner/run.go:43:// sr:provides hook-additional-context/cursor\ncursor-mock/internal/runner/run.go:66:// sr:provides noninteractive-run/cursor\ncursor-mock/internal/runner/run.go:67:// sr:provides session-end-hook/cursor\ncursor-mock/internal/runner/run.go:68:// sr:provides session-start-hook/cursor\ncursor-mock/internal/runner/run.go:69:// sr:docs https://cursor.com/docs/hooks#sessionend\ncursor-mock/internal/runner/run.go:70:// sr:docs https://cursor.com/docs/hooks#sessionstart\ncursor-mock/internal/runner/toolhost.go:40:// sr:docs https://cursor.com/docs/hooks#pretooluse\ncursor-mock/internal/runner/toolhost.go:78:// sr:provides tool-failure-hook/cursor\ncursor-mock/internal/runner/toolhost.go:79:// sr:provides posttooluse-payload/cursor\ncursor-mock/internal/runner/toolhost.go:80:// sr:docs https://cursor.com/docs/hooks#posttoolusefailure\ncursor-mock/internal/runner/background.go:47:\tt.ToolUseID, t.Command, t.Description, t.Owner = useID, c.Command(), c.Description(), s.owner\ncursor-mock/internal/runner/background.go:85:\tif s.parent != nil {\ncursor-mock/internal/runner/background.go:86:\t\treturn s.parent.registry()\ncursor-mock/internal/runner/host.go:26:\tif s.owner != \"\" { // a sub-agent ends with its final response: its parent goes on\ncursor-mock/internal/runner/run.go:33:\t// owner is the id of the sub-agent conversation this session is, \"\" for the\ncursor-mock/internal/runner/run.go:34:\t// main one, and parent the session that dispatched it: a sub-agent shares its\ncursor-mock/internal/runner/run.go:35:\t// parent's background shells, owning what it starts.\ncursor-mock/internal/runner/run.go:36:\towner  string\ncursor-mock/internal/runner/run.go:37:\tparent *session","is_error":false}]},"uuid":"f056e391-4a1c-4265-b7b2-27cf2e65ccef","timestamp":"2026-10-03T17:20:25.741Z","sourceToolAssistantUUID":"eced3dad-de9b-4e20-9556-aac4c979aced","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a5206b5b2ad4bea59","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a11c0a040e3cf682b"}
