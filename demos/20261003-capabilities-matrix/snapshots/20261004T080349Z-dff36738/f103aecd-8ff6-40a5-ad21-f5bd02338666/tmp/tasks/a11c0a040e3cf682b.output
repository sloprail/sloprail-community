ut_test.go-72-// call with a prompt only passes validation and reaches preToolUse with an\ncursor-mock/e2e/001_hooks/agent_input_test.go-73-// empty description (recorded: runs/agent-input-validation-description).\ncursor-mock/e2e/001_hooks/agent_input_test.go-74-// sr:proves agent-input-validation/cursor\ncursor-mock/e2e/001_hooks/agent_input_test.go:75:func TestTaskWithoutPromptIsRefusedBeforeAnyHook(t *testing.T) {\ncursor-mock/e2e/001_hooks/agent_input_test.go-76-\troot := filepath.Join(\"..\", \"..\", \"snapshots\", \"runs\")\ncursor-mock/e2e/001_hooks/agent_input_test.go-77-\t_, rec, _, _ := recording(t, \"agent-input-validation\")\ncursor-mock/e2e/001_hooks/agent_input_test.go-78-\tfor _, h := range rec.hooks {\ncursor-mock/e2e/001_hooks/agent_input_test.go-79-\t\tassert.NotContains(t, []any{\"preToolUse\", \"postToolUse\", \"postToolUseFailure\", \"subagentStart\"}, h[\"hook_event_name\"], \"the recording: no tool or sub-agent hook\")\ncursor-mock/e2e/001_hooks/agent_input_test.go-80-\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-81-\trequire.Equal(t, []string{\"tool_call/completed/taskToolCall/error\", \"result/success\"}, rec.frames)\ncursor-mock/e2e/001_hooks/agent_input_test.go-82-\ncursor-mock/e2e/001_hooks/agent_input_test.go-83-\tframes, hooks := dispatches(t, filepath.Join(root, \"agent-input-validation\", \"setup\"), `{}`, `{\"description\":\"helper\"}`)\ncursor-mock/e2e/001_hooks/agent_input_test.go-84-\tresults := taskResults(frames)\ncursor-mock/e2e/001_hooks/agent_input_test.go-85-\trequire.Len(t, results, 2)\ncursor-mock/e2e/001_hooks/agent_input_test.go-86-\tfor _, r := range results {\ncursor-mock/e2e/001_hooks/agent_input_test.go-87-\t\tassert.Equal(t, map[string]any{\"error\": map[string]any{\"error\": \"Invalid arguments:\\nprompt: Required\"}}, r)\ncursor-mock/e2e/001_hooks/agent_input_test.go-88-\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-89-\tfor _, h := range hooks {\ncursor-mock/e2e/001_hooks/agent_input_test.go-90-\t\tassert.NotContains(t, []any{\"preToolUse\", \"postToolUse\", \"postToolUseFailure\"}, h[\"hook_event_name\"], \"no tool hook for a refused dispatch\")\ncursor-mock/e2e/001_hooks/agent_input_test.go-91-\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-92-\ncursor-mock/e2e/001_hooks/agent_input_test.go-93-\t// a prompt alone is enough: the description is empty\ncursor-mock/e2e/001_hooks/agent_input_test.go-94-\t_, drec, _, _ := recording(t, \"agent-input-validation-description\")\ncursor-mock/e2e/001_hooks/agent_input_test.go-95-\tvar recordedInput map[string]any\ncursor-mock/e2e/001_hooks/agent_input_test.go-96-\tfor _, h := range drec.hooks {\ncursor-mock/e2e/001_hooks/agent_input_test.go-97-\t\tif h[\"hook_event_name\"] == \"preToolUse\" {\ncursor-mock/e2e/001_hooks/agent_input_test.go-98-\t\t\trecordedInput = h[\"tool_input\"].(map[string]any)\ncursor-mock/e2e/001_hooks/agent_input_test.go-99-\t\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-100-\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-101-\trequire.Equal(t, map[string]any{\"description\": \"\", \"prompt\": \"Reply with the word HI\", \"subagent_type\": \"generalPurpose\"}, recordedInput)\ncursor-mock/e2e/001_hooks/agent_input_test.go-102-\t_, hooks = dispatches(t, filepath.Join(root, \"agent-input-validation-description\", \"setup\"), `{\"prompt\":\"Reply with the word HI\"}`)\ncursor-mock/e2e/001_hooks/agent_input_test.go-103-\tvar pre []map[string]any\ncursor-mock/e2e/001_hooks/agent_input_test.go-104-\tfor _, h := range hooks {\ncursor-mock/e2e/001_hooks/agent_input_test.go-105-\t\tif h[\"hook_event_name\"] == \"preToolUse\" {\ncursor-mock/e2e/001_hooks/agent_input_test.go-106-\t\t\tpre = append(pre, h[\"tool_input\"].(map[string]any))\ncursor-mock/e2e/001_hooks/agent_input_test.go-107-\t\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-108-\t}\ncursor-mock/e2e/001_hooks/agent_input_test.go-109-\tassert.Equal(t, []map[string]any{recordedInput}, pre)\ncursor-mock/e2e/001_hooks/agent_input_test.go-110-}","is_error":false}]},"uuid":"1c4841ce-28a2-4265-ac80-5757efbb17e3","timestamp":"2026-10-03T16:41:51.234Z","sourceToolAssistantUUID":"3d229890-2946-4b98-8858-58626360d944","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a11c0a040e3cf682b","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a5206b5b2ad4bea59"}
