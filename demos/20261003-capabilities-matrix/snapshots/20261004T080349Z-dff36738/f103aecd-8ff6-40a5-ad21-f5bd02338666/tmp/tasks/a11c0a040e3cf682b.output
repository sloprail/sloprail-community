{"parentUuid":"242c400a-b4c4-417a-9006-2f288d457f78","isSidechain":true,"promptId":"e3bd0840-a862-48c7-b928-fab715312060","agentId":"a11c0a040e3cf682b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GNtKYoJGYLGd1yw6QoUxpY","type":"tool_result","content":"// Package runner is one cursor-mock run: the session, the scenario script's\n// turns, each tool call with its hooks, and the stream it prints.\npackage runner\n\nimport \"io\"\n\n// Config is everything a run needs, read once at the mock's entrypoint.\ntype Config struct {\n\t// Script is the scenario script that plays the agent.\n\tScript string\n\t// Prompt is the user's prompt.\n\tPrompt string\n\t// Dir is the workspace: where the run starts and where project hooks live.\n\tDir string\n\t// Environ is the mock's own environment, which its children inherit.\n\tEnviron []string\n\t// Home is the user's home, where Cursor keeps ~/.cursor.\n\tHome string\n\t// Version is the Cursor version the mock reports in hook payloads.\n\tVersion string\n\tStdout  io.Writer\n\tStderr  io.Writer\n}\n54-\n55-// Required is the parameters a call to the named tool must carry, and whether\n56-// the mock has the tool.\n57:func Required(name string) ([]string, bool) {\n58-\tt, ok := toolTable[name]\n59-\treturn t.required, ok\n60-}\n61-\n62-// FromScript is the Cursor call a scenario script's tool call stands for.\n63-func FromScript(name string, input json.RawMessage) Call {\n64-\tvar in map[string]any\n65-\t_ = json.Unmarshal(input, &in)\n66-\tstr := func(k string) string { s, _ := in[k].(string); return s }\n67-\tc := Call{Kind: toolTable[name].kind, Args: map[string]any{}}\n68-\tswitch c.Kind {\n69-\tcase \"shellToolCall\":\n70-\t\tc.Args[\"command\"] = str(\"command\")\n71-\tcase \"readToolCall\":\n72-\t\tc.Args[\"path\"] = str(\"file_path\")\ncursor-mock/internal/hooks/decision.go:118:func Refusal(ds []Decision) (refused bool, message string) {\ncursor-mock/internal/hooks/decision.go-119-\tvar vote corehooks.PreToolVote\ncursor-mock/internal/hooks/decision.go-120-\tvar blockMsgs, denyMsgs []string\ncursor-mock/internal/hooks/decision.go-121-\tfor _, d := range ds {\ncursor-mock/internal/hooks/decision.go-122-\t\tswitch {\ncursor-mock/internal/hooks/decision.go-123-\t\tcase d.Blocked:\ncursor-mock/internal/hooks/decision.go-124-\t\t\tvote.Blocked = true\ncursor-mock/internal/hooks/decision.go-125-\t\t\tblockMsgs = append(blockMsgs, d.Message)\ncursor-mock/internal/hooks/decision.go-126-\t\tcase d.Permission == \"deny\":\ncursor-mock/internal/hooks/decision.go-127-\t\t\tvote.Denied = true\ncursor-mock/internal/hooks/decision.go-128-\t\t\tdenyMsgs = append(denyMsgs, d.Message)\ncursor-mock/internal/hooks/decision.go-129-\t\t}\ncursor-mock/internal/hooks/decision.go-130-\t}\ncursor-mock/internal/hooks/messages.go:11:func PreToolRefusal(message string) (failure, result string) {\ncursor-mock/internal/hooks/messages.go-12-\treturn message, message + \"\\n\\n\" + workaroundNote\ncursor-mock/internal/hooks/messages.go-13-}\ncursor-mock/internal/hooks/messages.go-14-\ncursor-mock/internal/hooks/messages.go-15-// ShellRefusal is how a shell command refused at beforeShellExecution is\ncursor-mock/internal/hooks/messages.go-16-// reported: one text, for the failure hook's error_message and the tool's\ncursor-mock/internal/hooks/messages.go-17-// result alike.\ncursor-mock/internal/hooks/messages.go-18-//\ncursor-mock/internal/hooks/messages.go-19-// sr:docs https://cursor.com/docs/hooks#beforeshellexecution--beforemcpexecution\ncursor-mock/internal/hooks/messages.go-20-func ShellRefusal(message string) (failure, result string) {\ncursor-mock/internal/hooks/messages.go-21-\ttext := \"Command execution was blocked by a hook: \" + message +\ncursor-mock/internal/hooks/messages.go-22-\t\t\"\\n\\nTo view or modify configured hooks, go to Cursor Settings > Hooks.\\n\\n\" + workaroundNote\ncursor-mock/internal/hooks/messages.go-23-\treturn text, text\ncursor-mock/internal/runner/run.go:38:// sr:provides hook-additional-context/cursor\ncursor-mock/internal/runner/run.go:61:// sr:provides noninteractive-run/cursor\ncursor-mock/internal/runner/run.go:62:// sr:provides session-end-hook/cursor\ncursor-mock/internal/runner/run.go:63:// sr:provides session-start-hook/cursor\ncursor-mock/internal/runner/run.go:64:// sr:docs https://cursor.com/docs/hooks#sessionend\ncursor-mock/internal/runner/run.go:65:// sr:docs https://cursor.com/docs/hooks#sessionstart","is_error":false}]},"uuid":"34d35196-b3c7-40ae-90b9-14a9da3492cf","timestamp":"2026-10-03T14:58:20.009Z","sourceToolAssistantUUID":"242c400a-b4c4-417a-9006-2f288d457f78","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a11c0a040e3cf682b","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
