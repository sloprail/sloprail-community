{"parentUuid":"fb785ab8-91e6-4063-8345-603e949bfd7f","isSidechain":true,"promptId":"6b8557a2-9430-4f17-946a-1ea07dab5643","agentId":"adfaf6893cfeed936","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Evp7Kxb53Va9vdh55QZQYX","type":"tool_result","content":"\tBoundary, Summary func()\n\t// Resume fires the session-start hook that follows the summary.\n\tResume func()\n\t// After fires the hook after the compaction.\n\tAfter func()\n\t// Command records the command a manual compaction is, once everything else\n\t// has run.\n\tCommand func()\n}\n\n// Run compacts the session: the hook before it (which can stop it), the\n// summarizer (manual only), the boundary, the summary, the session-start hook,\n// the hook after it, and for a manual compaction the command's own records. It\n// reports whether the compaction happened.\n//\n// sr:capability manual-compaction\nfunc Run(manual bool, s Steps) bool {\n\tif s.Before != nil && s.Before() {\n\t\treturn false\n\t}\n\tif manual && s.Summarizer != nil {\n\t\ts.Summarizer()\n\t}\n\ts.Boundary()\n\ts.Summary()\n\tif s.Resume != nil {\n\t\ts.Resume()\n\t}\n\tif s.After != nil {\n\t\ts.After()\n\t}\n\tif manual && s.Command != nil {\n\t\ts.Command()\n\t}\n\treturn true\n}\n# A module is an area of code with a boundary; its decisions live here, not in an ADR.\n# Its core is internal/compaction (the sequence and the boundary plan); claude-mock's adapter lives in the claude-mock files below.\nconcern: \"the compaction sequence and what it preserves\"\nhome: [\"internal/compaction/**\", \"claude-mock/internal/runner/control*.go\"]   # everything about the concern lives here\napi: [\"internal/compaction\"]       # the only packages others may import\n// Package runner is one `codex exec` run: the session, its hooks, and the turn.\npackage runner\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"time\"\n\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/childenv\"\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/events\"\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/hooks\"\n\t\"github.com/sloprail/harness-mocks/codex-mock/internal/session\"\n\tcoresession \"github.com/sloprail/harness-mocks/internal/session\"\n\t\"github.com/sloprail/harness-mocks/internal/turnloop\"\n)\n\n// Config is everything a run is told, read once at the entrypoint.\ntype Config struct {\n\t// Script is the scenario script that drives the agent.\n\tScript string\n\tPrompt string\n\t// Cwd is the session's working directory.\n\tCwd string\n\t// CodexHome holds the user's hooks.json and the session's rollout.\n\tCodexHome string\n\tModel     string\n\t// Environ is the environment the mock was started with.\n\tEnviron []string\n\t// JSON prints the event stream on Stdout; otherwise Stdout gets the\n\t// agent's final message.\n\tJSON           bool\n\tStdout, Stderr io.Writer\n}\n\n// state is the state of one run, shared by Codex's side of the turn and of\n// its tool calls.\ntype state struct {\n\tcfg     Config\n\tid      string\n\tturnID  string\n\thooks   *hooks.Invoker\n\tevents  *events.Stream\n\trollout *session.File\n\ttoolEnv []string\n}\n\n// Run starts the session, fires SessionStart, and runs one turn.\n// sr:provides session-start-hook/codex\n// sr:provides session-end-hook/codex\n// sr:provides noninteractive-run/codex\nfunc Run(ctx context.Context, cfg Config) error {\n\tif cfg.Script == \"\" {\n\t\treturn errors.New(\"codex-mock: a scenario script is required (--script or A10N_MOCK_SCRIPT)\")\n\t}\n\thookCfg, err := hooks.Load(cfg.CodexHome, cfg.Cwd)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"codex-mock: cannot load hooks: %w\", err)\n\t}\n\tid := coresession.NewID()\n\trollout, err := session.Create(cfg.CodexHome, id, cfg.Cwd, time.Now())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"codex-mock: cannot create the session file: %w\", err)\n\t}\n\tdefer rollout.Close()\n\tout := cfg.Stdout\n\tif !cfg.JSON {\n\t\tout = io.Discard\n\t}\n\ts := &state{cfg: cfg, id: id, turnID: coresession.NewID(), rollout: rollout, events: events.New(out),\n\t\ttoolEnv: childenv.ToolEnv(cfg.Environ, id)}\n\ts.hooks = &hooks.Invoker{Config: hookCfg, Dir: cfg.Cwd, Environ: cfg.Environ, Ident: childenv.HookIdentity(),\n\t\tCommon: hooks.Common{SessionID: id, TranscriptPath: rollout.Path, Cwd: cfg.Cwd, Model: cfg.Model,\n\t\t\tPermissionMode: \"bypassPermissions\"}}\n\ts.events.ThreadStarted(id)\n\tfor _, o := range s.hooks.Fire(ctx, hooks.SessionStart, \"startup\", map[string]any{\"source\": \"startup\"}) {\n\t\tif d := hooks.Interpret(hooks.SessionStart, o); d.Context != \"\" {\n\t\t\trollout.Developer(d.Context)\n\t\t}\n\t}\n\ts.events.TurnStarted()\n\tlast, err := turnloop.Run(ctx, turnHost{s}, turnloop.Params{\n\t\tScript: cfg.Script, Dir: cfg.Cwd, Environ: cfg.Environ, Prompt: cfg.Prompt})\n\ts.events.TurnCompleted()\n\t// The session ends with the run, for the one reason a non-interactive run has;\n\t// what the hook prints is not read.\n\ts.hooks.Fire(ctx, hooks.SessionEnd, \"other\", map[string]any{\"reason\": \"other\"})\n\tif !cfg.JSON && last != \"\" {\n\t\tfmt.Fprintln(cfg.Stdout, last)\n\t}\n\treturn err\n}\n\n// newID is a random identifier in the shape of a version 4 UUID.\n      42 codex-mock/internal/childenv/childenv.go\n      41 codex-mock/internal/childenv/childenv_test.go\n      80 codex-mock/internal/events/stream.go\n      87 codex-mock/internal/hooks/config.go\n     116 codex-mock/internal/hooks/decide.go\n     129 codex-mock/internal/hooks/decide_test.go\n      68 codex-mock/internal/hooks/invoker.go\n      41 codex-mock/internal/hooks/matcher_test.go\n      38 codex-mock/internal/hooks/payload.go\n      16 codex-mock/internal/hooks/refuse.go\n      71 codex-mock/internal/hooks/timeout_test.go\n      95 codex-mock/internal/runner/run.go\n      96 codex-mock/internal/runner/tool_host.go\n      82 codex-mock/internal/runner/turn_host.go\n      72 codex-mock/internal/session/file.go\n      75 codex-mock/exec.go\n      36 codex-mock/main.go\n    1185 total","is_error":false}]},"uuid":"ec70c40e-5e0a-4331-9acb-db3b2e44df23","timestamp":"2026-10-03T14:53:53.063Z","sourceToolAssistantUUID":"fb785ab8-91e6-4063-8345-603e949bfd7f","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-adfaf6893cfeed936","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
