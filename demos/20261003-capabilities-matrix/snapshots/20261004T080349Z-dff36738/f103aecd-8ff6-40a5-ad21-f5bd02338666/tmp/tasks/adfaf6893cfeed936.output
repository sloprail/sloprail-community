{"parentUuid":"b140f64a-3646-45b4-8205-76061588891b","isSidechain":true,"agentId":"adfaf6893cfeed936","message":{"model":"claude-sonnet-5-5","id":"msg_011Cffe3ss37dMhbTpkntGLn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LduNwaWQbGen9RGeBtV65D","name":"Write","input":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-adfaf6893cfeed936/codex-mock/e2e/001_hooks/compaction_text_test.go","content":"package e2e\n\nimport (\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/assert\"\n\t\"github.com/stretchr/testify/require\"\n)\n\n// Plain text on a compaction hook's stdout is ignored: the compaction goes\n// on, and the hooks that follow it still fire.\n// sr:proves manual-compaction/codex\nfunc TestCompactionHookPlainTextIsIgnored(t *testing.T) {\n\tgot := execMock(t, scenario{\n\t\tHooksJSON: hooksJSON(`\"$(git rev-parse --show-toplevel)\"/hook.sh`, \"PreCompact\", \"PostCompact\"),\n\t\tFiles:     map[string]string{\"hook.sh\": \"#!/bin/sh\\ncat >>\\\"$HOOK_LOG\\\"\\necho >>\\\"$HOOK_LOG\\\"\\necho 'continue: false'\\n\"},\n\t\tScript: `#!/bin/sh\nc=$(grep -c '\"type\":\"compacted\"' \"$A10N_MOCK_SESSION_FILE\")\nif [ \"$c\" -eq 0 ]; then printf '%s\\n' '{\"type\":\"compact\",\"trigger\":\"auto\"}'; else printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"DONE\"}'; fi\n`,\n\t\tPrompt: \"compact\",\n\t})\n\trequire.Equal(t, 0, got.Code, got.Stderr)\n\tassert.Equal(t, []string{\"PreCompact:auto\", \"PostCompact:auto\"}, hookShape(got.hookLog()))\n\tassert.Equal(t, 1, compactedRecords(got.rollout(t)))\n\tassert.Contains(t, got.Stdout, \"turn.completed\")\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1382,"cache_read_input_tokens":273124,"output_tokens":1044,"output_tokens_details":{"thinking_tokens":110},"server_tool_use":{"web_search_requests":0,"web_fetch