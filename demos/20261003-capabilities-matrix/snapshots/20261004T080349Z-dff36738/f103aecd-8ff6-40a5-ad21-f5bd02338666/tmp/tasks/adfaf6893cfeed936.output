, s Steps) Result {\n\tif s.Before != nil && s.Before() {\n\t\treturn Result{Stopped: true}\n\t}\n\tif manual && s.Summarizer != nil {\n\t\ts.Summarizer()\n\t}\n\ts.Boundary()\n\ts.Summary()\n\tif s.Resume != nil && !s.ResumeLast {\n\t\ts.Resume()\n\t}\n\tstopped := false\n\tswitch {\n\tcase s.AfterStops != nil:\n\t\tstopped = s.AfterStops()\n\tcase s.After != nil:\n\t\ts.After()\n\t}\n\tif s.Resume != nil && s.ResumeLast && !stopped {\n\t\ts.Resume()\n\t}\n\tif manual && s.Command != nil {\n\t\ts.Command()\n\t}\n\treturn Result{Happened: true, Stopped: stopped}\n}\n'''\nopen(p,'w').write(s)\n# codex adapter\np='codex-mock/internal/runner/control_compact.go'\ns=open(p).read()\ns=s.replace('''\tvar postStopped bool\n\thappened := compaction.Run(false, compaction.Steps{\n\t\tBefore:   func() bool { return stops(hooks.PreCompact) },\n\t\tBoundary: s.rollout.Compacted,\n\t\tSummary:  func() {},\n\t\tAfter:    func() { postStopped = stops(hooks.PostCompact) },\n\t\tResume: func() {\n\t\t\tif postStopped {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tfor''','''\tres := compaction.Do(false, compaction.Steps{\n\t\tBefore:     func() bool { return stops(hooks.PreCompact) },\n\t\tBoundary:   s.rollout.Compacted,\n\t\tSummary:    func() {},\n\t\tAfterStops: func() bool { return stops(hooks.PostCompact) },\n\t\tResume: func() {\n\t\t\tfor''')\ns=s.replace('if !happened || postStopped {','if res.Stopped {')\nopen(p,'w').write(s)\n# claude fork split\nopen('claude-mock/internal/runner/control_records.go','w').write('''package runner\n\nimport \"github.com/sloprail/harness-mocks/internal/session\"\n\n// isCompactBoundary: a compact_boundary system record, where Claude Code's\n// compaction starts.\nfunc isCompactBoundary(rec session.Record) bool {\n\treturn rec[\"type\"] == \"system\" && rec[\"subtype\"] == \"compact_boundary\"\n}\n\n// isCompactSummary: the isCompactSummary user record after a boundary.\nfunc isCompactSummary(rec session.Record) bool {\n\tv, _ := rec[\"isCompactSummary\"].(bool)\n\treturn v\n}\n\n// preservedUUIDs is the list of records a compact_boundary says the\n// compaction kept, in order.\nfunc preservedUUIDs(boundary map[string]any) []string {\n\tmeta, _ := boundary[\"compactMetadata\"].(map[string]any)\n\tpm, _ := meta[\"preservedMessages\"].(map[string]any)\n\traw, _ := pm[\"uuids\"].([]any)\n\tvar out []string\n\tfor _, v := range raw {\n\t\tif s, ok := v.(string); ok {\n\t\t\tout = append(out, s)\n\t\t}\n\t}\n\treturn out\n}\n''')\ns=open('claude-mock/internal/runner/session_fork.go').read()\ns+='''\n// claudeForkSchema is how Claude Code's records show a fork what to carry: the\n// compaction's boundary, its summary, and the records the boundary preserved.\nvar claudeForkSchema = session.ForkSchema{\n\tUUID: chainUUID, Parent: chainParent, SessionKey: \"sessionId\",\n\tIsBoundary: isCompactBoundary, IsSummary: isCompactSummary, Preserved: preservedUUIDs,\n}\n\n// forkSegment is the records of a transcript a fork carries, under session id\n// newID (see forkTranscript).\nfunc forkSegment(data []byte, newID string) []map[string]any {\n\treturn session.Fork(session.ParseRecords(data, chainUUID), newID, claudeForkSchema)\n}\n'''\nopen('claude-mock/internal/runner/session_fork.go','w').write(s)\nsub('internal/compaction/module.yaml','\"claude-mock/internal/runner/control_boundary.go\",','\"claude-mock/internal/runner/control_boundary.go\", \"claude-mock/internal/runner/control_records.go\",')\nsub('internal/transcript/module.yaml',' \"claude-mock/internal/runner/control_fork.go\",','')\nimport os\nos.remove('claude-mock/internal/runner/control_fork.go')\n"}},"apiBlockIndex":1,"requestId":"req_011CffdEASMdS53uJUEmzhRs","attributionAgent":"general-purpose","type":"assistant","uuid":"29bb494f-16e6-4b80-ab7a-f86082abe43e","timestamp":"2026-10-03T16:33:15.980Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-adfaf