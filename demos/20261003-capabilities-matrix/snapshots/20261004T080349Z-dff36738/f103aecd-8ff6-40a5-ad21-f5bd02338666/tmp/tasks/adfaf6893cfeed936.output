{"parentUuid":"2e529aa4-cca5-4ebf-9723-56e91a63526f","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"adfaf6893cfeed936","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cm5sZRfKbfpSmUT6ZsAbLk","type":"tool_result","content":"\t\"github.com/stretchr/testify/require\"\n)\n\n// rec is the subset of a transcript record these tests read.\ntype rec struct {\n\tType              string          `json:\"type\"`\n\tSubtype           string          `json:\"subtype\"`\n\tUUID              string          `json:\"uuid\"`\n\tParentUUID        *string         `json:\"parentUuid\"`\n\tLogicalParentUUID string          `json:\"logicalParentUuid\"`\n\tSessionID         string          `json:\"sessionId\"`\n\tIsSidechain       bool            `json:\"isSidechain\"`\n\tAgentID           string          `json:\"agentId\"`\n\tAttachment        map[string]any  `json:\"attachment\"`\n\tMessage           json.RawMessage `json:\"message\"`\n\tToolUseResult     map[string]any  `json:\"-\"`\n\tRaw               string          `json:\"-\"`\n}\n\nfunc encode(t *testing.T, dir string) string {\n\tt.Helper()\n\tresolved, err := filepath.EvalSymlinks(dir)\n\trequire.NoError(t, err)\n\treturn regexp.MustCompile(`[^a-zA-Z0-9]`).ReplaceAllString(resolved, \"-\")\n}\n\nfunc transcriptPath(t *testing.T, configDir, projDir, sessionID string) string {\n\treturn filepath.Join(configDir, \"projects\", encode(t, projDir), sessionID+\".jsonl\")\n}\n\n118:func script(t *testing.T, dir, name string, lines ...string) string {\n119-\tt.Helper()\n120-\tvar b strings.Builder\n121-\tb.WriteString(\"#!/bin/sh\\nF=\\\"$A10N_MOCK_SESSION_FILE\\\"\\n\")\n122-\tfor i, l := range lines {\n123-\t\tmarker := \"turn-\" + name + \"-\" + string(rune('a'+i))\n124-\t\tl = strings.Replace(l, \"@MARK@\", marker, 1)\n125-\t\tb.WriteString(\"if ! grep -q '\" + marker + \"' \\\"$F\\\" 2>/dev/null; then\\ncat <<'JSONL'\\n\" + l + \"\\nJSONL\\nexit 0\\nfi\\n\")\n126-\t}\n127-\tb.WriteString(`echo '{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"stop_reason\":\"end_turn\",\"content\":[{\"type\":\"text\",\"text\":\"done\"}]}}'` + \"\\n\")\n128-\tb.WriteString(`echo '{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"done\"}'` + \"\\n\")\n129-\treturn write(t, filepath.Join(dir, name+\".sh\"), b.String(), 0o755)\n130-}\n131-\n132-func toolUse(id, name, input string) string {\n133-\treturn `{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"` + id + `@MARK@\",\"name\":\"` + name + `\",\"input\":` + input + `}]}}`\n134-}","is_error":false}]},"uuid":"547346d1-26c7-46ea-8909-d09c07764ec3","timestamp":"2026-10-03T17:21:53.551Z","sourceToolAssistantUUID":"2e529aa4-cca5-4ebf-9723-56e91a63526f","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-adfaf6893cfeed936","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a11c0a040e3cf682b"}
