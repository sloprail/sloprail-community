 Cwd: cwd, CodexHome: home, Model: model,\n\t\tEnviron: os.Environ(), JSON: asJSON, Stdout: cmd.OutOrStdout(), Stderr: os.Stderr,\n\t})\n}\nfunc main() {\n\tif err := newRoot().Execute(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc newRoot() *cobra.Command {\n\troot := &cobra.Command{\n\t\tUse:   \"a10n-codex-mock\",\n\t\tShort: \"Deterministic Codex CLI mock for e2e testing\",\n\t\tLong: `a10n-codex-mock is a drop-in replacement for 'codex exec' in end-to-end\ntests. Instead of calling a model it runs a user-supplied scenario script that\nprints stream-json lines, fires Codex's hooks (from $CODEX_HOME/hooks.json and\n<cwd>/.codex/hooks.json) and prints the events 'codex exec --json' prints.\n\n  codex exec --json \"prompt\"\n  →\n  a10n-codex-mock exec --json --script scenario.sh \"prompt\"\n\nOr point A10N_MOCK_SCRIPT at the script instead of passing --script each time.`,\n\t\tSilenceUsage:  true,\n\t\tSilenceErrors: true,\n\t}\n\troot.AddCommand(newExec())\n\treturn root\n}\n# A module is an area of code with a boundary; its decisions live here, not in an ADR.\n# No core yet (internal/turnloop): the code lives in the claude-mock files below, until it moves.\nconcern: \"the turn: running the agent, the end-of-turn hook, re-prompting on a block, and the block cap\"\nhome: [\"internal/turnloop/**\", \"claude-mock/internal/runner/stream.go\", \"claude-mock/internal/runner/stream_hook.go\", \"claude-mock/internal/runner/stream_turn.go\", \"codex-mock/internal/runner/turn_host.go\", \"cursor-mock/internal/runner/run.go\", \"cursor-mock/internal/runner/host.go\"]   # everything about the concern lives here\napi: [\"internal/turnloop\"]       # the only packages others may import\nADR.md\nadr/capability-grounding/ADR.md:26:  `samples/<ts>/` hold the real harness's payloads, stream and transcript), or\nadr/child-processes/ADR.md:13:  - claude-mock/internal/runner/transcript_stamp.go\nadr/child-processes/ADR.md:22:script, background tasks