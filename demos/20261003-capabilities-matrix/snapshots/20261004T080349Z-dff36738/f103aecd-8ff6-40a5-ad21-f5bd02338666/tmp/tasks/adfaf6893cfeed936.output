//docs.anthropic.com/en/docs/claude-code/hooks#worktreeremove\nclaude-mock/internal/runner/control.go:24:// sr:docs https://docs.anthropic.com/en/docs/claude-code/hooks#subagentstart\nclaude-mock/internal/runner/control.go:27:// sr:provides worktree-hooks/claude\nclaude-mock/internal/runner/control.go:28:// sr:invariant control-records\n4:home: [\"internal/session/**\", \"claude-mock/internal/runner/session_append.go\", \"claude-mock/internal/runner/session_fork.go\", \"claude-mock/internal/runner/session_paths.go\", \"claude-mock/internal/runner/session_resume.go\", \"claude-mock/internal/runner/session_seed.go\", \"claude-mock/internal/runner/session_test.go\", \"claude-mock/internal/runner/fork_test.go\", \"claude-mock/internal/runner/runner_session_hooks.go\", \"claude-mock/internal/runner/runner_resume.go\", \"codex-mock/internal/session/**\"]   # everything about the concern lives here\n5:api: [\"internal/session\", \"codex-mock/internal/session\"]       # the only packages others may import\n9:home: [\"internal/subagents/**\", \"claude-mock/internal/runner/agent*.go\", \"claude-mock/internal/runner/session_subagent.go\"]   # everything about the concern lives here\n10:api: [\"internal/subagents\"]       # the only packages others may import","is_error":false}]},"uuid":"d5ef501c-4f09-43fc-8a1b-9e3a9b3dc1d8","timestamp":"2026-10-03T15:25:24.601Z","sourceToolAssistantUUID":"2bbb0c5b-768b-4443-898f-5789ff27d3f0","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-adfaf6893cfeed936","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-aa43418fbebf671c6"}
