{"parentUuid":"1b947931-e030-47b7-8535-40233e324425","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a5742d151ebfb6c56","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LDzSruWH9cqjX5JrEvYZcZ","type":"tool_result","content":"\tdefer s.bg.Shutdown()\n\ts.hooks = &hooks.Invoker{Config: hookCfg, Dir: cfg.Cwd, Environ: cfg.Environ, Ident: childenv.HookIdentity(),\n\t\tCommon: hooks.Common{SessionID: id, TranscriptPath: rollout.Path, Cwd: cfg.Cwd, Model: cfg.Model,\n\t\t\tPermissionMode: \"bypassPermissions\"}}\n\tif !cfg.JSON {\n\t\ts.events.Progress(cfg.Stderr, events.Header{Version: childenv.Version, Cwd: cfg.Cwd, Model: cfg.Model, Prompt: cfg.Prompt})\n\t}\n\ts.events.ThreadStarted(id)\n\tif cfg.BypassHookTrust {\n\t\tfor range 2 { // as recorded: twice per run, with or without hooks (runs/noninteractive-run-no-git-check)\n\t\t\ts.events.Warning(\"`--dangerously-bypass-hook-trust` is enabled. Enabled hooks may run without review for this invocation.\")\n\t\t}\n\t}\n\tfor _, f := range hooks.AsyncSessionEndFiles(cfg.CodexHome, cfg.Cwd) {\n\t\ts.events.Warning(\"running async SessionEnd hook synchronously in \" + f)\n\t}\n\thalted := false\n\tfor _, o := range s.hooks.Fire(ctx, hooks.SessionStart, \"startup\", map[string]any{\"source\": \"startup\"}) {\n\t\td := hooks.Interpret(hooks.SessionStart, o)\n\t\thalted = halted || d.Halt\n\t\tif d.Context != \"\" {\n\t\t\trollout.Developer(d.Context)\n\t\t}\n\t}\n\ts.events.TurnStarted()\n\tlast, err := \"\", error(nil)\n\t// Codex honours a start hook's `continue: false` (runs/session-start-continue-false).\n\tif !corehooks.StartHookEndsTurn(halted, true) {\n\t\tlast, err = turnloop.Run(ctx, turnHost{s}, turnloop.Params{\n\t\t\tScript: cfg.Script, Dir: cfg.Cwd, Environ: cfg.Environ, Prompt: cfg.Prompt})\n\t}\n\ts.events.TurnCompleted()\n\ts.reapAtExit()\n\t// The session ends with the run, for the one reason a non-interactive run has;\n\t// what the hook prints is not read.\n\ts.hooks.Fire(ctx, hooks.SessionEnd, \"other\", map[string]any{\"reason\": \"other\"})\n\tif !cfg.JSON && last != \"\" {\n\t\tfmt.Fprintln(cfg.Stdout, last)\n\t}\n\treturn err\n}\n\n// newID is a random identifier in the shape of a version 4 UUID.\n\t\treturn StartCompacted\n\tcase forked:\n\t\treturn StartForked\n\tcase resumed:\n\t\treturn StartResumed\n\tdefault:\n\t\treturn StartFresh\n\t}\n}\n\n// BlocksSessionStart reports whether a hook's verdict stops the session from\n// starting. None does: the session starts whatever its start hooks say.\nfunc BlocksSessionStart(Verdict) bool { return false }\n\n// StartHookEndsTurn reports whether a session-start hook that said it wants no\n// more (\"continue: false\") ends the first turn: the session has started all\n// the same, but no prompt hook fires and the model is not asked. Whether a\n// harness honours it is the harness's: honoured.\nfunc StartHookEndsTurn(saidStop, honoured bool) bool { return saidStop && honoured }\n\n// EndReason is why a session ended.\ntype EndReason int\n\nconst (\n\t// EndOther: the generic reason of a session that ended on its own.\n\tEndOther EndReason = iota\n312-// runs/session-end, each on the real harness and\n313-// replayed); one that exits 2 does not stop the session (runs/hook-exit-codes:\n314-// the prompt hook and the tool calls follow).\n315:// sr:proves session-start-hook/codex\n316-func TestSessionStartFiresOnceFirstWithStartup(t *testing.T) {\n317-\tfor _, name := range []string{\"stops\", \"hook-exit-codes\", \"session-end\"} {\n318-\t\tt.Run(name, func(t *testing.T) {\n319-\t\t\trec := loadRecording(t, name)\n320-\t\t\tgot := replayAsRun(t, rec)\n321-\t\t\trequire.Equal(t, 0, got.Code, got.Stderr)\n322-\t\t\tfor who, log := range map[string][]map[string]any{\"recording\": rec.payloads(t), \"mock\": got.hookLog()} {\n323-\t\t\t\tevs := eventNames(log)\n324-\t\t\t\trequire.GreaterOrEqual(t, len(evs), 2, who)\n325-\t\t\t\tassert.Equal(t, \"SessionStart\", evs[0], who)\n326-\t\t\t\tassert.Equal(t, \"UserPromptSubmit\", evs[1], \"%s: the one start precedes the prompt hook\", who)\n327-\t\t\t\tvar starts []map[string]any\n328-\t\t\t\tfor _, l := range log {\n329-\t\t\t\t\tif l[\"hook_event_name\"] == \"SessionStart\" {\n330-\t\t\t\t\t\tstarts = append(starts, l)\n331-\t\t\t\t\t}\n332-\t\t\t\t}\n333-\t\t\t\trequire.Len(t, starts, 1, who)\n334-\t\t\t\tassert.Equal(t, \"startup\", starts[0][\"source\"], who)\n335-\t\t\t\tassert.NotEmpty(t, starts[0][\"session_id\"], who)\n336-\t\t\t}\n337-\t\t})\n338-\t}\n339-}\n340-\n341-// The matcher of a session-start hook is applied to the source (hooks#sessionstart):\n342-// on the real harness a hook matching \"startup\" ran and one matching \"resume\"\n343-// did not (runs/hook-matchers), and the same on the mock for a fresh session,\n344-// for every way the docs write a matcher that matches startup (omitted, \"\",\n345-// \"*\", \"startup\", the alternation of all four sources, an anchored regular\n346-// expression) and every one that matches only another source.\n347:// sr:proves session-start-hook/codex\n348-func TestSessionStartMatcherIsAppliedToTheSource(t *testing.T) {\n349-\trec := loadRecording(t, \"hook-matchers\")\n350-\trecRan := marks(rec.payloads(t), \"ran\")\n351-\tassert.Contains(t, recRan, \"session-startup\")\n352-\tassert.NotContains(t, recRan, \"session-resume\")\n353-\tgot := replayAsRun(t, rec)\n354-\trequire.Equal(t, 0, got.Code, got.Stderr)\n355-\tassert.Contains(t, marks(got.hookLog(), \"ran\"), \"session-startup\")\n356-\tassert.NotContains(t, marks(got.hookLog(), \"ran\"), \"session-resume\")\n357-\n358-\tfor matcher, runs := range map[string]bool{\n359-\t\t\"\": true, \"*\": true, \"startup\": true, \"startup|resume|clear|compact\": true, \"^startup$\": true, \"start.*\": true,\n360-\t\t\"resume\": false, \"clear\": false, \"compact\": false, \"^compact$\": false, \"resume|clear|compact\": false,\n361-\t} {\n362-\t\tt.Run(\"matcher=\"+matcher, func(t *testing.T) {\n363-\t\t\thooks := fmt.Sprintf(`{\"hooks\":{\"SessionStart\":[{\"matcher\":%q,\"hooks\":[{\"type\":\"command\",\"command\":\"sh hook.sh\"}]}]}}`, matcher)\n364-\t\t\tr := execMock(t, scenario{\n365-\t\t\t\tHooksJSON: hooks,\n366-\t\t\t\tFiles:     map[string]string{\"hook.sh\": logHook},\n367-\t\t\t\tScript:    callThenResult, Prompt: \"go\", Env: withCalls(t),\n368-\t\t\t})\n369-\t\t\trequire.Equal(t, 0, r.Code, r.Stderr)\n370-\t\t\tassert.Equal(t, runs, len(eventsOf(r, \"SessionStart\")) == 1, \"matcher %q\", matcher)\n371-\t\t})\n372-\t}\n373-}\n374-\n375-// A session-start hook that says continue:false does not stop the session from\n376-// starting: the thread, its transcript and the hook's own run exist; what it\n377-// ends is the turn, with no prompt hook, no tool call, no message and no model\n378-// request (usage all zero), as the real harness did (runs/session-start-continue-false).\n379:// sr:proves session-start-hook/codex\n380-func TestSessionStartContinueFalseEndsTheTurnNotTheSession(t *testing.T) {\n381-\trec := loadRecording(t, \"session-start-continue-false\")\n382-\tassert.Equal(t, []string{\"SessionStart\"}, eventNames(rec.payloads(t)))\n383-\tassert.Contains(t, rec.transcript(t), `\"type\":\"session_meta\"`)\n384-\twant := rec.stream(t)\n385-\n386-\tgot := replayAsRun(t, rec)\n387-\trequire.Equal(t, 0, got.Code, got.Stderr)\n388-\tassert.Equal(t, []string{\"SessionStart\"}, eventNames(got.hookLog()))\n389-\tassert.Equal(t, \"startup\", eventsOf(got, \"SessionStart\")[0][\"source\"])\n390-\tgs := got.stream()\n391-\trequire.Len(t, gs, len(want))\n392-\tfor i := range gs {\n393-\t\tdelete(gs[i], \"thread_id\")\n394-\t\tdelete(want[i], \"thread_id\")\n395-\t}\n396-\tassert.Equal(t, want, gs)\n397-\tassert.Contains(t, got.rollout(t), `\"session_meta\"`, \"the session's transcript exists\")\n398-\tcmds, _ := got.commands()\n399-\tassert.Empty(t, cmds)\n400-}\nagent_input_test.go\nall_matching_test.go\nbackground_agent_test.go\nbackground_exec_t