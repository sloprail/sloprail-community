{"parentUuid":"8a87a38b-cf7a-47f2-952a-7911e172a9cf","isSidechain":true,"promptId":"0e75e1c2-9f84-43c4-8006-cccad7102c77","agentId":"a0be1bbdf1e9ecd30","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011mgoyJguFaLRyd2Rm3XMQy","type":"tool_result","content":"   1 \"last_assistant_message\":\"BANANA\"\n  50 \"last_assistant_message\":\"DONE\"\n   2 \"last_assistant_message\":\"DONE2\"\n   1 \"last_assistant_message\":\"FINISHED\"\n   2 \"last_assistant_message\":\"LAUNCHED\"\n   1 \"last_assistant_message\":\"STOPPED-ONCE\"\npackage hooks\n\nimport \"encoding/json\"\n\n// Common is what every hook payload carries, whatever the event.\ntype Common struct {\n\tSessionID      string\n\tTranscriptPath string\n\tCwd            string\n\tModel          string\n\tPermissionMode string\n}\n\n// Payload is the JSON object a command hook reads on stdin: the common\n// fields, the event's name and the event's own fields (turn_id, tool_name,\n// tool_input, prompt, source, …).\n//\n// sr:docs https://developers.openai.com/codex/hooks#common-input-fields\n// sr:provides hook-common-payload/codex\nfunc Payload(c Common, ev Event, own map[string]any) []byte {\n\tp := map[string]any{\n\t\t\"session_id\":      c.SessionID,\n\t\t\"transcript_path\": c.TranscriptPath,\n\t\t\"cwd\":             c.Cwd,\n\t\t\"hook_event_name\": string(ev),\n\t\t\"model\":           c.Model,\n\t\t\"permission_mode\": c.PermissionMode,\n\t}\n\tif ev == SessionEnd { // recorded: a session-end payload names neither model nor permission mode\n\t\tdelete(p, \"model\")\n\t\tdelete(p, \"permission_mode\")\n\t}\n\tfor k, v := range own {\n\t\tp[k] = v\n\t}\n\tb, _ := json.Marshal(p)\n\treturn b\n}","is_error":false}]},"uuid":"14ff79b1-f4e4-40ce-9154-a17f10ee07b5","timestamp":"2026-10-03T17:33:41.109Z","sourceToolAssistantUUID":"8a87a38b-cf7a-47f2-952a-7911e172a9cf","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent