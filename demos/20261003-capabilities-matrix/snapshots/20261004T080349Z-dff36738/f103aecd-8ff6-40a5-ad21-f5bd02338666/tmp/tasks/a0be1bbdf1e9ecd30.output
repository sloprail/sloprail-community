oning\", \"id\": \"rs_065ab3a67778626b016abe5579caa087d291c0fb1a382e3e64\", \"summary\": [], \"internal_chat_message_metadata_passthro\nevent_msg item_completed {\"type\": \"item_completed\", \"thread_id\": \"01a0f77d-9eb6-75e2-bc4b-3d7c801284ba\", \"turn_id\": \"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\", \"item\": {\nassistant [{\"type\": \"output_text\", \"text\": \"DONE2\"}]\nevent_msg task_complete {\"type\": \"task_complete\", \"turn_id\": \"01a0f77d-a0fb-77a0-9d8e-fd1a1769f5d4\", \"last_agent_message\": \"DONE2\", \"started_at\": 1790858600, \"compl\n#!/bin/sh\n# One hook for every event; each event exits with the code the scenario\n# exercises, and logs its payload and that code.\nIN=$(cat)\nprintf '%s\\n' \"$IN\" >>\"$HOOK_LOG\"\nev=$(printf '%s' \"$IN\" | jq -r '.hook_event_name')\ntool=$(printf '%s' \"$IN\" | jq -r '.tool_name // \"\"')\ncode=0\ncase \"$ev\" in\n  SessionStart) echo \"session-start stderr on exit 2\" >&2; code=2 ;;\n  UserPromptSubmit) echo \"The secret word is BANANA.\" ;;\n  PreToolUse) cmd=$(printf '%s' \"$IN\" | jq -r '.tool_input.command // \"\"')\n    case \"$cmd\" in *\"echo one\"*) echo \"Blocked: echo one is off in this scenario\" >&2; code=2 ;; esac ;;\n  PostToolUse) echo \"post-tool warning on exit 1\" >&2; code=1 ;;\n  Stop) if [ ! -f \"$TMPDIR/stop-blocked-once\" ]; then : >\"$TMPDIR/stop-blocked-once\"; echo \"Before finishing, reply with the single word STOPPED-ONCE.\" >&2; code=2; fi ;;\nesac\nprintf '{\"hook_result\":{\"event\":\"%s\",\"tool\":\"%s\",\"exit\":%s}}\\n' \"$ev\" \"$tool\" \"$code\" >>\"$HOOK_LOG\"\nexit $code\n{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"\\\"$(git rev-parse --show-toplevel)\\\"/hook.sh\"\n          }\n        ]\n      }\n    ]\n  }\n}\nMake every shell command its own separate tool call, never combined with another command or put in a script. Do these steps in order. 1) Run exactly this shell command: echo one. 2) Run exactly this shell command: ls /nonexistent-dir-for-this-run. 3) Run exactly this shell command: echo three. 4) Reply with the secret word you were given, and nothing else.\n{\"event\":\"hook\",\"hook\":\"SessionStart\",\"payload\":{\"session_id\":\"<SESSION_ID>\",\"hook_event_name\":\"SessionStart\",\"permission_mode\":\"bypassPermissions\",\"source\":\"startup\"}}\n{\"event\":\"hook\",\"hook\":null,\"payload\":{\"hook_result\":{\"event\":\"SessionStart\",\"tool\":\"\",\"exit\":2}}}\n{\"event\":\"hook\",\"hook\":\"UserPromptSubmit\",\"payload\":{\"session_id\":\"<SESSION_ID>\",\"hook_event_name\":\"UserPromptSubmit\",\"permission_mode\":\"bypassPermissions\",\"prompt\":\"Make every shell command its own separate tool call, never combined with another command or put in a script. Do these steps in order. \n{\"event\":\"hook\",\"hook\":null,\"payload\":{\"hook_result\":{\"event\":\"UserPromptSubmit\",\"tool\":\"\",\"exit\":0}}}\n{\"event\":\"hook\",\"hook\":\"PreToolUse\",\"payload\":{\"session_id\":\"<SESSION_ID>\",\"hook_event_name\":\"PreToolUse\",\"permission_