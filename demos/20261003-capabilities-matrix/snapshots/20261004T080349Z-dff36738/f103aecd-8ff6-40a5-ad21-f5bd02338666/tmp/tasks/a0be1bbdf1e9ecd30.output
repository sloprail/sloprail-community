{"parentUuid":"e4a8d7b6-cb67-40b5-b777-eb60430c6545","isSidechain":true,"agentId":"a0be1bbdf1e9ecd30","message":{"model":"claude-sonnet-5-5","id":"msg_011CffeoKdY5Ukj79NuxkERv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0185VEpZo9SLNZkEcPMpgXV3","name":"Write","input":{"file_path":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-a0be1bbdf1e9ecd30/codex-mock/snapshots/runs/stop-continue-false/setup/hook.sh","content":"#!/bin/sh\n# Two Stop hooks run this script. \"block\" blocks (a block decision with a\n# reason) on each of the first two Stop events, then lets the turn end; \"halt\"\n# always answers continue:false with a stop reason. Both log their payload.\nIN=$(cat)\nprintf '%s\\n' \"$IN\" >>\"$HOOK_LOG\"\ncase \"$1\" in\n  block)\n    N=$(cat \"$TMPDIR/stopn\" 2>/dev/null || echo 0); N=$((N + 1)); echo $N >\"$TMPDIR/stopn\"\n    printf '{\"hook_result\":{\"hook\":\"block\",\"call\":%s}}\\n' \"$N\" >>\"$HOOK_LOG\"\n    if [ $N -le 2 ]; then echo '{\"decision\":\"block\",\"reason\":\"BLOCK-REASON\"}'; fi ;;\n  halt)\n    printf '{\"hook_result\":{\"hook\":\"halt\"}}\\n' >>\"$HOOK_LOG\"\n    echo '{\"continue\":false,\"stopReason\":\"HALT-REASON\"}' ;;\nesac\nexit 0\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":951,"cache_read_input_tokens":95988,"output_tokens":809,"output_tokens_details":{"thinking_tokens":88},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":951},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":809,"cache_read_input_tokens":95988,"cache_creation_input_tokens":951,"cache_creation":{"ephemeral_5m_input_tokens":951,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"diagnostics":nu