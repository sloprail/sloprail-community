{"parentUuid":"f7de3043-e885-4cb7-90a4-3af64fcaba11","isSidechain":true,"promptId":"6b8557a2-9430-4f17-946a-1ea07dab5643","agentId":"afc43fc036aaadb5a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011EvFtPfWXPwhZiEPa3rk6F","type":"tool_result","content":"codex-mock/e2e/001_hooks/helpers_test.go:0\ncodex-mock/internal/hooks/config.go:1\ncodex-mock/internal/runner/run.go:3\ncodex-mock/e2e/001_hooks/main_test.go:0\n\tcfg     Config\n\tid      string\n\tturnID  string\n\thooks   *hooks.Invoker\n\tevents  *events.Stream\n\trollout *session.File\n\ttoolEnv []string\n}\n\n// Run starts the session, fires SessionStart, and runs one turn.\n// sr:provides session-start-hook/codex\n// sr:provides session-end-hook/codex\n// sr:provides noninteractive-run/codex\nfunc Run(ctx context.Context, cfg Config) error {\n\tif cfg.Script == \"\" {\n\t\treturn errors.New(\"codex-mock: a scenario script is required (--script or A10N_MOCK_SCRIPT)\")\n\t}\n\thookCfg, err := hooks.Load(cfg.CodexHome, cfg.Cwd)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"codex-mock: cannot load hooks: %w\", err)\n\t}\n\tid := coresession.NewID()\n\trollout, err := session.Create(cfg.CodexHome, id, cfg.Cwd, time.Now())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"codex-mock: cannot create the session file: %w\", err)\n\t}\n\tdefer rollout.Close()\n\tout := cfg.Stdout\n\tif !cfg.JSON {\n\t\tout = io.Discard\n\t}\n\ts := &state{cfg: cfg, id: id, turnID: coresession.NewID(), rollout: rollout, events: events.New(out),\n\t\ttoolEnv: childenv.ToolEnv(cfg.Environ, id)}\n\ts.hooks = &hooks.Invoker{Config: hookCfg, Dir: cfg.Cwd, Environ: cfg.Environ, Ident: childenv.HookIdentity(),\n\t\tCommon: hooks.Common{SessionID: id, TranscriptPath: rollout.Path, Cwd: cfg.Cwd, Model: cfg.Model,\n\t\t\tPermissionMode: \"bypassPermissions\"}}\n\ts.events.ThreadStarted(id)\n\tfor _, o := range s.hooks.Fire(ctx, hooks.SessionStart, \"startup\", map[string]any{\"source\": \"startup\"}) {\n\t\tif d := hooks.Interpret(hooks.SessionStart, o); d.Context != \"\" {\n\t\t\trollout.Developer(d.Context)\n\t\t}\n\t}\n\ts.events.TurnStarted()\n\tlast, err := turnloop.Run(ctx, turnHost{s}, turnloop.Params{\n\t\tScript: cfg.Script, Dir: cfg.Cwd, Environ: cfg.Environ, Prompt: cfg.Prompt})\n\ts.events.TurnCompleted()\n\t// The session ends with the run, for the one reason a non-interactive run has;\n\t// what the hook prints is not read.\n\ts.hooks.Fire(ctx, hooks.SessionEnd, \"other\", map[string]any{\"reason\": \"other\"})\n\tif !cfg.JSON && last != \"\" {\n\t\tfmt.Fprintln(cfg.Stdout, last)\n\t}\n\treturn err\n}\n\n// newID is a random identifier in the shape of a version 4 UUID.\n148:\t// callThenResult makes one Bash call per run of the script, taken from\n149-\t// $CALLS (one command per line), and then a final message and a result.\n150:\tcallThenResult = `#!/bin/sh\n151-n=$(grep -c function_call_output \"$A10N_MOCK_SESSION_FILE\")\n152-cmd=$(sed -n \"$((n+1))p\" \"$CALLS\")\n153-if [ -n \"$cmd\" ]; then\n154-  printf '{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"call_%s\",\"name\":\"Bash\",\"input\":{\"command\":%s}}]}}\\n' \"$n\" \"$(printf '%s' \"$cmd\" | jq -Rs .)\"\n155-  exit 0\n156-fi\n157-printf '%s\\n' '{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"DONE\"}]}}' '{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"DONE\"}'\n158-`\n159-)\n160-\n161:// withCalls is env for callThenResult: the commands it runs, in order.\n162:func withCalls(t *testing.T, cmds ...string) []string {\n163-\tt.Helper()\n164-\tf := filepath.Join(t.TempDir(), \"calls\")\n165-\trequire.NoError(t, os.WriteFile(f, []byte(strings.Join(cmds, \"\\n\")+\"\\n\"), 0o644))\n166-\treturn []string{\"CALLS=\" + f}\n167-}","is_error":false}]},"uuid":"542b4d43-adec-41ed-91e0-37e58e85d069","timestamp":"2026-10-03T14:52:54.007Z","sourceToolAssistantUUID":"f7de3043-e885-4cb7-90a4-3af64fcaba11","userType":"external","entrypoint":"claude-deskto