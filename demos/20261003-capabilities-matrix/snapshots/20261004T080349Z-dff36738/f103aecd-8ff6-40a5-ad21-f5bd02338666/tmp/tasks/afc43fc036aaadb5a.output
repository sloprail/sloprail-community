tring":"func Load(dir string) (Config, error) {\n\tpath := filepath.Join(dir, \".cursor\", \"hooks.json\")\n\traw, err := os.ReadFile(path)\n\tif errors.Is(err, fs.ErrNotExist) {\n\t\treturn Config{}, nil\n\t}\n\tif err != nil {\n\t\treturn Config{}, err\n\t}","new_string":"func Load(dir string, pluginDirs ...string) (Config, error) {\n\tc := Config{entries: map[Event][]Entry{}}\n\tif err := c.addFile(filepath.Join(dir, \".cursor\", \"hooks.json\")); err != nil {\n\t\treturn Config{}, err\n\t}\n\tfor _, p := range pluginDirs {\n\t\tif err := c.addPlugin(dir, p); err != nil {\n\t\t\treturn Config{}, err\n\t\t}\n\t}\n\treturn c, nil\n}\n\n// addFile adds the hooks of one hooks.json after those already configured; a\n// missing file adds none.\nfunc (c Config) addFile(path string) error {\n\traw, err := os.ReadFile(path)\n\tif errors.Is(err, fs.ErrNotExist) {\n\t\treturn nil\n\t}\n\tif err != nil {\n\t\treturn err\n\t}"}},"apiBlockIndex":1,"requestId":"req_011CffVrQprejb8CV9pUgheC","attributionAgent":"general-purpose","type":"assistant","uuid":"51628479-10a5-4401-8b6e-f0c9219a927d","timestamp":"2026-10-03T14:56:25.032Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-afc43fc036aaadb5a","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
