{"parentUuid":"55b1040d-8f55-4147-a4c9-805b1059923c","isSidechain":true,"promptId":"9af44ced-bc96-4c0c-851c-b7a4d67027a3","agentId":"afc43fc036aaadb5a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Ae2YmpkPGwuvSLCih2mJq","type":"tool_result","content":"package main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\n\t\"github.com/sloprail/harness-mocks/cursor-mock/internal/runner\"\n)\n\n// version is the Cursor version the mock reports in hook payloads: the one its\n// recordings were captured at.\nconst version = \"2026.09.28-64d2043\"\n\n// run reads the command line and the environment once, into the run's\n// configuration, and plays the run.\nfunc run(cmd *cobra.Command, f flags, args []string) error {\n\tswitch {\n\tcase !f.print:\n\t\treturn errors.New(\"cursor-mock: only non-interactive runs are modeled: pass -p\")\n\tcase f.outputFormat != \"stream-json\":\n\t\treturn fmt.Errorf(\"cursor-mock: output format %q is not modeled: pass --output-format stream-json\", f.outputFormat)\n\tcase f.resume || f.cont:\n\t\treturn errors.New(\"cursor-mock: --resume and --continue are not modeled\")\n\t}\n\tscript := f.script\n\tif script == \"\" {\n\t\tscript = os.Getenv(\"A10N_MOCK_SCRIPT\")\n\t}\n\tif script == \"\" {\n\t\treturn errors.New(\"cursor-mock: no scenario script: pass --script or set A10N_MOCK_SCRIPT\")\n\t}\n\tdir := f.workspace\n\tif dir == \"\" {\n\t\tvar err error\n\t\tif dir, err = os.Getwd(); err != nil {\n\t\t\treturn fmt.Errorf(\"cursor-mock: %w\", err)\n\t\t}\n\t}\n\t// Symlinks resolved once, here: Cursor reports the canonical workspace path.\n\tif resolved, err := filepath.EvalSymlinks(dir); err == nil {\n\t\tdir = resolved\n\t}\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cursor-mock: %w\", err)\n\t}\n\treturn runner.Run(cmd.Context(), runner.Config{\n\t\tScript: script, Prompt: strings.Join(args, \" \"), Dir: dir, Environ: os.Environ(), Home: home,\n\t\tVersion: version, Stdout: os.Stdout, Stderr: os.Stderr,\n\t})\n}\ncursor-mock/internal/runner/config.go:8:type Config struct {\ncursor-mock/internal/runner/config.go-9-\t// Script is the scenario script that plays the agent.\ncursor-mock/internal/runner/config.go-10-\tScript string\ncursor-mock/internal/runner/config.go-11-\t// Prompt is the user's prompt.\ncursor-mock/internal/runner/config.go-12-\tPrompt string\ncursor-mock/internal/runner/config.go-13-\t// Dir is the workspace: where the run starts and where project hooks live.\ncursor-mock/internal/runner/config.go-14-\tDir string\ncursor-mock/internal/runner/config.go-15-\t// Environ is the mock's own environment, which its children inherit.\ncursor-mock/internal/runner/config.go-16-\tEnviron []string\ncursor-mock/internal/runner/config.go-17-\t// Home is the user's home, where Cursor keeps ~/.cursor.\ncursor-mock/internal/runner/config.go-18-\tHome string\ncursor-mock/internal/runner/config.go-19-\t// Version is the Cursor version the mock reports in hook payloads.\ncursor-mock/internal/runner/config.go-20-\tVersion string\ncursor-mock/internal/runner/config.go-21-\tStdout  io.Writer\ncursor-mock/internal/runner/config.go-22-\tStderr  io.Writer\ncursor-mock/internal/runner/config.go-23-}\npackage e2e\n\nimport (\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/require\"\n)\n\n// TestEveryMatchingHookRunsAtTheSameTimeAsTheOthers: recorded (runs/hooks-together:\n// two hooks of one event, each waiting for the other to start), each saw the\n// other, which it can only have done if both were running at once.\n// sr:proves hooks-all-matching-run/cursor\nfunc TestEveryMatchingHookRunsAtTheSameTimeAsTheOthers(t *testing.T) {\n\tgot, want := replay(t, \"hooks-together\")\n\tconforms(t, got, want)\n\n\tfor name, o := range map[string]observed{\"recorded\": want, \"mock\": got} {\n\t\trequire.Contains(t, o.results, \"rv-a:beforeShellExecution:saw-b\", name)\n\t\trequire.Contains(t, o.results, \"rv-b:beforeShellExecution:saw-a\", name)\n\t}\n}\n\n// TestEveryMatchingHookRunsEvenWhenAnotherOneBlocks: recorded (runs/pretool-refusal:\n// two preToolUse hooks, one of which blocks some calls by exit status or by a\n// JSON deny), the other ran for every call, the blocked ones too.\n// sr:proves hooks-all-matching-run/cursor\nfunc TestEveryMatchingHookRunsEvenWhenAnotherOneBlocks(t *testing.T) {\n\tgot, want := replay(t, \"pretool-refusal\")\n\tconforms(t, got, want)\n\n\tfor name, o := range map[string]observed{\"recorded\": want, \"mock\": got} {\n\t\tvar calls, others int\n\t\tfor _, h := range o.hooks {\n\t\t\tif h[\"hook_event_name\"] == \"preToolUse\" {\n\t\t\t\tcalls++\n\t\t\t}\n\t\t}\n\t\tfor _, r := range o.results {\n\t\t\tif strings.HasPrefix(r, \"allow:preToolUse:\") {\n\t\t\t\tothers++\n\t\t\t}\n\t\t}\n\t\trequire.NotZero(t, calls, name)\n\t\trequire.Equal(t, calls, others, name+\": the second hook ran for every call\")\n\t\trequire.Contains(t, o.results, \"preToolUse:2\", name+\": and the first one blocked one\")\n\t}\n}\ncursor-mock/internal/runner/run.go:72:\tconf, err := hooks.Load(cfg.Dir)\nconfig.go\ndecision.go\ndecision_test.go\nevent.go\nfire.go\nmessages.go\npayload.go\nversion: 2026.09.28\ncommand: cursor-agent -p --force --trust --model auto --output-format stream-json","is_error":false}]},"uuid":"42745f25-29f2-4f16-abe6-41f09ec69008","timestamp":"2026-10-03T14:55:43.275Z","sourceToolAssistantUUID":"55b1040d-8f55-4147-a4c9-805b1059923c","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-afc43fc036aaadb5a","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
