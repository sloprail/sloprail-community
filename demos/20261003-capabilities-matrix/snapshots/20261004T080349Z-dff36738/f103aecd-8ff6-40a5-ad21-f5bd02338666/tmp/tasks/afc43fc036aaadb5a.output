{"parentUuid":"29021d2e-2fbb-4547-9faf-faf66b3552ac","isSidechain":true,"promptId":"9af44ced-bc96-4c0c-851c-b7a4d67027a3","agentId":"afc43fc036aaadb5a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011HkQkPSqDmZzhAhzZboo37","type":"tool_result","content":"// of hook and the user, team and enterprise sources are not.\n//\n// sr:docs https://cursor.com/docs/hooks#configuration\nfunc Load(dir string) (Config, error) {\n\tpath := filepath.Join(dir, \".cursor\", \"hooks.json\")\n\traw, err := os.ReadFile(path)\n\tif errors.Is(err, fs.ErrNotExist) {\n\t\treturn Config{}, nil\n\t}\n\tif err != nil {\n\t\treturn Config{}, err\n\t}\n\tvar file struct {\n\t\tHooks map[string][]struct {\n\t\t\tCommand    string  `json:\"command\"`\n\t\t\tFailClosed bool    `json:\"failClosed\"`\n\t\t\tMatcher    string  `json:\"matcher\"`\n\t\t\tTimeout    float64 `json:\"timeout\"`\n\t\t} `json:\"hooks\"`\n\t}\n\tif err := json.Unmarshal(raw, &file); err != nil {\n\t\treturn Config{}, fmt.Errorf(\"%s: %w\", path, err)\n\t}\n\tc := Config{entries: map[Event][]Entry{}}\n\tfor name, defs := range file.Hooks {\n\t\tfor _, d := range defs {\n\t\t\tif d.Command != \"\" {\n\t\t\t\tc.entries[Event(name)] = append(c.entries[Event(name)], Entry{d.Command, d.FailClosed, d.Matcher, time.Duration(d.Timeout * float64(time.Second))})\n\t\t\t}\n\t\t}\n\t}\n\treturn c, nil\n}\n\n// Entries are the hooks configured for the event, in order.\nfunc (c Config) Entries(e Event) []Entry { return c.entries[e] }","is_error":false}]},"uuid":"dac3172c-5f23-43c6-942d-11a0dc577419","timestamp":"2026-10-03T14:56:16.846Z","sourceToolAssistantUUID":"29021d2e-2fbb-4547-9faf-faf66b3552ac","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/nsviridenko/ws/sloprail/harness-mocks/.claude/worktrees/agent-afc43fc036aaadb5a","sessionId":"f103aecd-8ff6-40a5-ad21-f5bd02338666","version":"2.1.286","gitBranch":"worktree-agent-a513ce3b392834fe0"}
